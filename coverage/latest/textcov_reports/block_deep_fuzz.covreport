  620|  30.3k|    pub const fn sub(&self, rhs: &Self) -> Self {
  621|  30.3k|        let (d0, borrow) = sbb(self.0[0], rhs.0[0], 0);
  622|  30.3k|        let (d1, borrow) = sbb(self.0[1], rhs.0[1], borrow);
  623|  30.3k|        let (d2, borrow) = sbb(self.0[2], rhs.0[2], borrow);
  624|  30.3k|        let (d3, borrow) = sbb(self.0[3], rhs.0[3], borrow);
  625|       |
  626|       |        // If underflow occurred on the final limb, borrow = 0xfff...fff, otherwise
  627|       |        // borrow = 0x000...000. Thus, we use it as a mask to conditionally add the modulus.
  628|  30.3k|        let (d0, carry) = adc(d0, MODULUS.0[0] & borrow, 0);
  629|  30.3k|        let (d1, carry) = adc(d1, MODULUS.0[1] & borrow, carry);
  630|  30.3k|        let (d2, carry) = adc(d2, MODULUS.0[2] & borrow, carry);
  631|  30.3k|        let (d3, _) = adc(d3, MODULUS.0[3] & borrow, carry);
  632|       |
  633|  30.3k|        Fr([d0, d1, d2, d3])
  634|  30.3k|    }
_RNvMsc_NtCs3VjbIwwZMBL_6jubjub2frNtB5_2Fr8to_bytes:
  296|  30.3k|    pub fn to_bytes(&self) -> [u8; 32] {
  297|       |        // Turn into canonical form by computing
  298|       |        // (a.R) / R = a
  299|  30.3k|        let tmp = Fr::montgomery_reduce(self.0[0], self.0[1], self.0[2], self.0[3], 0, 0, 0, 0);
  300|       |
  301|  30.3k|        let mut res = [0; 32];
  302|  30.3k|        res[0..8].copy_from_slice(&tmp.0[0].to_le_bytes());
  303|  30.3k|        res[8..16].copy_from_slice(&tmp.0[1].to_le_bytes());
  304|  30.3k|        res[16..24].copy_from_slice(&tmp.0[2].to_le_bytes());
  305|  30.3k|        res[24..32].copy_from_slice(&tmp.0[3].to_le_bytes());
  306|       |
  307|  30.3k|        res
  308|  30.3k|    }
