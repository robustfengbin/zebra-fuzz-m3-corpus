  515|   143k|            | Transaction::V5 { expiry_height, .. } => match expiry_height {
  516|       |                // Consensus rule:
  517|       |                // > No limit: To set no limit on transactions (so that they do not expire), nExpiryHeight should be set to 0.
  518|       |                // https://zips.z.cash/zip-0203#specification
  519|  63.8k|                block::Height(0) => None,
  520|  79.6k|                block::Height(expiry_height) => Some(block::Height(*expiry_height)),
  521|       |            },
  522|      0|            Transaction::V6 { expiry_height, .. } => match expiry_height {
  523|       |                // # Consensus
