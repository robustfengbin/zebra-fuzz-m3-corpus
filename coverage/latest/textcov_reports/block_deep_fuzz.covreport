  928|     32|                    inputs: Vec::zcash_deserialize(&mut limited_reader)?,
  929|       |                    // Denoted as `tx_out_count` and `tx_out` in the spec.
  930|     32|                    outputs: Vec::zcash_deserialize(&mut limited_reader)?,
  931|       |                    // Denoted as `lock_time` in the spec.
  932|     32|                    lock_time: LockTime::zcash_deserialize(&mut limited_reader)?,
