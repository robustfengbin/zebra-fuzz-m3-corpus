_RINvNtCs41Au54XfBWR_12pasta_curves11hashtocurve13hash_to_fieldNtNtNtB4_6fields2fp2FpEB4_:
   11|  2.00k|pub fn hash_to_field<F: FromUniformBytes<64>>(
   12|  2.00k|    curve_id: &str,
   13|  2.00k|    domain_prefix: &str,
   14|  2.00k|    message: &[u8],
   15|  2.00k|    buf: &mut [F; 2],
   16|  2.00k|) {
   17|  2.00k|    assert!(domain_prefix.len() < 256);
   18|  2.00k|    assert!((22 + curve_id.len() + domain_prefix.len()) < 256);
   19|       |
   20|       |    // Assume that the field size is 32 bytes and k is 256, where k is defined in
   21|       |    // <https://www.ietf.org/archive/id/draft-irtf-cfrg-hash-to-curve-10.html#name-security-considerations-3>.
   22|       |    const CHUNKLEN: usize = 64;
   23|       |    const_assert!(CHUNKLEN * 2 < 256);
   24|       |
   25|       |    // Input block size of BLAKE2b.
   26|       |    const R_IN_BYTES: usize = 128;
   27|       |
   28|  2.00k|    let personal = [0u8; 16];
   29|  2.00k|    let empty_hasher = blake2b_simd::Params::new()
   30|  2.00k|        .hash_length(CHUNKLEN)
   31|  2.00k|        .personal(&personal)
   32|  2.00k|        .to_state();
   33|       |
   34|  2.00k|    let b_0 = empty_hasher
   35|  2.00k|        .clone()
   36|  2.00k|        .update(&[0; R_IN_BYTES])
   37|  2.00k|        .update(message)
   38|  2.00k|        .update(&[0, (CHUNKLEN * 2) as u8, 0])
   39|  2.00k|        .update(domain_prefix.as_bytes())
   40|  2.00k|        .update(b"-")
   41|  2.00k|        .update(curve_id.as_bytes())
   42|  2.00k|        .update(b"_XMD:BLAKE2b_SSWU_RO_")
   43|  2.00k|        .update(&[(22 + curve_id.len() + domain_prefix.len()) as u8])
   44|  2.00k|        .finalize();
   45|       |
   46|  2.00k|    let b_1 = empty_hasher
   47|  2.00k|        .clone()
