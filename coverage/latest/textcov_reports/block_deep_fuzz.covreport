_RNvMsa_NtCsjpkeS12E7YP_9bls12_3816scalarNtB5_6Scalar6invert:
  408|  83.2k|    pub fn invert(&self) -> CtOption<Self> {
  409|       |        #[inline(always)]
  410|       |        fn square_assign_multi(n: &mut Scalar, num_times: usize) {
  411|       |            for _ in 0..num_times {
  412|       |                *n = n.square();
  413|       |            }
  414|       |        }
  415|       |        // found using https://github.com/kwantam/addchain
  416|  83.2k|        let mut t0 = self.square();
  417|  83.2k|        let mut t1 = t0 * self;
  418|  83.2k|        let mut t16 = t0.square();
  419|  83.2k|        let mut t6 = t16.square();
  420|  83.2k|        let mut t5 = t6 * t0;
  421|  83.2k|        t0 = t6 * t16;
  422|  83.2k|        let mut t12 = t5 * t16;
  423|  83.2k|        let mut t2 = t6.square();
  424|  83.2k|        let mut t7 = t5 * t6;
  425|  83.2k|        let mut t15 = t0 * t5;
  426|  83.2k|        let mut t17 = t12.square();
  427|  83.2k|        t1 *= t17;
  428|  83.2k|        let mut t3 = t7 * t2;
  429|  83.2k|        let t8 = t1 * t17;
  430|  83.2k|        let t4 = t8 * t2;
  431|  83.2k|        let t9 = t8 * t7;
  432|  83.2k|        t7 = t4 * t5;
  433|  83.2k|        let t11 = t4 * t17;
