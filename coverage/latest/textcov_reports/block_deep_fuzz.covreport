  490|      0|            "256^size (256^{size}) must fit in a u256, after the sign bit adjustment and offset"
  491|       |        );
  492|  5.16k|        let size = u32::try_from(size).expect("a 0-6 bit value fits in a u32");
  493|       |
  494|  5.16k|        assert!(
  495|  5.16k|            mantissa <= UNSIGNED_MANTISSA_MASK.into(),
  496|      0|            "mantissa {mantissa:x?} must fit in its compact field"
  497|       |        );
  498|  5.16k|        let mantissa = u32::try_from(mantissa).expect("a 0-23 bit value fits in a u32");
