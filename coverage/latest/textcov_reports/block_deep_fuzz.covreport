  291|   564k|            fn ct_eq(&self, other: &Self) -> Choice {
  292|       |                // Is (xz^2, yz^3, z) equal to (x'z'^2, yz'^3, z') when converted to affine?
  293|       |
  294|   564k|                let z = other.z.square();
  295|   564k|                let x1 = self.x * z;
  296|   564k|                let z = z * other.z;
  297|   564k|                let y1 = self.y * z;
  298|   564k|                let z = self.z.square();
  299|   564k|                let x2 = other.x * z;
  300|   564k|                let z = z * self.z;
  301|   564k|                let y2 = other.y * z;
  302|       |
  303|   564k|                let self_is_zero = self.is_identity();
  304|   564k|                let other_is_zero = other.is_identity();
  305|       |
  306|   564k|                (self_is_zero & other_is_zero) // Both point at infinity
  307|   564k|                            | ((!self_is_zero) & (!other_is_zero) & x1.ct_eq(&x2) & y1.ct_eq(&y2))
  308|       |                // Neither point at infinity, coordinates are the same
  309|   564k|            }
