   72|  3.80k|pub fn conventional_fee(transaction: &Transaction) -> Amount<NonNegative> {
   73|       |    // zcash_primitives checks for non-p2pkh inputs, but Zebra doesn't.
   74|       |    // Conventional fees are only used in the standard rules for mempool eviction
   75|       |    // and block production, so these implementations are compatible.
   76|       |    //
   77|       |    // <https://github.com/zcash/librustzcash/blob/main/zcash_primitives/src/transaction/fees/zip317.rs#L135>
   78|       |
   79|  3.80k|    let marginal_fee: Amount<NonNegative> = MARGINAL_FEE.try_into().expect("fits in amount");
   80|       |
   81|       |    // marginal_fee * max(logical_actions, GRACE_ACTIONS)
   82|  3.80k|    let conventional_fee = marginal_fee * conventional_actions(transaction).into();
   83|       |
   84|  3.80k|    conventional_fee.expect("conventional fee is positive and limited by serialized size limit")
   85|  3.80k|}
_RNvNtNtNtCs2qdhHbQ3r3c_11zebra_chain11transaction7unmined6zip31720conventional_actions:
  140|  7.60k|pub fn conventional_actions(transaction: &Transaction) -> u32 {
  141|  7.60k|    let tx_in_total_size: usize = transaction
  142|  7.60k|        .inputs()
  143|  7.60k|        .iter()
  144|  7.60k|        .map(|input| input.zcash_serialized_size())
  145|  7.60k|        .sum();
  146|       |
  147|  7.60k|    let tx_out_total_size: usize = transaction
  148|  7.60k|        .outputs()
  149|  7.60k|        .iter()
  150|  7.60k|        .map(|output| output.zcash_serialized_size())
  151|  7.60k|        .sum();
  152|       |
  153|  7.60k|    let n_join_split = transaction.joinsplit_count();
  154|  7.60k|    let n_spends_sapling = transaction.sapling_spends_per_anchor().count();
  155|  7.60k|    let n_outputs_sapling = transaction.sapling_outputs().count();
  156|  7.60k|    let n_actions_orchard = transaction.orchard_actions().count();
  157|       |    // Ironwood actions have the same structure and cost as Orchard actions, so they are counted
  158|       |    // the same way. This is zero for pre-v6 transactions.
  159|  7.60k|    let n_actions_ironwood = transaction.ironwood_actions().count();
  160|       |
  161|  7.60k|    let tx_in_logical_actions = div_ceil(tx_in_total_size, P2PKH_STANDARD_INPUT_SIZE);
  162|  7.60k|    let tx_out_logical_actions = div_ceil(tx_out_total_size, P2PKH_STANDARD_OUTPUT_SIZE);
  163|       |
  164|  7.60k|    let logical_actions = max(tx_in_logical_actions, tx_out_logical_actions)
  165|  7.60k|        + 2 * n_join_split
  166|  7.60k|        + max(n_spends_sapling, n_outputs_sapling)
  167|  7.60k|        + n_actions_orchard
  168|  7.60k|        + n_actions_ironwood;
  169|  7.60k|    let logical_actions: u32 = logical_actions
  170|  7.60k|        .try_into()
  171|  7.60k|        .expect("transaction items are limited by serialized size limit");
  172|       |
  173|  7.60k|    max(GRACE_ACTIONS, logical_actions)
  174|  7.60k|}

