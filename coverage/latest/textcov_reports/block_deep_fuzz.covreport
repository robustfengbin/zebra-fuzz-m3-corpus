  700|  25.5k|        let r1101 = r111 * r110;
  701|  25.5k|        let ra = sqr(*self, 129) * self;
  702|  25.5k|        let rb = sqr(ra, 7) * r1001;
  703|  25.5k|        let rc = sqr(rb, 7) * r1101;
  704|  25.5k|        let rd = sqr(rc, 4) * r11;
  705|  25.5k|        let re = sqr(rd, 6) * r111;
  706|  25.5k|        let rf = sqr(re, 3) * r111;
  707|  25.5k|        let rg = sqr(rf, 10) * r1001;
  708|  25.5k|        let rh = sqr(rg, 5) * r1001;
  709|  25.5k|        let ri = sqr(rh, 4) * r1001;
  710|  25.5k|        let rj = sqr(ri, 3) * r111;
  711|  25.5k|        let rk = sqr(rj, 4) * r1001;
  712|  25.5k|        let rl = sqr(rk, 5) * r11;
  713|  25.5k|        let rm = sqr(rl, 4) * r111;
  714|  25.5k|        let rn = sqr(rm, 4) * r11;
  715|  25.5k|        let ro = sqr(rn, 6) * r1001;
  716|  25.5k|        let rp = sqr(ro, 5) * r1101;
  717|  25.5k|        let rq = sqr(rp, 4) * r11;
  718|  25.5k|        let rr = sqr(rq, 7) * r111;
  719|  25.5k|        let rs = sqr(rr, 3) * r11;
  720|  25.5k|        rs.square() // rt
  721|  25.5k|    }
