 1192|    171|    fn transparent_value_balance_from_outputs(
 1193|    171|        &self,
 1194|    171|        outputs: &HashMap<transparent::OutPoint, transparent::Output>,
 1195|    171|    ) -> Result<ValueBalance<NegativeAllowed>, ValueBalanceError> {
 1196|    171|        let input_value = self
 1197|    171|            .inputs()
 1198|    171|            .iter()
 1199|    171|            .map(|i| i.value_from_outputs(outputs))
 1200|    171|            .sum::<Result<Amount<NonNegative>, AmountError>>()
 1201|    171|            .map_err(ValueBalanceError::Transparent)?
 1202|    171|            .constrain()
 1203|    171|            .expect("conversion from NonNegative to NegativeAllowed is always valid");
 1204|       |
 1205|    171|        let output_value = self
 1206|    171|            .outputs()
 1207|    171|            .iter()
 1208|    171|            .map(|o| o.value())
 1209|    171|            .sum::<Result<Amount<NonNegative>, AmountError>>()
 1210|    171|            .map_err(ValueBalanceError::Transparent)?
 1211|    171|            .constrain()
 1212|    171|            .expect("conversion from NonNegative to NegativeAllowed is always valid");
 1213|       |
 1214|    171|        (input_value - output_value)
 1215|    171|            .map(ValueBalance::from_transparent_amount)
 1216|    171|            .map_err(ValueBalanceError::Transparent)
 1217|    171|    }
