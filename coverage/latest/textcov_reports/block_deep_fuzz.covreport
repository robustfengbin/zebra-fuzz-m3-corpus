  229|      2|  BlockBasedTableTypeInfo() {
  230|      2|    info = {
  231|       |        // NOTE: Below the list, most of these options are marked as mutable.
  232|       |        // In theory, there should be no danger in mutability, as table
  233|       |        // builders and readers work from copies of BlockBasedTableOptions.
  234|       |        // However, there is currently an unresolved read-write race that
