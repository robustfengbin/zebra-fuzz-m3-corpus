  341|  52.3M|    pub const fn square(&self) -> Scalar {
  342|  52.3M|        let (r1, carry) = mac(0, self.0[0], self.0[1], 0);
  343|  52.3M|        let (r2, carry) = mac(0, self.0[0], self.0[2], carry);
  344|  52.3M|        let (r3, r4) = mac(0, self.0[0], self.0[3], carry);
  345|       |
  346|  52.3M|        let (r3, carry) = mac(r3, self.0[1], self.0[2], 0);
  347|  52.3M|        let (r4, r5) = mac(r4, self.0[1], self.0[3], carry);
