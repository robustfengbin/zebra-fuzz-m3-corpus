_RNvMs_NtCs2qdhHbQ3r3c_11zebra_chain11transactionNtB4_11Transaction38transparent_value_balance_from_outputs:
 1192|    150|    fn transparent_value_balance_from_outputs(
 1193|    150|        &self,
 1194|    150|        outputs: &HashMap<transparent::OutPoint, transparent::Output>,
 1195|    150|    ) -> Result<ValueBalance<NegativeAllowed>, ValueBalanceError> {
 1196|    150|        let input_value = self
 1197|    150|            .inputs()
 1198|    150|            .iter()
 1199|    150|            .map(|i| i.value_from_outputs(outputs))
 1200|    150|            .sum::<Result<Amount<NonNegative>, AmountError>>()
 1201|    150|            .map_err(ValueBalanceError::Transparent)?
 1202|    150|            .constrain()
 1203|    150|            .expect("conversion from NonNegative to NegativeAllowed is always valid");
 1204|       |
 1205|    150|        let output_value = self
 1206|    150|            .outputs()
 1207|    150|            .iter()
 1208|    150|            .map(|o| o.value())
 1209|    150|            .sum::<Result<Amount<NonNegative>, AmountError>>()
 1210|    150|            .map_err(ValueBalanceError::Transparent)?
 1211|    150|            .constrain()
 1212|    150|            .expect("conversion from NonNegative to NegativeAllowed is always valid");
 1213|       |
 1214|    150|        (input_value - output_value)
 1215|    150|            .map(ValueBalance::from_transparent_amount)
 1216|    150|            .map_err(ValueBalanceError::Transparent)
 1217|    150|    }
