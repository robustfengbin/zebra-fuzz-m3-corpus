  509|  75.8M|        r2: u64,
  510|  75.8M|        r3: u64,
  511|  75.8M|        r4: u64,
  512|  75.8M|        r5: u64,
  513|  75.8M|        r6: u64,
  514|  75.8M|        r7: u64,
  515|  75.8M|    ) -> Self {
  516|       |        // The Montgomery reduction here is based on Algorithm 14.32 in
  517|       |        // Handbook of Applied Cryptography
  518|       |        // <http://cacr.uwaterloo.ca/hac/about/chap14.pdf>.
  519|       |
  520|  75.8M|        let k = r0.wrapping_mul(INV);
  521|  75.8M|        let (_, carry) = mac(r0, k, MODULUS.0[0], 0);
  522|  75.8M|        let (r1, carry) = mac(r1, k, MODULUS.0[1], carry);
  523|  75.8M|        let (r2, carry) = mac(r2, k, MODULUS.0[2], carry);
  524|  75.8M|        let (r3, carry) = mac(r3, k, MODULUS.0[3], carry);
  525|  75.8M|        let (r4, carry2) = adc(r4, 0, carry);
  526|       |
  527|  75.8M|        let k = r1.wrapping_mul(INV);
  528|  75.8M|        let (_, carry) = mac(r1, k, MODULUS.0[0], 0);
  529|  75.8M|        let (r2, carry) = mac(r2, k, MODULUS.0[1], carry);
  530|  75.8M|        let (r3, carry) = mac(r3, k, MODULUS.0[2], carry);
  531|  75.8M|        let (r4, carry) = mac(r4, k, MODULUS.0[3], carry);
  532|  75.8M|        let (r5, carry2) = adc(r5, carry2, carry);
  533|       |
  534|  75.8M|        let k = r2.wrapping_mul(INV);
  535|  75.8M|        let (_, carry) = mac(r2, k, MODULUS.0[0], 0);
  536|  75.8M|        let (r3, carry) = mac(r3, k, MODULUS.0[1], carry);
  537|  75.8M|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  538|  75.8M|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
  539|  75.8M|        let (r6, carry2) = adc(r6, carry2, carry);
  540|       |
  541|  75.8M|        let k = r3.wrapping_mul(INV);
  542|  75.8M|        let (_, carry) = mac(r3, k, MODULUS.0[0], 0);
  543|  75.8M|        let (r4, carry) = mac(r4, k, MODULUS.0[1], carry);
  544|  75.8M|        let (r5, carry) = mac(r5, k, MODULUS.0[2], carry);
  545|  75.8M|        let (r6, carry) = mac(r6, k, MODULUS.0[3], carry);
  546|  75.8M|        let (r7, _) = adc(r7, carry2, carry);
  547|       |
  548|       |        // Result may be within MODULUS of the correct value
  549|  75.8M|        (&Scalar([r4, r5, r6, r7])).sub(&MODULUS)
  550|  75.8M|    }
