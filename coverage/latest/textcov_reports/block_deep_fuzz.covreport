  143|    808|    fn zcash_serialize<W: io::Write>(&self, mut writer: W) -> Result<(), io::Error> {
  144|    808|        self.vpub_old.zcash_serialize(&mut writer)?;
  145|    808|        self.vpub_new.zcash_serialize(&mut writer)?;
  146|       |
  147|    808|        writer.write_32_bytes(&self.anchor.into())?;
  148|    808|        writer.write_32_bytes(&self.nullifiers[0].into())?;
  149|    808|        writer.write_32_bytes(&self.nullifiers[1].into())?;
  150|    808|        writer.write_32_bytes(&self.commitments[0].into())?;
  151|    808|        writer.write_32_bytes(&self.commitments[1].into())?;
  152|       |
  153|    808|        writer.write_all(&self.ephemeral_key.as_bytes()[..])?;
  154|       |        // The borrow is actually needed to avoid taking ownership
  155|       |        #[allow(clippy::needless_borrow)]
  156|    808|        writer.write_32_bytes(&(&self.random_seed).into())?;
  157|       |
  158|    808|        self.vmacs[0].zcash_serialize(&mut writer)?;
  159|    808|        self.vmacs[1].zcash_serialize(&mut writer)?;
  160|    808|        self.zkproof.zcash_serialize(&mut writer)?;
  161|       |
  162|    808|        self.enc_ciphertexts[0].zcash_serialize(&mut writer)?;
  163|    808|        self.enc_ciphertexts[1].zcash_serialize(&mut writer)?;
  164|       |
  165|    808|        Ok(())
  166|    808|    }
