_RNvXsk_NtNtCs41Au54XfBWR_12pasta_curves6fields2fpNtB5_2FpNtNtNtB9_10arithmetic6fields16SqrtTableHelpers21pow_by_t_minus1_over2:
  692|  19.3k|    fn pow_by_t_minus1_over2(&self) -> Self {
  693|  19.3k|        let sqr = |x: Fp, i: u32| (0..i).fold(x, |x, _| x.square());
  694|       |
  695|  19.3k|        let r10 = self.square();
  696|  19.3k|        let r11 = r10 * self;
  697|  19.3k|        let r110 = r11.square();
  698|  19.3k|        let r111 = r110 * self;
  699|  19.3k|        let r1001 = r111 * r10;
  700|  19.3k|        let r1101 = r111 * r110;
  701|  19.3k|        let ra = sqr(*self, 129) * self;
  702|  19.3k|        let rb = sqr(ra, 7) * r1001;
  703|  19.3k|        let rc = sqr(rb, 7) * r1101;
  704|  19.3k|        let rd = sqr(rc, 4) * r11;
  705|  19.3k|        let re = sqr(rd, 6) * r111;
  706|  19.3k|        let rf = sqr(re, 3) * r111;
  707|  19.3k|        let rg = sqr(rf, 10) * r1001;
  708|  19.3k|        let rh = sqr(rg, 5) * r1001;
  709|  19.3k|        let ri = sqr(rh, 4) * r1001;
  710|  19.3k|        let rj = sqr(ri, 3) * r111;
  711|  19.3k|        let rk = sqr(rj, 4) * r1001;
  712|  19.3k|        let rl = sqr(rk, 5) * r11;
  713|  19.3k|        let rm = sqr(rl, 4) * r111;
  714|  19.3k|        let rn = sqr(rm, 4) * r11;
  715|  19.3k|        let ro = sqr(rn, 6) * r1001;
  716|  19.3k|        let rp = sqr(ro, 5) * r1101;
  717|  19.3k|        let rq = sqr(rp, 4) * r11;
  718|  19.3k|        let rr = sqr(rq, 7) * r111;
  719|  19.3k|        let rs = sqr(rr, 3) * r11;
  720|  19.3k|        rs.square() // rt
  721|  19.3k|    }
