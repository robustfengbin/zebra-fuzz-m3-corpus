  172|  5.42k|    let y = F::conditional_select(&y2, &y1, gx1_square);
  173|       |
  174|       |    // 9. If sgn0(u) != sgn0(y), set y = -y
  175|  5.42k|    let y = F::conditional_select(&(-y), &y, u.is_odd().ct_eq(&y.is_odd()));
