  331|  11.5M|        let (r3, carry) = adc(0, r3, carry);
  332|  11.5M|        let (r4, carry) = mac(r4, self.0[2], self.0[2], carry);
  333|  11.5M|        let (r5, carry) = adc(0, r5, carry);
  334|  11.5M|        let (r6, carry) = mac(r6, self.0[3], self.0[3], carry);
  335|  11.5M|        let (r7, _) = adc(0, r7, carry);
