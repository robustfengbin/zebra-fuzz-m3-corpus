  425|  10.0k|        0
  426|  35.4k|    } else if height < blossom_height {
  427|  9.14k|        let pre_blossom_height = height - slow_start_shift;
  428|  9.14k|        pre_blossom_height / network.pre_blossom_halving_interval()
  429|       |    } else {
  430|  26.3k|        let pre_blossom_height = blossom_height - slow_start_shift;
  431|  26.3k|        let scaled_pre_blossom_height =
  432|  26.3k|            pre_blossom_height * HeightDiff::from(BLOSSOM_POW_TARGET_SPACING_RATIO);
