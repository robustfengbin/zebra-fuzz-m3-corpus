  526|       |                // https://zips.z.cash/zip-0203#specification
  527|      0|                block::Height(0) => None,
  528|      0|                block::Height(expiry_height) => Some(block::Height(*expiry_height)),
  529|       |            },
  530|       |        }
  531|   146k|    }
