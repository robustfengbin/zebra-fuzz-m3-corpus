  927|       |                    // Denoted as `tx_in_count` and `tx_in` in the spec.
  928|     31|                    inputs: Vec::zcash_deserialize(&mut limited_reader)?,
  929|       |                    // Denoted as `tx_out_count` and `tx_out` in the spec.
  930|     31|                    outputs: Vec::zcash_deserialize(&mut limited_reader)?,
  931|       |                    // Denoted as `lock_time` in the spec.
  932|     31|                    lock_time: LockTime::zcash_deserialize(&mut limited_reader)?,
