  352|       |        // The Montgomery reduction here is based on Algorithm 14.32 in
  353|       |        // Handbook of Applied Cryptography
  354|       |        // <http://cacr.uwaterloo.ca/hac/about/chap14.pdf>.
  355|       |
  356|  15.0M|        let k = r0.wrapping_mul(INV);
  357|  15.0M|        let (_, carry) = mac(r0, k, MODULUS.0[0], 0);
  358|  15.0M|        let (r1, carry) = mac(r1, k, MODULUS.0[1], carry);
  359|  15.0M|        let (r2, carry) = mac(r2, k, MODULUS.0[2], carry);
  360|  15.0M|        let (r3, carry) = mac(r3, k, MODULUS.0[3], carry);
  361|  15.0M|        let (r4, carry2) = adc(r4, 0, carry);
  362|       |
  363|  15.0M|        let k = r1.wrapping_mul(INV);
  364|  15.0M|        let (_, carry) = mac(r1, k, MODULUS.0[0], 0);
  365|  15.0M|        let (r2, carry) = mac(r2, k, MODULUS.0[1], carry);
  366|  15.0M|        let (r3, carry) = mac(r3, k, MODULUS.0[2], carry);
  367|  15.0M|        let (r4, carry) = mac(r4, k, MODULUS.0[3], carry);
  368|  15.0M|        let (r5, carry2) = adc(r5, carry2, carry);
