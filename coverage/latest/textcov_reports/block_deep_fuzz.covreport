   82|       |    // require byte-exact equality.
   83|  1.48k|    if script_sig
   84|  1.48k|        .get(..len)
   85|  1.48k|        .ok_or(parse_err("Coinbase script too short"))?
   86|  1.48k|        != pattern::push_num(h).to_bytes().as_slice()
   87|       |    {
   88|      8|        return Err(parse_err("Non-canonical coinbase height encoding"));
   89|  1.47k|    }
   90|       |
   91|  1.47k|    let h = u32::try_from(h).map_err(|_| parse_err("Negative coinbase height"))?;
