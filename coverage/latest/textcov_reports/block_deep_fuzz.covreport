   36|  2.71k|        .update(&[0; R_IN_BYTES])
   37|  2.71k|        .update(message)
   38|  2.71k|        .update(&[0, (CHUNKLEN * 2) as u8, 0])
   39|  2.71k|        .update(domain_prefix.as_bytes())
   40|  2.71k|        .update(b"-")
   41|  2.71k|        .update(curve_id.as_bytes())
   42|  2.71k|        .update(b"_XMD:BLAKE2b_SSWU_RO_")
   43|  2.71k|        .update(&[(22 + curve_id.len() + domain_prefix.len()) as u8])
   44|  2.71k|        .finalize();
   45|       |
   46|  2.71k|    let b_1 = empty_hasher
   47|  2.71k|        .clone()
   48|  2.71k|        .update(b_0.as_array())
   49|  2.71k|        .update(&[1])
   50|  2.71k|        .update(domain_prefix.as_bytes())
   51|  2.71k|        .update(b"-")
   52|  2.71k|        .update(curve_id.as_bytes())
   53|  2.71k|        .update(b"_XMD:BLAKE2b_SSWU_RO_")
   54|  2.71k|        .update(&[(22 + curve_id.len() + domain_prefix.len()) as u8])
   55|  2.71k|        .finalize();
   56|       |
