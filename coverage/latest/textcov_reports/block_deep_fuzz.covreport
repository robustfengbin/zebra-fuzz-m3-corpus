   81|  2.00k|pub fn iso_map<F: Field, C: CurveExt<Base = F>, I: CurveExt<Base = F>>(
   82|  2.00k|    p: &I,
   83|  2.00k|    iso: &[C::Base; 13],
   84|  2.00k|) -> C {
   85|       |    // The input and output are in Jacobian coordinates, using the method
   86|       |    // in "Avoiding inversions" [WB2019, section 4.3].
   87|       |
   88|  2.00k|    let (x, y, z) = p.jacobian_coordinates();
   89|       |
   90|  2.00k|    let z2 = z.square();
   91|  2.00k|    let z3 = z2 * z;
   92|  2.00k|    let z4 = z2.square();
   93|  2.00k|    let z6 = z3.square();
   94|       |
   95|  2.00k|    let num_x = ((iso[0] * x + iso[1] * z2) * x + iso[2] * z4) * x + iso[3] * z6;
   96|  2.00k|    let div_x = (z2 * x + iso[4] * z4) * x + iso[5] * z6;
   97|       |
   98|  2.00k|    let num_y = (((iso[6] * x + iso[7] * z2) * x + iso[8] * z4) * x + iso[9] * z6) * y;
   99|  2.00k|    let div_y = (((x + iso[10] * z2) * x + iso[11] * z4) * x + iso[12] * z6) * z3;
  100|       |
  101|  2.00k|    let zo = div_x * div_y;
  102|  2.00k|    let xo = num_x * div_y * zo;
  103|  2.00k|    let yo = num_y * div_x * zo.square();
  104|       |
  105|  2.00k|    C::new_jacobian(xo, yo, zo).unwrap()
  106|  2.00k|}

