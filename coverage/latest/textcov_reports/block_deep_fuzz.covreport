  555|       |        // Schoolbook multiplication
  556|       |
  557|  10.8M|        let (r0, carry) = mac(0, self.0[0], rhs.0[0], 0);
  558|  10.8M|        let (r1, carry) = mac(0, self.0[0], rhs.0[1], carry);
  559|  10.8M|        let (r2, carry) = mac(0, self.0[0], rhs.0[2], carry);
  560|  10.8M|        let (r3, r4) = mac(0, self.0[0], rhs.0[3], carry);
  561|       |
  562|  10.8M|        let (r1, carry) = mac(r1, self.0[1], rhs.0[0], 0);
  563|  10.8M|        let (r2, carry) = mac(r2, self.0[1], rhs.0[1], carry);
  564|  10.8M|        let (r3, carry) = mac(r3, self.0[1], rhs.0[2], carry);
  565|  10.8M|        let (r4, r5) = mac(r4, self.0[1], rhs.0[3], carry);
  566|       |
  567|  10.8M|        let (r2, carry) = mac(r2, self.0[2], rhs.0[0], 0);
  568|  10.8M|        let (r3, carry) = mac(r3, self.0[2], rhs.0[1], carry);
  569|  10.8M|        let (r4, carry) = mac(r4, self.0[2], rhs.0[2], carry);
  570|  10.8M|        let (r5, r6) = mac(r5, self.0[2], rhs.0[3], carry);
  571|       |
