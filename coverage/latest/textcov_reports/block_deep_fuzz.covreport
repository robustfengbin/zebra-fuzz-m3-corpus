  221|  10.2k|            (_, e) if (e >= 32) => return None,
  222|       |            // If m is larger than the remaining bytes, overflow.
  223|       |            // Otherwise, avoid overflows in base^exponent.
  224|  10.2k|            (m, e) if (e == 31 && m > u8::MAX.into()) => return None,
  225|  10.2k|            (m, e) if (e == 31 && m <= u8::MAX.into()) => (m << 16, e - 2),
  226|  10.2k|            (m, e) if (e == 30 && m > u16::MAX.into()) => return None,
  227|  10.1k|            (m, e) if (e == 30 && m <= u16::MAX.into()) => (m << 8, e - 1),
