  917|     90|                inputs: Vec::zcash_deserialize(&mut limited_reader)?,
  918|       |                // Denoted as `tx_out_count` and `tx_out` in the spec.
  919|     90|                outputs: Vec::zcash_deserialize(&mut limited_reader)?,
  920|       |                // Denoted as `lock_time` in the spec.
  921|     90|                lock_time: LockTime::zcash_deserialize(&mut limited_reader)?,
  922|       |            }),
  923|       |            (2, false) => {
