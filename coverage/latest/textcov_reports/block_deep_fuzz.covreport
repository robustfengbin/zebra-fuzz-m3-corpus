  338|  31.0k|pub fn funding_stream_values(
  339|  31.0k|    height: Height,
  340|  31.0k|    network: &Network,
  341|  31.0k|    expected_block_subsidy: Amount<NonNegative>,
  342|  31.0k|) -> Result<HashMap<FundingStreamReceiver, Amount<NonNegative>>, amount::Error> {
  343|  31.0k|    let mut results = HashMap::new();
  344|       |
  345|  31.0k|    if expected_block_subsidy.is_zero() {
  346|  3.27k|        return Ok(results);
  347|  27.7k|    }
  348|       |
  349|  27.7k|    if NetworkUpgrade::current(network, height) >= NetworkUpgrade::Canopy {
  350|  14.9k|        let funding_streams = network.funding_streams(height);
  351|  14.9k|        if let Some(funding_streams) = funding_streams {
  352|  35.1k|            for (&receiver, recipient) in funding_streams.recipients() {
  353|       |                // - Spec equation: `fs.value = floor(block_subsidy(height)*(fs.numerator/fs.denominator))`:
  354|       |                //   https://zips.z.cash/protocol/protocol.pdf#subsidies
  355|       |                // - In Rust, "integer division rounds towards zero":
  356|       |                //   https://doc.rust-lang.org/stable/reference/expressions/operator-expr.html#arithmetic-and-logical-binary-operators
  357|       |                //   This is the same as `floor()`, because these numbers are all positive.
  358|  35.1k|                let amount_value = ((expected_block_subsidy * recipient.numerator())?
  359|      0|                    / FUNDING_STREAM_RECEIVER_DENOMINATOR)?;
  360|       |
  361|  35.1k|                results.insert(receiver, amount_value);
  362|       |            }
  363|    224|        }
  364|  12.8k|    }
  365|       |
  366|  27.7k|    Ok(results)
  367|  31.0k|}
