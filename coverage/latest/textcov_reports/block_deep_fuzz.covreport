  591|  28.5k|    fn from_repr(repr: Self::Repr) -> CtOption<Self> {
  592|  28.5k|        let mut tmp = Fp([0, 0, 0, 0]);
  593|       |
  594|  28.5k|        tmp.0[0] = u64::from_le_bytes(repr[0..8].try_into().unwrap());
  595|  28.5k|        tmp.0[1] = u64::from_le_bytes(repr[8..16].try_into().unwrap());
  596|  28.5k|        tmp.0[2] = u64::from_le_bytes(repr[16..24].try_into().unwrap());
  597|  28.5k|        tmp.0[3] = u64::from_le_bytes(repr[24..32].try_into().unwrap());
  598|       |
  599|       |        // Try to subtract the modulus
  600|  28.5k|        let (_, borrow) = sbb(tmp.0[0], MODULUS.0[0], 0);
  601|  28.5k|        let (_, borrow) = sbb(tmp.0[1], MODULUS.0[1], borrow);
  602|  28.5k|        let (_, borrow) = sbb(tmp.0[2], MODULUS.0[2], borrow);
  603|  28.5k|        let (_, borrow) = sbb(tmp.0[3], MODULUS.0[3], borrow);
  604|       |
  605|       |        // If the element is smaller than MODULUS then the
  606|       |        // subtraction will underflow, producing a borrow value
  607|       |        // of 0xffff...ffff. Otherwise, it'll be zero.
  608|  28.5k|        let is_some = (borrow as u8) & 1;
  609|       |
