  371|  15.0M|        let (_, carry) = mac(r2, k, MODULUS.0[0], 0);
  372|  15.0M|        let (r3, carry) = mac(r3, k, MODULUS.0[1], carry);
  373|  15.0M|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  374|  15.0M|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
  375|  15.0M|        let (r6, carry2) = adc(r6, carry2, carry);
  376|       |
  377|  15.0M|        let k = r3.wrapping_mul(INV);
  378|  15.0M|        let (_, carry) = mac(r3, k, MODULUS.0[0], 0);
  379|  15.0M|        let (r4, carry) = mac(r4, k, MODULUS.0[1], carry);
  380|  15.0M|        let (r5, carry) = mac(r5, k, MODULUS.0[2], carry);
  381|  15.0M|        let (r6, carry) = mac(r6, k, MODULUS.0[3], carry);
  382|  15.0M|        let (r7, _) = adc(r7, carry2, carry);
