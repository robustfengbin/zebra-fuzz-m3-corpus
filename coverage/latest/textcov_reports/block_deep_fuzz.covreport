_RNvXsl_Cs3VjbIwwZMBL_6jubjubRNtB5_13ExtendedPointINtNtNtCs6SNw0SRvItZ_4core3ops5arith3AddRNtB5_18ExtendedNielsPointE3add:
  887|   918k|    fn add(self, other: &'b ExtendedNielsPoint) -> ExtendedPoint {
  888|       |        // We perform addition in the extended coordinates. Here we use
  889|       |        // a formula presented by Hisil, Wong, Carter and Dawson in
  890|       |        // "Twisted Edward Curves Revisited" which only requires 8M.
  891|       |        //
  892|       |        // A = (V1 - U1) * (V2 - U2)
  893|       |        // B = (V1 + U1) * (V2 + U2)
  894|       |        // C = 2d * T1 * T2
  895|       |        // D = 2 * Z1 * Z2
  896|       |        // E = B - A
  897|       |        // F = D - C
  898|       |        // G = D + C
  899|       |        // H = B + A
  900|       |        // U3 = E * F
  901|       |        // Y3 = G * H
  902|       |        // Z3 = F * G
  903|       |        // T3 = E * H
  904|       |
  905|   918k|        let a = (self.v - self.u) * other.v_minus_u;
  906|   918k|        let b = (self.v + self.u) * other.v_plus_u;
  907|   918k|        let c = self.t1 * self.t2 * other.t2d;
  908|   918k|        let d = (self.z * other.z).double();
  909|       |
  910|       |        // The remaining arithmetic is exactly the process of converting
  911|       |        // from a completed point to an extended point.
  912|   918k|        CompletedPoint {
  913|   918k|            u: b - a,
  914|   918k|            v: b + a,
  915|   918k|            z: d + c,
  916|   918k|            t: d - c,
  917|   918k|        }
  918|   918k|        .into_extended()
  919|   918k|    }
