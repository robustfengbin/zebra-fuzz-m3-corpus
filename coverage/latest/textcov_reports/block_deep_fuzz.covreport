  600|  4.74M|    pub const fn add(&self, rhs: &Self) -> Self {
  601|  4.74M|        let (d0, carry) = adc(self.0[0], rhs.0[0], 0);
  602|  4.74M|        let (d1, carry) = adc(self.0[1], rhs.0[1], carry);
  603|  4.74M|        let (d2, carry) = adc(self.0[2], rhs.0[2], carry);
  604|  4.74M|        let (d3, _) = adc(self.0[3], rhs.0[3], carry);
  605|       |
