  418|  39.0k|pub fn halving(height: Height, network: &Network) -> u32 {
  419|  39.0k|    let slow_start_shift = network.slow_start_shift();
  420|  39.0k|    let blossom_height = NetworkUpgrade::Blossom
  421|  39.0k|        .activation_height(network)
  422|  39.0k|        .expect("blossom activation height should be available");
  423|       |
  424|  39.0k|    let halving_index = if height < slow_start_shift {
  425|  8.74k|        0
  426|  30.3k|    } else if height < blossom_height {
  427|  7.81k|        let pre_blossom_height = height - slow_start_shift;
  428|  7.81k|        pre_blossom_height / network.pre_blossom_halving_interval()
  429|       |    } else {
  430|  22.5k|        let pre_blossom_height = blossom_height - slow_start_shift;
  431|  22.5k|        let scaled_pre_blossom_height =
  432|  22.5k|            pre_blossom_height * HeightDiff::from(BLOSSOM_POW_TARGET_SPACING_RATIO);
  433|       |
  434|  22.5k|        let post_blossom_height = height - blossom_height;
  435|       |
  436|  22.5k|        (scaled_pre_blossom_height + post_blossom_height) / network.post_blossom_halving_interval()
  437|       |    };
  438|       |
  439|  39.0k|    halving_index
  440|  39.0k|        .try_into()
  441|  39.0k|        .expect("already checked for negatives")
  442|  39.0k|}
