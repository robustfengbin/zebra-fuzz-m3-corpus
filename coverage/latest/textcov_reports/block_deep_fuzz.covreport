_RNvXsa_Cs3VjbIwwZMBL_6jubjubNtB5_11AffinePointINtNtCs6SNw0SRvItZ_4core7convert4FromRNtB5_13ExtendedPointE4from:
  233|  57.0k|    fn from(extended: &'a ExtendedPoint) -> AffinePoint {
