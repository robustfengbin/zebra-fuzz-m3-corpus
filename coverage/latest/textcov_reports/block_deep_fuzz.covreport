  638|  10.3M|    pub const fn add(&self, rhs: &Self) -> Self {
  639|  10.3M|        let (d0, carry) = adc(self.0[0], rhs.0[0], 0);
  640|  10.3M|        let (d1, carry) = adc(self.0[1], rhs.0[1], carry);
  641|  10.3M|        let (d2, carry) = adc(self.0[2], rhs.0[2], carry);
  642|  10.3M|        let (d3, _) = adc(self.0[3], rhs.0[3], carry);
  643|       |
  644|       |        // Attempt to subtract the modulus, to ensure the value
  645|       |        // is smaller than the modulus.
  646|  10.3M|        (&Fr([d0, d1, d2, d3])).sub(&MODULUS)
  647|  10.3M|    }
_RNvMsc_NtCs3VjbIwwZMBL_6jubjub2frNtB5_2Fr3negCsckoVJ3NjISC_14sapling_crypto:
  651|   875k|    pub const fn neg(&self) -> Self {
  652|       |        // Subtract `self` from `MODULUS` to negate. Ignore the final
  653|       |        // borrow because it cannot underflow; self is guaranteed to
  654|       |        // be in the field.
  655|   875k|        let (d0, borrow) = sbb(MODULUS.0[0], self.0[0], 0);
  656|   875k|        let (d1, borrow) = sbb(MODULUS.0[1], self.0[1], borrow);
  657|   875k|        let (d2, borrow) = sbb(MODULUS.0[2], self.0[2], borrow);
  658|   875k|        let (d3, _) = sbb(MODULUS.0[3], self.0[3], borrow);
  659|       |
  660|       |        // `tmp` could be `MODULUS` if `self` was zero. Create a mask that is
  661|       |        // zero if `self` was zero, and `u64::max_value()` if self was nonzero.
  662|   875k|        let mask = (((self.0[0] | self.0[1] | self.0[2] | self.0[3]) == 0) as u64).wrapping_sub(1);
  663|       |
  664|   875k|        Fr([d0 & mask, d1 & mask, d2 & mask, d3 & mask])
  665|   875k|    }
