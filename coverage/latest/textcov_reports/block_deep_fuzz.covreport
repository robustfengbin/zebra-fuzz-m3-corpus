  137|  5.42k|    let b = I::b();
  138|  5.42k|    let z_u2 = z * u.square();
  139|  5.42k|    let ta = z_u2.square() + z_u2;
  140|  5.42k|    let num_x1 = b * (ta + F::ONE);
  141|  5.42k|    let div = a * F::conditional_select(&-ta, &z, ta.is_zero());
  142|  5.42k|    let num2_x1 = num_x1.square();
  143|  5.42k|    let div2 = div.square();
  144|  5.42k|    let div3 = div2 * div;
  145|  5.42k|    let num_gx1 = (num2_x1 + a * div2) * num_x1 + b * div3;
  146|       |
  147|       |    // 5. x2 = Z * u^2 * x1
  148|  5.42k|    let num_x2 = z_u2 * num_x1; // same div
  149|       |
  150|       |    // 6. gx2 = x2^3 + A * x2 + B  [optimized out; see below]
  151|       |    // 7. If is_square(gx1), set x = x1 and y = sqrt(gx1)
  152|       |    // 8. Else set x = x2 and y = sqrt(gx2)
  153|  5.42k|    let (gx1_square, y1) = F::sqrt_ratio(&num_gx1, &div3);
