  260|    286|        h.write_all(d.prevouts_digest.as_bytes()).unwrap();
  261|    286|        h.write_all(d.sequence_digest.as_bytes()).unwrap();
  262|    286|        h.write_all(d.outputs_digest.as_bytes()).unwrap();
  263|    286|    }
  264|    394|    h.finalize()
  265|    394|}
