  229|    394|fn hash_header_txid_data(
  230|    394|    version: TxVersion,
  231|    394|    // we commit to the consensus branch ID with the header
  232|    394|    consensus_branch_id: BranchId,
  233|    394|    lock_time: u32,
  234|    394|    expiry_height: BlockHeight,
  235|    394|    #[cfg(all(zcash_unstable = "nu7", feature = "zip-233"))] zip233_amount: &Zatoshis,
  236|    394|) -> Blake2bHash {
  237|    394|    let mut h = hasher(ZCASH_HEADERS_HASH_PERSONALIZATION);
  238|       |
  239|    394|    h.write_u32_le(version.header()).unwrap();
  240|    394|    h.write_u32_le(version.version_group_id()).unwrap();
  241|    394|    h.write_u32_le(consensus_branch_id.into()).unwrap();
  242|    394|    h.write_u32_le(lock_time).unwrap();
  243|    394|    h.write_u32_le(expiry_height.into()).unwrap();
  244|       |
  245|       |    // TODO: Factor this out into a separate txid computation when implementing ZIP 246 in full.
  246|       |    #[cfg(all(zcash_unstable = "nu7", feature = "zip-233"))]
  247|       |    if version.has_zip233() {
  248|       |        h.write_u64_le((*zip233_amount).into()).unwrap();
  249|       |    }
  250|       |
  251|    394|    h.finalize()
  252|    394|}
