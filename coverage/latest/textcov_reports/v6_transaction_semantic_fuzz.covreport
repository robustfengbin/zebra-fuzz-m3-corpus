  518|       |        // <http://cacr.uwaterloo.ca/hac/about/chap14.pdf>.
  519|       |
  520|  5.36M|        let k = r0.wrapping_mul(INV);
  521|  5.36M|        let (_, carry) = mac(r0, k, MODULUS.0[0], 0);
  522|  5.36M|        let (r1, carry) = mac(r1, k, MODULUS.0[1], carry);
  523|  5.36M|        let (r2, carry) = mac(r2, k, MODULUS.0[2], carry);
  524|  5.36M|        let (r3, carry) = mac(r3, k, MODULUS.0[3], carry);
  525|  5.36M|        let (r4, carry2) = adc(r4, 0, carry);
  526|       |
  527|  5.36M|        let k = r1.wrapping_mul(INV);
  528|  5.36M|        let (_, carry) = mac(r1, k, MODULUS.0[0], 0);
  529|  5.36M|        let (r2, carry) = mac(r2, k, MODULUS.0[1], carry);
  530|  5.36M|        let (r3, carry) = mac(r3, k, MODULUS.0[2], carry);
  531|  5.36M|        let (r4, carry) = mac(r4, k, MODULUS.0[3], carry);
  532|  5.36M|        let (r5, carry2) = adc(r5, carry2, carry);
  533|       |
  534|  5.36M|        let k = r2.wrapping_mul(INV);
  535|  5.36M|        let (_, carry) = mac(r2, k, MODULUS.0[0], 0);
  536|  5.36M|        let (r3, carry) = mac(r3, k, MODULUS.0[1], carry);
  537|  5.36M|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  538|  5.36M|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
  539|  5.36M|        let (r6, carry2) = adc(r6, carry2, carry);
  540|       |
  541|  5.36M|        let k = r3.wrapping_mul(INV);
  542|  5.36M|        let (_, carry) = mac(r3, k, MODULUS.0[0], 0);
  543|  5.36M|        let (r4, carry) = mac(r4, k, MODULUS.0[1], carry);
  544|  5.36M|        let (r5, carry) = mac(r5, k, MODULUS.0[2], carry);
  545|  5.36M|        let (r6, carry) = mac(r6, k, MODULUS.0[3], carry);
  546|  5.36M|        let (r7, _) = adc(r7, carry2, carry);
  547|       |
