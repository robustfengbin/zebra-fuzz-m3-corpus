  354|  16.2k|        let r4 = (r4 << 1) | (r3 >> 63);
  355|  16.2k|        let r3 = (r3 << 1) | (r2 >> 63);
  356|  16.2k|        let r2 = (r2 << 1) | (r1 >> 63);
