  332|   720k|        let (r4, carry) = mac(r4, self.0[2], self.0[2], carry);
  333|   720k|        let (r5, carry) = adc(0, r5, carry);
  334|   720k|        let (r6, carry) = mac(r6, self.0[3], self.0[3], carry);
  335|   720k|        let (r7, _) = adc(0, r7, carry);
