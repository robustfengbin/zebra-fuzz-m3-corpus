  415|    458|    let v_spend_auth_sigs = Array::read(&mut reader, n_spends, |r| read_spend_auth_sig(r))?;
  416|    458|    let v_output_proofs = Array::read(&mut reader, n_outputs, |r| read_zkproof(r))?;
  417|       |
