  419|  12.4k|        let mut t6 = t16.square();
  420|  12.4k|        let mut t5 = t6 * t0;
  421|  12.4k|        t0 = t6 * t16;
  422|  12.4k|        let mut t12 = t5 * t16;
  423|  12.4k|        let mut t2 = t6.square();
  424|  12.4k|        let mut t7 = t5 * t6;
