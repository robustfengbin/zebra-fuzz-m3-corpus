  600|  59.3k|    pub const fn add(&self, rhs: &Self) -> Self {
  601|  59.3k|        let (d0, carry) = adc(self.0[0], rhs.0[0], 0);
  602|  59.3k|        let (d1, carry) = adc(self.0[1], rhs.0[1], carry);
  603|  59.3k|        let (d2, carry) = adc(self.0[2], rhs.0[2], carry);
  604|  59.3k|        let (d3, _) = adc(self.0[3], rhs.0[3], carry);
