  342|   387k|    const fn montgomery_reduce(
  343|   387k|        r0: u64,
  344|   387k|        r1: u64,
  345|   387k|        r2: u64,
  346|   387k|        r3: u64,
  347|   387k|        r4: u64,
  348|   387k|        r5: u64,
  349|   387k|        r6: u64,
  350|   387k|        r7: u64,
  351|   387k|    ) -> Self {
  352|       |        // The Montgomery reduction here is based on Algorithm 14.32 in
  353|       |        // Handbook of Applied Cryptography
  354|       |        // <http://cacr.uwaterloo.ca/hac/about/chap14.pdf>.
  355|       |
  356|   387k|        let k = r0.wrapping_mul(INV);
  357|   387k|        let (_, carry) = mac(r0, k, MODULUS.0[0], 0);
  358|   387k|        let (r1, carry) = mac(r1, k, MODULUS.0[1], carry);
  359|   387k|        let (r2, carry) = mac(r2, k, MODULUS.0[2], carry);
  360|   387k|        let (r3, carry) = mac(r3, k, MODULUS.0[3], carry);
  361|   387k|        let (r4, carry2) = adc(r4, 0, carry);
  362|       |
  363|   387k|        let k = r1.wrapping_mul(INV);
  364|   387k|        let (_, carry) = mac(r1, k, MODULUS.0[0], 0);
  365|   387k|        let (r2, carry) = mac(r2, k, MODULUS.0[1], carry);
  366|   387k|        let (r3, carry) = mac(r3, k, MODULUS.0[2], carry);
  367|   387k|        let (r4, carry) = mac(r4, k, MODULUS.0[3], carry);
  368|   387k|        let (r5, carry2) = adc(r5, carry2, carry);
  369|       |
  370|   387k|        let k = r2.wrapping_mul(INV);
  371|   387k|        let (_, carry) = mac(r2, k, MODULUS.0[0], 0);
  372|   387k|        let (r3, carry) = mac(r3, k, MODULUS.0[1], carry);
  373|   387k|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  374|   387k|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
  375|   387k|        let (r6, carry2) = adc(r6, carry2, carry);
  376|       |
  377|   387k|        let k = r3.wrapping_mul(INV);
  378|   387k|        let (_, carry) = mac(r3, k, MODULUS.0[0], 0);
  379|   387k|        let (r4, carry) = mac(r4, k, MODULUS.0[1], carry);
  380|   387k|        let (r5, carry) = mac(r5, k, MODULUS.0[2], carry);
  381|   387k|        let (r6, carry) = mac(r6, k, MODULUS.0[3], carry);
  382|   387k|        let (r7, _) = adc(r7, carry2, carry);
  383|       |
