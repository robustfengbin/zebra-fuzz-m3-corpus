  536|  5.60M|        let (r3, carry) = mac(r3, k, MODULUS.0[1], carry);
  537|  5.60M|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  538|  5.60M|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
  539|  5.60M|        let (r6, carry2) = adc(r6, carry2, carry);
