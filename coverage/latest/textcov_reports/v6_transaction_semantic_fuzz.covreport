  536|  3.27M|        let (r3, carry) = mac(r3, k, MODULUS.0[1], carry);
  537|  3.27M|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  538|  3.27M|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
