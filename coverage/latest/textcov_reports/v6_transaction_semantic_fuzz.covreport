  342|   409k|    const fn montgomery_reduce(
  343|   409k|        r0: u64,
  344|   409k|        r1: u64,
  345|   409k|        r2: u64,
  346|   409k|        r3: u64,
  347|   409k|        r4: u64,
  348|   409k|        r5: u64,
  349|   409k|        r6: u64,
  350|   409k|        r7: u64,
  351|   409k|    ) -> Self {
  352|       |        // The Montgomery reduction here is based on Algorithm 14.32 in
  353|       |        // Handbook of Applied Cryptography
  354|       |        // <http://cacr.uwaterloo.ca/hac/about/chap14.pdf>.
  355|       |
  356|   409k|        let k = r0.wrapping_mul(INV);
  357|   409k|        let (_, carry) = mac(r0, k, MODULUS.0[0], 0);
  358|   409k|        let (r1, carry) = mac(r1, k, MODULUS.0[1], carry);
  359|   409k|        let (r2, carry) = mac(r2, k, MODULUS.0[2], carry);
  360|   409k|        let (r3, carry) = mac(r3, k, MODULUS.0[3], carry);
  361|   409k|        let (r4, carry2) = adc(r4, 0, carry);
  362|       |
  363|   409k|        let k = r1.wrapping_mul(INV);
  364|   409k|        let (_, carry) = mac(r1, k, MODULUS.0[0], 0);
  365|   409k|        let (r2, carry) = mac(r2, k, MODULUS.0[1], carry);
  366|   409k|        let (r3, carry) = mac(r3, k, MODULUS.0[2], carry);
  367|   409k|        let (r4, carry) = mac(r4, k, MODULUS.0[3], carry);
  368|   409k|        let (r5, carry2) = adc(r5, carry2, carry);
  369|       |
  370|   409k|        let k = r2.wrapping_mul(INV);
  371|   409k|        let (_, carry) = mac(r2, k, MODULUS.0[0], 0);
  372|   409k|        let (r3, carry) = mac(r3, k, MODULUS.0[1], carry);
  373|   409k|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  374|   409k|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
  375|   409k|        let (r6, carry2) = adc(r6, carry2, carry);
  376|       |
  377|   409k|        let k = r3.wrapping_mul(INV);
  378|   409k|        let (_, carry) = mac(r3, k, MODULUS.0[0], 0);
  379|   409k|        let (r4, carry) = mac(r4, k, MODULUS.0[1], carry);
  380|   409k|        let (r5, carry) = mac(r5, k, MODULUS.0[2], carry);
  381|   409k|        let (r6, carry) = mac(r6, k, MODULUS.0[3], carry);
  382|   409k|        let (r7, _) = adc(r7, carry2, carry);
  383|       |
