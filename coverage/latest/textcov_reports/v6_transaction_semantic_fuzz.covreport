  342|   868k|    const fn montgomery_reduce(
  343|   868k|        r0: u64,
  344|   868k|        r1: u64,
  345|   868k|        r2: u64,
  346|   868k|        r3: u64,
  347|   868k|        r4: u64,
  348|   868k|        r5: u64,
  349|   868k|        r6: u64,
  350|   868k|        r7: u64,
  351|   868k|    ) -> Self {
  352|       |        // The Montgomery reduction here is based on Algorithm 14.32 in
  353|       |        // Handbook of Applied Cryptography
  354|       |        // <http://cacr.uwaterloo.ca/hac/about/chap14.pdf>.
  355|       |
  356|   868k|        let k = r0.wrapping_mul(INV);
  357|   868k|        let (_, carry) = mac(r0, k, MODULUS.0[0], 0);
  358|   868k|        let (r1, carry) = mac(r1, k, MODULUS.0[1], carry);
  359|   868k|        let (r2, carry) = mac(r2, k, MODULUS.0[2], carry);
  360|   868k|        let (r3, carry) = mac(r3, k, MODULUS.0[3], carry);
  361|   868k|        let (r4, carry2) = adc(r4, 0, carry);
  362|       |
  363|   868k|        let k = r1.wrapping_mul(INV);
  364|   868k|        let (_, carry) = mac(r1, k, MODULUS.0[0], 0);
  365|   868k|        let (r2, carry) = mac(r2, k, MODULUS.0[1], carry);
  366|   868k|        let (r3, carry) = mac(r3, k, MODULUS.0[2], carry);
  367|   868k|        let (r4, carry) = mac(r4, k, MODULUS.0[3], carry);
  368|   868k|        let (r5, carry2) = adc(r5, carry2, carry);
  369|       |
  370|   868k|        let k = r2.wrapping_mul(INV);
  371|   868k|        let (_, carry) = mac(r2, k, MODULUS.0[0], 0);
  372|   868k|        let (r3, carry) = mac(r3, k, MODULUS.0[1], carry);
  373|   868k|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  374|   868k|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
  375|   868k|        let (r6, carry2) = adc(r6, carry2, carry);
  376|       |
  377|   868k|        let k = r3.wrapping_mul(INV);
  378|   868k|        let (_, carry) = mac(r3, k, MODULUS.0[0], 0);
  379|   868k|        let (r4, carry) = mac(r4, k, MODULUS.0[1], carry);
  380|   868k|        let (r5, carry) = mac(r5, k, MODULUS.0[2], carry);
  381|   868k|        let (r6, carry) = mac(r6, k, MODULUS.0[3], carry);
  382|   868k|        let (r7, _) = adc(r7, carry2, carry);
  383|       |
  384|       |        // Result may be within MODULUS of the correct value
  385|   868k|        (&Fp([r4, r5, r6, r7])).sub(&MODULUS)
  386|   868k|    }
