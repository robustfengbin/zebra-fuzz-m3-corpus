_RNvNtNtCsblBBgngKd3Y_16zcash_primitives11transaction4txid10to_hash_v6:
  423|    394|pub(crate) fn to_hash_v6(
  424|    394|    consensus_branch_id: BranchId,
  425|    394|    header_digest: Blake2bHash,
  426|    394|    transparent_digest: Blake2bHash,
  427|    394|    sapling_digest: Option<Blake2bHash>,
  428|    394|    orchard_digest: Option<Blake2bHash>,
  429|    394|    ironwood_digest: Option<Blake2bHash>,
  430|    394|) -> Blake2bHash {
  431|    394|    let mut personal = [0; 16];
  432|    394|    personal[..12].copy_from_slice(ZCASH_TX_PERSONALIZATION_PREFIX);
  433|    394|    (&mut personal[12..])
  434|    394|        .write_u32_le(consensus_branch_id.into())
  435|    394|        .unwrap();
  436|       |
  437|    394|    let mut h = hasher(&personal);
  438|    394|    h.write_all(header_digest.as_bytes()).unwrap();
  439|    394|    h.write_all(transparent_digest.as_bytes()).unwrap();
  440|    394|    h.write_all(
  441|    394|        sapling_digest
  442|    394|            .unwrap_or_else(hash_sapling_txid_empty)
  443|    394|            .as_bytes(),
  444|       |    )
  445|    394|    .unwrap();
  446|    394|    h.write_all(
  447|    394|        orchard_digest
  448|    394|            .unwrap_or_else(|| {
  449|       |                let (value_pool, tx_version) = orchard_commitment_domain(TxVersion::V6);
  450|       |                orchard::commitments::hash_bundle_txid_empty(value_pool, tx_version)
  451|       |                    .expect("empty Orchard bundle txid commitment is valid for its tx format")
  452|       |            })
  453|    394|            .as_bytes(),
  454|       |    )
  455|    394|    .unwrap();
  456|    394|    h.write_all(
  457|    394|        ironwood_digest
  458|    394|            .unwrap_or_else(|| {
  459|       |                let (value_pool, tx_version) = ironwood_v6_domain();
  460|       |                orchard::commitments::hash_bundle_txid_empty(value_pool, tx_version)
  461|       |                    .expect("empty Ironwood bundle txid commitment is valid")
  462|       |            })
  463|    394|            .as_bytes(),
  464|       |    )
  465|    394|    .unwrap();
  466|       |
  467|    394|    h.finalize()
  468|    394|}
