  413|    464|        s[ 0] =   limbs[0]                           as u8;
  414|    464|        s[ 1] =  (limbs[0] >>  8)                    as u8;
  415|    464|        s[ 2] =  (limbs[0] >> 16)                    as u8;
  416|    464|        s[ 3] =  (limbs[0] >> 24)                    as u8;
  417|    464|        s[ 4] =  (limbs[0] >> 32)                    as u8;
  418|    464|        s[ 5] =  (limbs[0] >> 40)                    as u8;
  419|    464|        s[ 6] = ((limbs[0] >> 48) | (limbs[1] << 3)) as u8;
  420|    464|        s[ 7] =  (limbs[1] >>  5)                    as u8;
  421|    464|        s[ 8] =  (limbs[1] >> 13)                    as u8;
  422|    464|        s[ 9] =  (limbs[1] >> 21)                    as u8;
  423|    464|        s[10] =  (limbs[1] >> 29)                    as u8;
  424|    464|        s[11] =  (limbs[1] >> 37)                    as u8;
  425|    464|        s[12] = ((limbs[1] >> 45) | (limbs[2] << 6)) as u8;
  426|    464|        s[13] =  (limbs[2] >>  2)                    as u8;
  427|    464|        s[14] =  (limbs[2] >> 10)                    as u8;
  428|    464|        s[15] =  (limbs[2] >> 18)                    as u8;
  429|    464|        s[16] =  (limbs[2] >> 26)                    as u8;
  430|    464|        s[17] =  (limbs[2] >> 34)                    as u8;
  431|    464|        s[18] =  (limbs[2] >> 42)                    as u8;
  432|    464|        s[19] = ((limbs[2] >> 50) | (limbs[3] << 1)) as u8;
  433|    464|        s[20] =  (limbs[3] >>  7)                    as u8;
  434|    464|        s[21] =  (limbs[3] >> 15)                    as u8;
  435|    464|        s[22] =  (limbs[3] >> 23)                    as u8;
  436|    464|        s[23] =  (limbs[3] >> 31)                    as u8;
  437|    464|        s[24] =  (limbs[3] >> 39)                    as u8;
