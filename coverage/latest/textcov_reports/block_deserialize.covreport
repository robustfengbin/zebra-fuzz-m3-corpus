  557|  68.9k|        let (r0, carry) = mac(0, self.0[0], rhs.0[0], 0);
  558|  68.9k|        let (r1, carry) = mac(0, self.0[0], rhs.0[1], carry);
  559|  68.9k|        let (r2, carry) = mac(0, self.0[0], rhs.0[2], carry);
