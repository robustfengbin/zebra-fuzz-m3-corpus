  601|  64.3k|        let (d0, carry) = adc(self.0[0], rhs.0[0], 0);
  602|  64.3k|        let (d1, carry) = adc(self.0[1], rhs.0[1], carry);
  603|  64.3k|        let (d2, carry) = adc(self.0[2], rhs.0[2], carry);
