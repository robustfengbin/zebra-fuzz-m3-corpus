  341|  5.83M|    pub const fn square(&self) -> Scalar {
  342|  5.83M|        let (r1, carry) = mac(0, self.0[0], self.0[1], 0);
  343|  5.83M|        let (r2, carry) = mac(0, self.0[0], self.0[2], carry);
