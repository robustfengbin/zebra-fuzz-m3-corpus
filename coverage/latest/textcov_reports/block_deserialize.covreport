  506|  6.97M|    const fn montgomery_reduce(
  507|  6.97M|        r0: u64,
  508|  6.97M|        r1: u64,
  509|  6.97M|        r2: u64,
  510|  6.97M|        r3: u64,
  511|  6.97M|        r4: u64,
  512|  6.97M|        r5: u64,
  513|  6.97M|        r6: u64,
  514|  6.97M|        r7: u64,
  515|  6.97M|    ) -> Self {
  516|       |        // The Montgomery reduction here is based on Algorithm 14.32 in
  517|       |        // Handbook of Applied Cryptography
  518|       |        // <http://cacr.uwaterloo.ca/hac/about/chap14.pdf>.
  519|       |
  520|  6.97M|        let k = r0.wrapping_mul(INV);
  521|  6.97M|        let (_, carry) = mac(r0, k, MODULUS.0[0], 0);
