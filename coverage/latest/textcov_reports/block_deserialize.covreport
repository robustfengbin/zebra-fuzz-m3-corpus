  557|  38.0k|        let (r0, carry) = mac(0, self.0[0], rhs.0[0], 0);
  558|  38.0k|        let (r1, carry) = mac(0, self.0[0], rhs.0[1], carry);
  559|  38.0k|        let (r2, carry) = mac(0, self.0[0], rhs.0[2], carry);
