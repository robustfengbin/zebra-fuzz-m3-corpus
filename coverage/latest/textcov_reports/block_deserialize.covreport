  753|       |        // B = (u + v)^2
  754|       |        // C = u^2
  755|       |        // D = v^2
  756|       |        // F = D - C
  757|       |        // H = 2 * z^2
  758|       |        // J = F - H
  759|       |        // U = (B - C - D) * J
  760|       |        // V = F * (- C - D)
  761|       |        // Z = F * J
