   78|       |            // Type is SpendAuthSig^{Orchard}.Public, i.e. ℙ.
   79|       |            // https://zips.z.cash/protocol/protocol.pdf#concretespendauthsig
   80|       |            // https://zips.z.cash/protocol/protocol.pdf#concretereddsa
   81|       |            // This only reads the 32-byte buffer. The type is enforced
   82|       |            // on signature verification; see [`reddsa::batch`]
   83|       |            rk: {
   84|     70|                let rk_bytes = reader.read_32_bytes()?;
   85|     70|                if rk_bytes == [0u8; 32] {
   86|      0|                    return Err(SerializationError::Parse(
   87|      0|                        "Orchard action rk must not be the identity point",
   88|      0|                    ));
   89|     70|                }
   90|     70|                rk_bytes.into()
   91|       |            },
   92|       |            // Type is `{0 .. 𝑞_ℙ − 1}`. Note that the second rule quoted above
   93|       |            // is also enforced here and it is technically redundant with the first.
   94|       |            // See [`pallas::Base::zcash_deserialize`].
   95|     70|            cm_x: pallas::Base::zcash_deserialize(&mut reader)?,
