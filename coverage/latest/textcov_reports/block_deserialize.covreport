  768|       |        // F = D - C
  769|       |        // K = D + C
  770|       |        // H = 2 * z^2
  771|       |        // J = F - H
  772|       |        // U = (B - K) * J
  773|       |        // V = F * (-K)
  774|       |        // Z = F * J
