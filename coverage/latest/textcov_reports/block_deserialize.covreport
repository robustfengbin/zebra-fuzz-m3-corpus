  368|    414|    pub fn as_bytes(&self) -> [u8; 32] {
  369|       |        // Let h = limbs[0] + limbs[1]*2^51 + ... + limbs[4]*2^204.
  370|       |        //
  371|       |        // Write h = pq + r with 0 <= r < p.
  372|       |        //
  373|       |        // We want to compute r = h mod p.
  374|       |        //
  375|       |        // If h < 2*p = 2^256 - 38,
  376|       |        // then q = 0 or 1,
  377|       |        //
  378|       |        // with q = 0 when h < p
  379|       |        //  and q = 1 when h >= p.
  380|       |        //
  381|       |        // Notice that h >= p <==> h + 19 >= p + 19 <==> h + 19 >= 2^255.
  382|       |        // Therefore q can be computed as the carry bit of h + 19.
  383|       |
  384|       |        // First, reduce the limbs to ensure h < 2*p.
  385|    414|        let mut limbs = FieldElement51::reduce(self.0).0;
  386|       |
  387|    414|        let mut q = (limbs[0] + 19) >> 51;
  388|    414|        q = (limbs[1] + q) >> 51;
  389|    414|        q = (limbs[2] + q) >> 51;
  390|    414|        q = (limbs[3] + q) >> 51;
  391|    414|        q = (limbs[4] + q) >> 51;
  392|       |
  393|       |        // Now we can compute r as r = h - pq = r - (2^255-19)q = r + 19q - 2^255q
  394|       |
  395|    414|        limbs[0] += 19 * q;
  396|       |
  397|       |        // Now carry the result to compute r + 19q ...
  398|    414|        let low_51_bit_mask = (1u64 << 51) - 1;
  399|    414|        limbs[1] += limbs[0] >> 51;
  400|    414|        limbs[0] &= low_51_bit_mask;
  401|    414|        limbs[2] += limbs[1] >> 51;
  402|    414|        limbs[1] &= low_51_bit_mask;
  403|    414|        limbs[3] += limbs[2] >> 51;
  404|    414|        limbs[2] &= low_51_bit_mask;
  405|    414|        limbs[4] += limbs[3] >> 51;
  406|    414|        limbs[3] &= low_51_bit_mask;
  407|       |        // ... but instead of carrying (limbs[4] >> 51) = 2^255q
  408|       |        // into another limb, discard it, subtracting the value
  409|    414|        limbs[4] &= low_51_bit_mask;
  410|       |
  411|       |        // Now arrange the bits of the limbs.
  412|    414|        let mut s = [0u8;32];
  413|    414|        s[ 0] =   limbs[0]                           as u8;
  414|    414|        s[ 1] =  (limbs[0] >>  8)                    as u8;
  415|    414|        s[ 2] =  (limbs[0] >> 16)                    as u8;
  416|    414|        s[ 3] =  (limbs[0] >> 24)                    as u8;
  417|    414|        s[ 4] =  (limbs[0] >> 32)                    as u8;
  418|    414|        s[ 5] =  (limbs[0] >> 40)                    as u8;
  419|    414|        s[ 6] = ((limbs[0] >> 48) | (limbs[1] << 3)) as u8;
  420|    414|        s[ 7] =  (limbs[1] >>  5)                    as u8;
  421|    414|        s[ 8] =  (limbs[1] >> 13)                    as u8;
  422|    414|        s[ 9] =  (limbs[1] >> 21)                    as u8;
  423|    414|        s[10] =  (limbs[1] >> 29)                    as u8;
  424|    414|        s[11] =  (limbs[1] >> 37)                    as u8;
  425|    414|        s[12] = ((limbs[1] >> 45) | (limbs[2] << 6)) as u8;
  426|    414|        s[13] =  (limbs[2] >>  2)                    as u8;
  427|    414|        s[14] =  (limbs[2] >> 10)                    as u8;
  428|    414|        s[15] =  (limbs[2] >> 18)                    as u8;
  429|    414|        s[16] =  (limbs[2] >> 26)                    as u8;
  430|    414|        s[17] =  (limbs[2] >> 34)                    as u8;
  431|    414|        s[18] =  (limbs[2] >> 42)                    as u8;
  432|    414|        s[19] = ((limbs[2] >> 50) | (limbs[3] << 1)) as u8;
  433|    414|        s[20] =  (limbs[3] >>  7)                    as u8;
  434|    414|        s[21] =  (limbs[3] >> 15)                    as u8;
  435|    414|        s[22] =  (limbs[3] >> 23)                    as u8;
  436|    414|        s[23] =  (limbs[3] >> 31)                    as u8;
  437|    414|        s[24] =  (limbs[3] >> 39)                    as u8;
