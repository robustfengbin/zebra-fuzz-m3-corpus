  373|   883k|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  374|   883k|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
  375|   883k|        let (r6, carry2) = adc(r6, carry2, carry);
  376|       |
