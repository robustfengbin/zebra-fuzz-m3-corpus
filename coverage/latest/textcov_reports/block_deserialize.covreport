  369|       |        // any valid large blocks.
  370|       |        //
  371|       |        // TODO: put a separate limit on proofs in spends and outputs
  372|    675|        max(
  373|    675|            SpendPrefixInTransactionV5::max_allocation(),
  374|    675|            OutputPrefixInTransactionV5::max_allocation(),
  375|       |        )
  376|    675|    }
