 1033|    658|                let sapling_transfers = if !shielded_spends.is_empty() {
 1034|     63|                    Some(sapling::TransferData::SpendsAndMaybeOutputs {
 1035|     63|                        shared_anchor: FieldNotPresent,
 1036|     63|                        spends: shielded_spends.try_into().expect("checked for spends"),
