  962|       |            (4, true) => {
  963|       |                // Transaction V4 spec:
  964|       |                // https://zips.z.cash/protocol/protocol.pdf#txnencoding
  965|       |
  966|       |                // Denoted as `nVersionGroupId` in the spec.
  967|    658|                let id = limited_reader.read_u32::<LittleEndian>()?;
  968|    658|                if id != SAPLING_VERSION_GROUP_ID {
  969|      0|                    return Err(SerializationError::Parse(
