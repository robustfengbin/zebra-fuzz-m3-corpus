  187|     87|    fn zcash_deserialize<R: io::Read>(mut reader: R) -> Result<Self, SerializationError> {
  188|       |        // # Consensus
  189|       |        //
  190|       |        // > Elements of a Spend description MUST be valid encodings of the types given above.
  191|       |        //
