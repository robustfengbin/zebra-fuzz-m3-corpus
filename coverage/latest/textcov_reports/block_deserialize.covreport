  347|  33.6k|        let (r4, r5) = mac(r4, self.0[1], self.0[3], carry);
  348|       |
  349|  33.6k|        let (r5, r6) = mac(r5, self.0[2], self.0[3], 0);
  350|       |
  351|  33.6k|        let r7 = r6 >> 63;
