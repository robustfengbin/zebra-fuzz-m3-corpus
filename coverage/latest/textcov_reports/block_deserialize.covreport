  200|       |
  201|    278|            let (height, data) = if script_sig.as_slice() == GENESIS_COINBASE_SCRIPT_SIG {
  202|      1|                (Height::MIN, GENESIS_COINBASE_SCRIPT_SIG.to_vec())
  203|       |            } else {
  204|    277|                parse_coinbase_height(&script_sig)?
  205|       |            };
