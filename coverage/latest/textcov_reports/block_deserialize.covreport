  354|  34.8k|        let r4 = (r4 << 1) | (r3 >> 63);
  355|  34.8k|        let r3 = (r3 << 1) | (r2 >> 63);
  356|  34.8k|        let r2 = (r2 << 1) | (r1 >> 63);
  357|  34.8k|        let r1 = r1 << 1;
