  368|    464|    pub fn as_bytes(&self) -> [u8; 32] {
  369|       |        // Let h = limbs[0] + limbs[1]*2^51 + ... + limbs[4]*2^204.
  370|       |        //
  371|       |        // Write h = pq + r with 0 <= r < p.
  372|       |        //
  373|       |        // We want to compute r = h mod p.
  374|       |        //
  375|       |        // If h < 2*p = 2^256 - 38,
  376|       |        // then q = 0 or 1,
  377|       |        //
  378|       |        // with q = 0 when h < p
  379|       |        //  and q = 1 when h >= p.
  380|       |        //
  381|       |        // Notice that h >= p <==> h + 19 >= p + 19 <==> h + 19 >= 2^255.
  382|       |        // Therefore q can be computed as the carry bit of h + 19.
  383|       |
  384|       |        // First, reduce the limbs to ensure h < 2*p.
  385|    464|        let mut limbs = FieldElement51::reduce(self.0).0;
  386|       |
  387|    464|        let mut q = (limbs[0] + 19) >> 51;
  388|    464|        q = (limbs[1] + q) >> 51;
  389|    464|        q = (limbs[2] + q) >> 51;
  390|    464|        q = (limbs[3] + q) >> 51;
  391|    464|        q = (limbs[4] + q) >> 51;
  392|       |
  393|       |        // Now we can compute r as r = h - pq = r - (2^255-19)q = r + 19q - 2^255q
  394|       |
  395|    464|        limbs[0] += 19 * q;
  396|       |
  397|       |        // Now carry the result to compute r + 19q ...
  398|    464|        let low_51_bit_mask = (1u64 << 51) - 1;
  399|    464|        limbs[1] += limbs[0] >> 51;
  400|    464|        limbs[0] &= low_51_bit_mask;
  401|    464|        limbs[2] += limbs[1] >> 51;
  402|    464|        limbs[1] &= low_51_bit_mask;
  403|    464|        limbs[3] += limbs[2] >> 51;
  404|    464|        limbs[2] &= low_51_bit_mask;
  405|    464|        limbs[4] += limbs[3] >> 51;
  406|    464|        limbs[3] &= low_51_bit_mask;
