  823|  7.68k|            v: vv_plus_uu,
  824|  7.68k|            z: vv_minus_uu,
  825|  7.68k|            t: zz2 - vv_minus_uu,
  826|  7.68k|        }
  827|  7.68k|        .into_extended()
  828|  7.68k|    }
