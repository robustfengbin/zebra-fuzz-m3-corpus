  341|  58.6k|    pub const fn square(&self) -> Scalar {
  342|  58.6k|        let (r1, carry) = mac(0, self.0[0], self.0[1], 0);
  343|  58.6k|        let (r2, carry) = mac(0, self.0[0], self.0[2], carry);
  344|  58.6k|        let (r3, r4) = mac(0, self.0[0], self.0[3], carry);
  345|       |
  346|  58.6k|        let (r3, carry) = mac(r3, self.0[1], self.0[2], 0);
  347|  58.6k|        let (r4, r5) = mac(r4, self.0[1], self.0[3], carry);
  348|       |
  349|  58.6k|        let (r5, r6) = mac(r5, self.0[2], self.0[3], 0);
  350|       |
