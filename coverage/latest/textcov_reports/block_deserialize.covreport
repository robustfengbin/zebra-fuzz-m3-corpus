  600|  26.2k|    pub const fn add(&self, rhs: &Self) -> Self {
  601|  26.2k|        let (d0, carry) = adc(self.0[0], rhs.0[0], 0);
  602|  26.2k|        let (d1, carry) = adc(self.0[1], rhs.0[1], carry);
  603|  26.2k|        let (d2, carry) = adc(self.0[2], rhs.0[2], carry);
  604|  26.2k|        let (d3, _) = adc(self.0[3], rhs.0[3], carry);
  605|       |
