  362|  36.5k|        let (r3, carry) = adc(0, r3, carry);
  363|  36.5k|        let (r4, carry) = mac(r4, self.0[2], self.0[2], carry);
  364|  36.5k|        let (r5, carry) = adc(0, r5, carry);
  365|  36.5k|        let (r6, carry) = mac(r6, self.0[3], self.0[3], carry);
  366|  36.5k|        let (r7, _) = adc(0, r7, carry);
  367|       |
  368|  36.5k|        Scalar::montgomery_reduce(r0, r1, r2, r3, r4, r5, r6, r7)
  369|  36.5k|    }
