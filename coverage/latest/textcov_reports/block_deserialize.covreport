  217|       |                               // 1 == x1 * ROOT_OF_UNITY^(t_ << 16)
  218|  1.08k|        assert!(t_ < 0x10000);
  219|  1.08k|        let alpha = x2 * self.g1[t_ & 0xFF] * self.g2[t_ >> 8];
  220|       |
