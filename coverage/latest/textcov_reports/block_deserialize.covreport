  372|   384k|        let (r3, carry) = mac(r3, k, MODULUS.0[1], carry);
  373|   384k|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  374|   384k|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
  375|   384k|        let (r6, carry2) = adc(r6, carry2, carry);
  376|       |
  377|   384k|        let k = r3.wrapping_mul(INV);
  378|   384k|        let (_, carry) = mac(r3, k, MODULUS.0[0], 0);
  379|   384k|        let (r4, carry) = mac(r4, k, MODULUS.0[1], carry);
  380|   384k|        let (r5, carry) = mac(r5, k, MODULUS.0[2], carry);
