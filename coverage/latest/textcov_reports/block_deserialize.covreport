  556|       |
  557|  97.1k|        let (r0, carry) = mac(0, self.0[0], rhs.0[0], 0);
  558|  97.1k|        let (r1, carry) = mac(0, self.0[0], rhs.0[1], carry);
  559|  97.1k|        let (r2, carry) = mac(0, self.0[0], rhs.0[2], carry);
