  227|  1.08k|        t_ += inv(alpha) << 24; // = t << 1
  228|       |                                // 1 == x3 * ROOT_OF_UNITY^t_
  229|  1.08k|        t_ = (((t_ as u64) + 1) >> 1) as usize;
  230|  1.08k|        assert!(t_ <= 0x80000000);
