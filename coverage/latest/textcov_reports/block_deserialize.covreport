  363|   701k|        let k = r1.wrapping_mul(INV);
  364|   701k|        let (_, carry) = mac(r1, k, MODULUS.0[0], 0);
  365|   701k|        let (r2, carry) = mac(r2, k, MODULUS.0[1], carry);
  366|   701k|        let (r3, carry) = mac(r3, k, MODULUS.0[2], carry);
  367|   701k|        let (r4, carry) = mac(r4, k, MODULUS.0[3], carry);
