  506|  7.25M|    const fn montgomery_reduce(
  507|  7.25M|        r0: u64,
  508|  7.25M|        r1: u64,
  509|  7.25M|        r2: u64,
  510|  7.25M|        r3: u64,
  511|  7.25M|        r4: u64,
  512|  7.25M|        r5: u64,
  513|  7.25M|        r6: u64,
  514|  7.25M|        r7: u64,
  515|  7.25M|    ) -> Self {
  516|       |        // The Montgomery reduction here is based on Algorithm 14.32 in
  517|       |        // Handbook of Applied Cryptography
  518|       |        // <http://cacr.uwaterloo.ca/hac/about/chap14.pdf>.
  519|       |
  520|  7.25M|        let k = r0.wrapping_mul(INV);
  521|  7.25M|        let (_, carry) = mac(r0, k, MODULUS.0[0], 0);
  522|  7.25M|        let (r1, carry) = mac(r1, k, MODULUS.0[1], carry);
  523|  7.25M|        let (r2, carry) = mac(r2, k, MODULUS.0[2], carry);
  524|  7.25M|        let (r3, carry) = mac(r3, k, MODULUS.0[3], carry);
  525|  7.25M|        let (r4, carry2) = adc(r4, 0, carry);
  526|       |
  527|  7.25M|        let k = r1.wrapping_mul(INV);
  528|  7.25M|        let (_, carry) = mac(r1, k, MODULUS.0[0], 0);
  529|  7.25M|        let (r2, carry) = mac(r2, k, MODULUS.0[1], carry);
  530|  7.25M|        let (r3, carry) = mac(r3, k, MODULUS.0[2], carry);
  531|  7.25M|        let (r4, carry) = mac(r4, k, MODULUS.0[3], carry);
  532|  7.25M|        let (r5, carry2) = adc(r5, carry2, carry);
  533|       |
  534|  7.25M|        let k = r2.wrapping_mul(INV);
  535|  7.25M|        let (_, carry) = mac(r2, k, MODULUS.0[0], 0);
  536|  7.25M|        let (r3, carry) = mac(r3, k, MODULUS.0[1], carry);
  537|  7.25M|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  538|  7.25M|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
  539|  7.25M|        let (r6, carry2) = adc(r6, carry2, carry);
  540|       |
  541|  7.25M|        let k = r3.wrapping_mul(INV);
  542|  7.25M|        let (_, carry) = mac(r3, k, MODULUS.0[0], 0);
  543|  7.25M|        let (r4, carry) = mac(r4, k, MODULUS.0[1], carry);
  544|  7.25M|        let (r5, carry) = mac(r5, k, MODULUS.0[2], carry);
  545|  7.25M|        let (r6, carry) = mac(r6, k, MODULUS.0[3], carry);
  546|  7.25M|        let (r7, _) = adc(r7, carry2, carry);
  547|       |
  548|       |        // Result may be within MODULUS of the correct value
  549|  7.25M|        (&Scalar([r4, r5, r6, r7])).sub(&MODULUS)
  550|  7.25M|    }
