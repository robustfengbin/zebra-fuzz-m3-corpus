   21|  57.5k|    fn split_blocks<N: ArrayLength<u8>>(data: &[u8]) -> (&[Block<N>], &[u8]) {
   22|  57.5k|        let nb = data.len() / N::USIZE;
   23|  57.5k|        let blocks_len = nb * N::USIZE;
   24|  57.5k|        let tail_len = data.len() - blocks_len;
   25|       |        // SAFETY: we guarantee that created slices do not point
   26|       |        // outside of `data`
   27|       |        unsafe {
   28|  57.5k|            let blocks_ptr = data.as_ptr() as *const Block<N>;
   29|  57.5k|            let tail_ptr = data.as_ptr().add(blocks_len);
   30|  57.5k|            (
   31|  57.5k|                slice::from_raw_parts(blocks_ptr, nb),
   32|  57.5k|                slice::from_raw_parts(tail_ptr, tail_len),
   33|  57.5k|            )
   34|       |        }
   35|  57.5k|    }

