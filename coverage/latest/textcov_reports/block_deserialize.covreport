  440|    540|        s[27] =  (limbs[4] >> 12)                    as u8;
  441|    540|        s[28] =  (limbs[4] >> 20)                    as u8;
  442|    540|        s[29] =  (limbs[4] >> 28)                    as u8;
  443|    540|        s[30] =  (limbs[4] >> 36)                    as u8;
  444|    540|        s[31] =  (limbs[4] >> 44)                    as u8;
