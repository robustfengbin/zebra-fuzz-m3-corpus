   28|  72.5k|            let blocks_ptr = data.as_ptr() as *const Block<N>;
   29|  72.5k|            let tail_ptr = data.as_ptr().add(blocks_len);
   30|  72.5k|            (
   31|  72.5k|                slice::from_raw_parts(blocks_ptr, nb),
   32|  72.5k|                slice::from_raw_parts(tail_ptr, tail_len),
   33|  72.5k|            )
   34|       |        }
   35|  72.5k|    }

