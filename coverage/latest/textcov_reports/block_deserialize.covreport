  618|  4.52k|        let (d1, borrow) = sbb(MODULUS.0[1], self.0[1], borrow);
  619|  4.52k|        let (d2, borrow) = sbb(MODULUS.0[2], self.0[2], borrow);
  620|  4.52k|        let (d3, _) = sbb(MODULUS.0[3], self.0[3], borrow);
  621|       |
