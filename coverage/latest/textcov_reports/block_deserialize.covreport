  567|  97.1k|        let (r2, carry) = mac(r2, self.0[2], rhs.0[0], 0);
  568|  97.1k|        let (r3, carry) = mac(r3, self.0[2], rhs.0[1], carry);
  569|  97.1k|        let (r4, carry) = mac(r4, self.0[2], rhs.0[2], carry);
  570|  97.1k|        let (r5, r6) = mac(r5, self.0[2], rhs.0[3], carry);
