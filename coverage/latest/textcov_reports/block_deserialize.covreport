  414|    614|        s[ 1] =  (limbs[0] >>  8)                    as u8;
  415|    614|        s[ 2] =  (limbs[0] >> 16)                    as u8;
  416|    614|        s[ 3] =  (limbs[0] >> 24)                    as u8;
  417|    614|        s[ 4] =  (limbs[0] >> 32)                    as u8;
  418|    614|        s[ 5] =  (limbs[0] >> 40)                    as u8;
  419|    614|        s[ 6] = ((limbs[0] >> 48) | (limbs[1] << 3)) as u8;
  420|    614|        s[ 7] =  (limbs[1] >>  5)                    as u8;
  421|    614|        s[ 8] =  (limbs[1] >> 13)                    as u8;
  422|    614|        s[ 9] =  (limbs[1] >> 21)                    as u8;
  423|    614|        s[10] =  (limbs[1] >> 29)                    as u8;
  424|    614|        s[11] =  (limbs[1] >> 37)                    as u8;
  425|    614|        s[12] = ((limbs[1] >> 45) | (limbs[2] << 6)) as u8;
  426|    614|        s[13] =  (limbs[2] >>  2)                    as u8;
  427|    614|        s[14] =  (limbs[2] >> 10)                    as u8;
  428|    614|        s[15] =  (limbs[2] >> 18)                    as u8;
  429|    614|        s[16] =  (limbs[2] >> 26)                    as u8;
  430|    614|        s[17] =  (limbs[2] >> 34)                    as u8;
  431|    614|        s[18] =  (limbs[2] >> 42)                    as u8;
  432|    614|        s[19] = ((limbs[2] >> 50) | (limbs[3] << 1)) as u8;
  433|    614|        s[20] =  (limbs[3] >>  7)                    as u8;
  434|    614|        s[21] =  (limbs[3] >> 15)                    as u8;
  435|    614|        s[22] =  (limbs[3] >> 23)                    as u8;
  436|    614|        s[23] =  (limbs[3] >> 31)                    as u8;
