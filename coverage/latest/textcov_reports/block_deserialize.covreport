   29|  36.8k|            let tail_ptr = data.as_ptr().add(blocks_len);
   30|  36.8k|            (
   31|  36.8k|                slice::from_raw_parts(blocks_ptr, nb),
   32|  36.8k|                slice::from_raw_parts(tail_ptr, tail_len),
   33|  36.8k|            )
   34|       |        }
   35|  36.8k|    }

