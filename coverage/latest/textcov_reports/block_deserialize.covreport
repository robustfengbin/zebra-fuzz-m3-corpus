  353|  82.0k|        let r5 = (r5 << 1) | (r4 >> 63);
  354|  82.0k|        let r4 = (r4 << 1) | (r3 >> 63);
  355|  82.0k|        let r3 = (r3 << 1) | (r2 >> 63);
  356|  82.0k|        let r2 = (r2 << 1) | (r1 >> 63);
  357|  82.0k|        let r1 = r1 << 1;
