  194|    300|            if len < MIN_COINBASE_SCRIPT_LEN {
  195|      0|                return Err(SerializationError::Parse("Coinbase script is too short"));
  196|    300|            } else if len > MAX_COINBASE_SCRIPT_LEN {
  197|      0|                return Err(SerializationError::Parse("Coinbase script is too long"));
  198|    300|            }
  199|    300|            let script_sig = zcash_deserialize_bytes_external_count(len, &mut reader)?;
  200|       |
  201|    300|            let (height, data) = if script_sig.as_slice() == GENESIS_COINBASE_SCRIPT_SIG {
  202|      1|                (Height::MIN, GENESIS_COINBASE_SCRIPT_SIG.to_vec())
  203|       |            } else {
  204|    299|                parse_coinbase_height(&script_sig)?
  205|       |            };
  206|       |
  207|       |            Ok(Input::Coinbase {
  208|    300|                height,
  209|    300|                data,
  210|    300|                sequence: reader.read_u32::<LittleEndian>()?,
  211|       |            })
