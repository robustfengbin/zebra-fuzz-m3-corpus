  359|  9.77M|        let (r0, carry) = mac(0, self.0[0], self.0[0], 0);
  360|  9.77M|        let (r1, carry) = adc(0, r1, carry);
  361|  9.77M|        let (r2, carry) = mac(r2, self.0[1], self.0[1], carry);
