  341|  29.5k|    pub const fn square(&self) -> Scalar {
  342|  29.5k|        let (r1, carry) = mac(0, self.0[0], self.0[1], 0);
  343|  29.5k|        let (r2, carry) = mac(0, self.0[0], self.0[2], carry);
