  341|  13.6M|    pub const fn square(&self) -> Scalar {
  342|  13.6M|        let (r1, carry) = mac(0, self.0[0], self.0[1], 0);
  343|  13.6M|        let (r2, carry) = mac(0, self.0[0], self.0[2], carry);
  344|  13.6M|        let (r3, r4) = mac(0, self.0[0], self.0[3], carry);
