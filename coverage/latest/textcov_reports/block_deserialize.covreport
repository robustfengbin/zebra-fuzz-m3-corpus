  618|  11.2k|        let (d1, borrow) = sbb(MODULUS.0[1], self.0[1], borrow);
  619|  11.2k|        let (d2, borrow) = sbb(MODULUS.0[2], self.0[2], borrow);
  620|  11.2k|        let (d3, _) = sbb(MODULUS.0[3], self.0[3], borrow);
  621|       |
  622|       |        // `tmp` could be `MODULUS` if `self` was zero. Create a mask that is
  623|       |        // zero if `self` was zero, and `u64::max_value()` if self was nonzero.
