  150|    434|    fn zcash_deserialize<R: io::Read>(reader: R) -> Result<Self, SerializationError> {
  151|       |        // # Consensus
  152|       |        //
  153|       |        // > The size of a block MUST be less than or equal to 2000000 bytes.
  154|       |        //
  155|       |        // https://zips.z.cash/protocol/protocol.pdf#blockheader
  156|       |        //
  157|       |        // If the limit is reached, we'll get an UnexpectedEof error
  158|    434|        let limited_reader = &mut reader.take(MAX_BLOCK_BYTES);
  159|       |        Ok(Block {
  160|    434|            header: limited_reader.zcash_deserialize_into()?,
  161|    434|            transactions: limited_reader.zcash_deserialize_into()?,
