  364|   883k|        let (_, carry) = mac(r1, k, MODULUS.0[0], 0);
  365|   883k|        let (r2, carry) = mac(r2, k, MODULUS.0[1], carry);
  366|   883k|        let (r3, carry) = mac(r3, k, MODULUS.0[2], carry);
