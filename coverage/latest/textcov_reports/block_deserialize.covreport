   59|    116|    fn zcash_deserialize<R: io::Read>(mut reader: R) -> Result<Self, SerializationError> {
   60|       |        // # Consensus
   61|       |        //
   62|       |        // > Elements of an Action description MUST be canonical encodings of the types given above.
   63|       |        //
   64|       |        // https://zips.z.cash/protocol/protocol.pdf#actiondesc
   65|       |        //
   66|       |        // > LEOS2IP_{256}(cmx) MUST be less than 𝑞_ℙ.
   67|       |        //
   68|       |        // https://zips.z.cash/protocol/protocol.pdf#actionencodingandconsensus
   69|       |        //
   70|       |        // See comments below for each specific type.
   71|       |        Ok(Action {
   72|       |            // Type is ValueCommit^{Orchard}.Output, i.e. ℙ.
   73|       |            // https://zips.z.cash/protocol/protocol.pdf#abstractcommit
   74|       |            // See [`ValueCommitment::zcash_deserialize`].
   75|    116|            cv: ValueCommitment::zcash_deserialize(&mut reader)?,
   76|       |            // Type is `{0 .. 𝑞_ℙ − 1}`. See [`Nullifier::try_from`].
   77|    116|            nullifier: Nullifier::try_from(reader.read_32_bytes()?)?,
   78|       |            // Type is SpendAuthSig^{Orchard}.Public, i.e. ℙ.
   79|       |            // https://zips.z.cash/protocol/protocol.pdf#concretespendauthsig
   80|       |            // https://zips.z.cash/protocol/protocol.pdf#concretereddsa
   81|       |            // This only reads the 32-byte buffer. The type is enforced
   82|       |            // on signature verification; see [`reddsa::batch`]
   83|       |            rk: {
   84|    116|                let rk_bytes = reader.read_32_bytes()?;
   85|    116|                if rk_bytes == [0u8; 32] {
   86|      0|                    return Err(SerializationError::Parse(
   87|      0|                        "Orchard action rk must not be the identity point",
   88|      0|                    ));
   89|    116|                }
   90|    116|                rk_bytes.into()
   91|       |            },
   92|       |            // Type is `{0 .. 𝑞_ℙ − 1}`. Note that the second rule quoted above
   93|       |            // is also enforced here and it is technically redundant with the first.
   94|       |            // See [`pallas::Base::zcash_deserialize`].
   95|    116|            cm_x: pallas::Base::zcash_deserialize(&mut reader)?,
   96|       |            // Denoted by `epk` in the spec. Type is KA^{Orchard}.Public, i.e. ℙ^*.
   97|       |            // https://zips.z.cash/protocol/protocol.pdf#concreteorchardkeyagreement
   98|       |            // See [`keys::EphemeralPublicKey::zcash_deserialize`].
   99|    116|            ephemeral_key: keys::EphemeralPublicKey::zcash_deserialize(&mut reader)?,
  100|       |            // Type is `Sym.C`, i.e. `𝔹^Y^{\[N\]}`, i.e. arbitrary-sized byte arrays
  101|       |            // https://zips.z.cash/protocol/protocol.pdf#concretesym but fixed to
  102|       |            // 580 bytes in https://zips.z.cash/protocol/protocol.pdf#outputencodingandconsensus
  103|       |            // See [`note::EncryptedNote::zcash_deserialize`].
  104|    116|            enc_ciphertext: note::EncryptedNote::zcash_deserialize(&mut reader)?,
  105|       |            // Type is `Sym.C`, i.e. `𝔹^Y^{\[N\]}`, i.e. arbitrary-sized byte arrays
  106|       |            // https://zips.z.cash/protocol/protocol.pdf#concretesym but fixed to
  107|       |            // 80 bytes in https://zips.z.cash/protocol/protocol.pdf#outputencodingandconsensus
  108|       |            // See [`note::WrappedNoteKey::zcash_deserialize`].
  109|    116|            out_ciphertext: note::WrappedNoteKey::zcash_deserialize(&mut reader)?,
  110|       |        })
  111|    116|    }
