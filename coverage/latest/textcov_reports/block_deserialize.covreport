  563|  38.0k|        let (r2, carry) = mac(r2, self.0[1], rhs.0[1], carry);
  564|  38.0k|        let (r3, carry) = mac(r3, self.0[1], rhs.0[2], carry);
  565|  38.0k|        let (r4, r5) = mac(r4, self.0[1], rhs.0[3], carry);
