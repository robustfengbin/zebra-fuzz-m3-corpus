  563|  97.1k|        let (r2, carry) = mac(r2, self.0[1], rhs.0[1], carry);
  564|  97.1k|        let (r3, carry) = mac(r3, self.0[1], rhs.0[2], carry);
  565|  97.1k|        let (r4, r5) = mac(r4, self.0[1], rhs.0[3], carry);
