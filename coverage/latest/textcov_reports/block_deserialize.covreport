  236|  59.2k|    stride: Stride,
  237|  59.2k|) -> (&'a [u8; BLOCKBYTES], usize, bool) {
  238|  59.2k|    let capped_offset = cmp::min(offset, input.len());
  239|  59.2k|    let offset_slice = &input[capped_offset..];
  240|  59.2k|    if offset_slice.len() >= BLOCKBYTES {
