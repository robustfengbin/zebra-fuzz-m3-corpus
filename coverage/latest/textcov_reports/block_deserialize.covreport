  506|  10.1M|    const fn montgomery_reduce(
  507|  10.1M|        r0: u64,
  508|  10.1M|        r1: u64,
  509|  10.1M|        r2: u64,
  510|  10.1M|        r3: u64,
  511|  10.1M|        r4: u64,
  512|  10.1M|        r5: u64,
  513|  10.1M|        r6: u64,
  514|  10.1M|        r7: u64,
  515|  10.1M|    ) -> Self {
  516|       |        // The Montgomery reduction here is based on Algorithm 14.32 in
  517|       |        // Handbook of Applied Cryptography
  518|       |        // <http://cacr.uwaterloo.ca/hac/about/chap14.pdf>.
  519|       |
  520|  10.1M|        let k = r0.wrapping_mul(INV);
  521|  10.1M|        let (_, carry) = mac(r0, k, MODULUS.0[0], 0);
  522|  10.1M|        let (r1, carry) = mac(r1, k, MODULUS.0[1], carry);
  523|  10.1M|        let (r2, carry) = mac(r2, k, MODULUS.0[2], carry);
  524|  10.1M|        let (r3, carry) = mac(r3, k, MODULUS.0[3], carry);
  525|  10.1M|        let (r4, carry2) = adc(r4, 0, carry);
  526|       |
  527|  10.1M|        let k = r1.wrapping_mul(INV);
  528|  10.1M|        let (_, carry) = mac(r1, k, MODULUS.0[0], 0);
  529|  10.1M|        let (r2, carry) = mac(r2, k, MODULUS.0[1], carry);
  530|  10.1M|        let (r3, carry) = mac(r3, k, MODULUS.0[2], carry);
  531|  10.1M|        let (r4, carry) = mac(r4, k, MODULUS.0[3], carry);
  532|  10.1M|        let (r5, carry2) = adc(r5, carry2, carry);
  533|       |
  534|  10.1M|        let k = r2.wrapping_mul(INV);
  535|  10.1M|        let (_, carry) = mac(r2, k, MODULUS.0[0], 0);
  536|  10.1M|        let (r3, carry) = mac(r3, k, MODULUS.0[1], carry);
  537|  10.1M|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  538|  10.1M|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
  539|  10.1M|        let (r6, carry2) = adc(r6, carry2, carry);
  540|       |
  541|  10.1M|        let k = r3.wrapping_mul(INV);
  542|  10.1M|        let (_, carry) = mac(r3, k, MODULUS.0[0], 0);
  543|  10.1M|        let (r4, carry) = mac(r4, k, MODULUS.0[1], carry);
  544|  10.1M|        let (r5, carry) = mac(r5, k, MODULUS.0[2], carry);
  545|  10.1M|        let (r6, carry) = mac(r6, k, MODULUS.0[3], carry);
  546|  10.1M|        let (r7, _) = adc(r7, carry2, carry);
  547|       |
  548|       |        // Result may be within MODULUS of the correct value
  549|  10.1M|        (&Scalar([r4, r5, r6, r7])).sub(&MODULUS)
  550|  10.1M|    }
