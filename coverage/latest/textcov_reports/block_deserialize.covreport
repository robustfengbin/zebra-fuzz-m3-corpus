  284|  33.3k|    pub fn to_bytes(&self) -> [u8; 32] {
  285|       |        // Turn into canonical form by computing
  286|       |        // (a.R) / R = a
  287|  33.3k|        let tmp = Scalar::montgomery_reduce(self.0[0], self.0[1], self.0[2], self.0[3], 0, 0, 0, 0);
  288|       |
  289|  33.3k|        let mut res = [0; 32];
  290|  33.3k|        res[0..8].copy_from_slice(&tmp.0[0].to_le_bytes());
  291|  33.3k|        res[8..16].copy_from_slice(&tmp.0[1].to_le_bytes());
  292|  33.3k|        res[16..24].copy_from_slice(&tmp.0[2].to_le_bytes());
  293|  33.3k|        res[24..32].copy_from_slice(&tmp.0[3].to_le_bytes());
  294|       |
  295|  33.3k|        res
  296|  33.3k|    }
