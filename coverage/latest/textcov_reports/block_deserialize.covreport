  985|    658|                let inputs: Vec<transparent::Input> = Vec::zcash_deserialize(&mut limited_reader)?;
  986|       |
  987|       |                // Denoted as `tx_out_count` and `tx_out` in the spec.
  988|    658|                let outputs = Vec::zcash_deserialize(&mut limited_reader)?;
  989|       |
  990|    658|                let is_coinbase = inputs.len() == 1
  991|    237|                    && matches!(inputs.first(), Some(transparent::Input::Coinbase { .. }));
  992|       |
  993|       |                // Denoted as `lock_time` in the spec.
  994|    658|                let lock_time = LockTime::zcash_deserialize(&mut limited_reader)?;
  995|       |
  996|       |                // Denoted as `nExpiryHeight` in the spec.
  997|    658|                let expiry_height = block::Height(limited_reader.read_u32::<LittleEndian>()?);
  998|       |
  999|       |                // Denoted as `valueBalanceSapling` in the spec.
 1000|    658|                let value_balance = (&mut limited_reader).zcash_deserialize_into()?;
 1001|       |
 1002|       |                // Denoted as `nSpendsSapling` — read count before allocating.
 1003|    658|                let spend_count: CompactSizeMessage =
 1004|    658|                    (&mut limited_reader).zcash_deserialize_into()?;
 1005|    658|                let spend_count: usize = spend_count.into();
 1006|       |
 1007|       |                // # Consensus
 1008|       |                //
 1009|       |                // > A coinbase transaction MUST NOT have any Spend descriptions.
 1010|       |                //
 1011|       |                // <https://zips.z.cash/protocol/protocol.pdf#txnconsensus>
 1012|    658|                if is_coinbase && spend_count > 0 {
 1013|      0|                    return Err(SerializationError::Parse(
 1014|      0|                        "coinbase transaction must not have Sapling spends",
 1015|      0|                    ));
