   29|  40.5k|            let tail_ptr = data.as_ptr().add(blocks_len);
   30|  40.5k|            (
   31|  40.5k|                slice::from_raw_parts(blocks_ptr, nb),
   32|  40.5k|                slice::from_raw_parts(tail_ptr, tail_len),
   33|  40.5k|            )
   34|       |        }
   35|  40.5k|    }

