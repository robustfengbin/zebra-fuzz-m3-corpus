  447|       |
  448|  54.5k|        let mut local_words = *words;
  449|       |
  450|  54.5k|        let mut fin_offset = input.len().saturating_sub(1);
  451|  54.5k|        fin_offset -= fin_offset % stride.padded_blockbytes();
