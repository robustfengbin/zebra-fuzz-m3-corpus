   26|       |
   27|  7.72k|    let mut v = F::S;
   28|  7.72k|    let mut x = w * f;
   29|  7.72k|    let mut b = x * w;
   30|       |
   31|       |    // Initialize z as the 2^S root of unity.
   32|  7.72k|    let mut z = F::ROOT_OF_UNITY;
   33|       |
   34|   247k|    for max_v in (1..=F::S).rev() {
   35|   247k|        let mut k = 1;
   36|   247k|        let mut b2k = b.square();
   37|   247k|        let mut j_less_than_v: Choice = 1.into();
   38|       |
