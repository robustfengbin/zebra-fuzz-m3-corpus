  397|       |        // Now carry the result to compute r + 19q ...
  398|    194|        let low_51_bit_mask = (1u64 << 51) - 1;
  399|    194|        limbs[1] += limbs[0] >> 51;
  400|    194|        limbs[0] &= low_51_bit_mask;
  401|    194|        limbs[2] += limbs[1] >> 51;
  402|    194|        limbs[1] &= low_51_bit_mask;
  403|    194|        limbs[3] += limbs[2] >> 51;
  404|    194|        limbs[2] &= low_51_bit_mask;
  405|    194|        limbs[4] += limbs[3] >> 51;
