  228|       |            // B^Y^{[ceiling(ℓ_G/8) + ceiling(bitlength(𝑟_G)/8)]} i.e. 64 bytes
  229|       |            // https://zips.z.cash/protocol/protocol.pdf#concretereddsa
  230|      1|            spend_auth_sig: reader.read_64_bytes()?.into(),
  231|       |        })
  232|      1|    }
