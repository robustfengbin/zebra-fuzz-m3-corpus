  155|     19|                sapling_crypto::value::ValueCommitment::zcash_deserialize(&mut reader)?,
  156|       |            ),
  157|       |            // Type is `B^{[ℓ_{Sapling}_{Merkle}]}`, i.e. 32 bytes.
  158|       |            // However, the consensus rule above restricts it even more.
  159|       |            // See [`sapling_crypto::note::ExtractedNoteCommitment::zcash_deserialize`].
  160|     19|            cm_u: sapling_crypto::note::ExtractedNoteCommitment::zcash_deserialize(&mut reader)?,
