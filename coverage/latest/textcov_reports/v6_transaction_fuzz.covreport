  316|     72|        limbs[0] += c4 * 19;
  317|     72|        limbs[1] += c0;
  318|     72|        limbs[2] += c1;
  319|     72|        limbs[3] += c2;
  320|     72|        limbs[4] += c3;
  321|       |
  322|     72|        FieldElement51(limbs)
  323|     72|    }
