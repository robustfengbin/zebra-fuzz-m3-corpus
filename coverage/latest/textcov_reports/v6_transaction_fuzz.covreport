  193|    908|        let is_nonsquare = (sq - F::ROOT_OF_UNITY * u).is_zero();
  194|    908|        assert!(bool::from(u.is_zero() | (is_square ^ is_nonsquare)));
  195|       |
  196|    908|        (is_square, res)
  197|    908|    }

