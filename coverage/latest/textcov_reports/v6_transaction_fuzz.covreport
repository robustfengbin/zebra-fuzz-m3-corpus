 1454|    152|    pub(crate) const fn num_days_from_ce(&self) -> i32 {
 1455|       |        // we know this wouldn't overflow since year is limited to 1/2^13 of i32's full range.
 1456|    152|        let mut year = self.year() - 1;
 1457|    152|        let mut ndays = 0;
 1458|    152|        if year < 0 {
 1459|      0|            let excess = 1 + (-year) / 400;
 1460|      0|            year += excess * 400;
 1461|      0|            ndays -= excess * 146_097;
 1462|    152|        }
 1463|    152|        let div_100 = year / 100;
 1464|    152|        ndays += ((year * 1461) >> 2) - div_100 + (div_100 >> 2);
 1465|    152|        ndays + self.ordinal() as i32
 1466|    152|    }
_RNvMNtNtCs8jXVBPYSQuE_6chrono5naive4dateNtB2_9NaiveDate22from_ordinal_and_flags:
  130|    153|    const fn from_ordinal_and_flags(
  131|    153|        year: i32,
  132|    153|        ordinal: u32,
  133|    153|        flags: YearFlags,
  134|    153|    ) -> Option<NaiveDate> {
  135|    153|        if year < MIN_YEAR || year > MAX_YEAR {
  136|      0|            return None; // Out-of-range
  137|    153|        }
  138|    153|        if ordinal == 0 || ordinal > 366 {
  139|      0|            return None; // Invalid
  140|    153|        }
  141|    153|        debug_assert!(YearFlags::from_year(year).0 == flags.0);
  142|    153|        let yof = (year << 13) | (ordinal << 4) as i32 | flags.0 as i32;
  143|    153|        match yof & OL_MASK <= MAX_OL {
