  928|     75|                    inputs: Vec::zcash_deserialize(&mut limited_reader)?,
  929|       |                    // Denoted as `tx_out_count` and `tx_out` in the spec.
  930|     75|                    outputs: Vec::zcash_deserialize(&mut limited_reader)?,
