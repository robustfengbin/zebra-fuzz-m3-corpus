  932|    894|    pub fn orchard_protocol_revision(&self) -> Option<OrchardProtocolRevision> {
  933|       |        use BranchId::*;
  934|    894|        match self {
  935|      0|            Sprout | Overwinter | Sapling | Blossom | Heartwood | Canopy => None,
