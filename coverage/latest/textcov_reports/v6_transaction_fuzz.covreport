  451|       |                    .expect("empty Orchard bundle txid commitment is valid for its tx format")
  452|       |            })
  453|    368|            .as_bytes(),
  454|       |    )
  455|    368|    .unwrap();
  456|    368|    h.write_all(
  457|    368|        ironwood_digest
