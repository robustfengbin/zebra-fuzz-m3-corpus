  135|       |        // Collect arrays for Spends
  136|       |        // There's no unzip3, so we have to unzip twice.
  137|    132|        let (spend_prefixes, spend_proofs_sigs): (Vec<_>, Vec<_>) = self
  138|    132|            .spends()
  139|    132|            .cloned()
  140|    132|            .map(sapling::Spend::<sapling::SharedAnchor>::into_v5_parts)
  141|    132|            .map(|(prefix, proof, sig)| (prefix, (proof, sig)))
  142|    132|            .unzip();
  143|    132|        let (spend_proofs, spend_sigs) = spend_proofs_sigs.into_iter().unzip();
  144|       |
  145|       |        // Collect arrays for Outputs
  146|    132|        let (output_prefixes, output_proofs): (Vec<_>, _) = self
  147|    132|            .outputs()
  148|    132|            .cloned()
  149|    132|            .map(sapling::Output::into_v5_parts)
  150|    132|            .unzip();
  151|       |
  152|       |        // Denoted as `nSpendsSapling` and `vSpendsSapling` in the spec.
  153|    132|        spend_prefixes.zcash_serialize(&mut writer)?;
  154|       |        // Denoted as `nOutputsSapling` and `vOutputsSapling` in the spec.
  155|    132|        output_prefixes.zcash_serialize(&mut writer)?;
  156|       |
  157|       |        // Denoted as `valueBalanceSapling` in the spec.
  158|    132|        self.value_balance.zcash_serialize(&mut writer)?;
  159|       |
  160|       |        // Denoted as `anchorSapling` in the spec.
  161|       |        // `TransferData` ensures this field is only present when there is at
  162|       |        // least one spend.
  163|    132|        if let Some(shared_anchor) = self.shared_anchor() {
  164|    100|            writer.write_all(&<[u8; 32]>::from(shared_anchor)[..])?;
  165|     32|        }
  166|       |
  167|       |        // Denoted as `vSpendProofsSapling` in the spec.
  168|    132|        zcash_serialize_external_count(&spend_proofs, &mut writer)?;
  169|       |        // Denoted as `vSpendAuthSigsSapling` in the spec.
  170|    132|        zcash_serialize_external_count(&spend_sigs, &mut writer)?;
  171|       |
  172|       |        // Denoted as `vOutputProofsSapling` in the spec.
  173|    132|        zcash_serialize_external_count(&output_proofs, &mut writer)?;
  174|       |
  175|       |        // Denoted as `bindingSigSapling` in the spec.
  176|    132|        writer.write_all(&<[u8; 64]>::from(self.binding_sig)[..])?;
  177|       |
  178|    132|        Ok(())
  179|    132|    }
