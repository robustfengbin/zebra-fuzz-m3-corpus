  344|   295k|        r1: u64,
  345|   295k|        r2: u64,
  346|   295k|        r3: u64,
  347|   295k|        r4: u64,
  348|   295k|        r5: u64,
  349|   295k|        r6: u64,
  350|   295k|        r7: u64,
  351|   295k|    ) -> Self {
  352|       |        // The Montgomery reduction here is based on Algorithm 14.32 in
  353|       |        // Handbook of Applied Cryptography
  354|       |        // <http://cacr.uwaterloo.ca/hac/about/chap14.pdf>.
  355|       |
  356|   295k|        let k = r0.wrapping_mul(INV);
  357|   295k|        let (_, carry) = mac(r0, k, MODULUS.0[0], 0);
  358|   295k|        let (r1, carry) = mac(r1, k, MODULUS.0[1], carry);
  359|   295k|        let (r2, carry) = mac(r2, k, MODULUS.0[2], carry);
  360|   295k|        let (r3, carry) = mac(r3, k, MODULUS.0[3], carry);
  361|   295k|        let (r4, carry2) = adc(r4, 0, carry);
  362|       |
  363|   295k|        let k = r1.wrapping_mul(INV);
  364|   295k|        let (_, carry) = mac(r1, k, MODULUS.0[0], 0);
  365|   295k|        let (r2, carry) = mac(r2, k, MODULUS.0[1], carry);
  366|   295k|        let (r3, carry) = mac(r3, k, MODULUS.0[2], carry);
  367|   295k|        let (r4, carry) = mac(r4, k, MODULUS.0[3], carry);
  368|   295k|        let (r5, carry2) = adc(r5, carry2, carry);
  369|       |
  370|   295k|        let k = r2.wrapping_mul(INV);
  371|   295k|        let (_, carry) = mac(r2, k, MODULUS.0[0], 0);
  372|   295k|        let (r3, carry) = mac(r3, k, MODULUS.0[1], carry);
  373|   295k|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  374|   295k|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
  375|   295k|        let (r6, carry2) = adc(r6, carry2, carry);
  376|       |
  377|   295k|        let k = r3.wrapping_mul(INV);
  378|   295k|        let (_, carry) = mac(r3, k, MODULUS.0[0], 0);
  379|   295k|        let (r4, carry) = mac(r4, k, MODULUS.0[1], carry);
  380|   295k|        let (r5, carry) = mac(r5, k, MODULUS.0[2], carry);
  381|   295k|        let (r6, carry) = mac(r6, k, MODULUS.0[3], carry);
  382|   295k|        let (r7, _) = adc(r7, carry2, carry);
  383|       |
