  372|   424k|        let (r3, carry) = mac(r3, k, MODULUS.0[1], carry);
  373|   424k|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  374|   424k|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
  375|   424k|        let (r6, carry2) = adc(r6, carry2, carry);
  376|       |
  377|   424k|        let k = r3.wrapping_mul(INV);
  378|   424k|        let (_, carry) = mac(r3, k, MODULUS.0[0], 0);
  379|   424k|        let (r4, carry) = mac(r4, k, MODULUS.0[1], carry);
  380|   424k|        let (r5, carry) = mac(r5, k, MODULUS.0[2], carry);
