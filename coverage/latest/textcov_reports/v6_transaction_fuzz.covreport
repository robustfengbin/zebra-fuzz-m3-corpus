  386|       |
  387|     84|        let mut q = (limbs[0] + 19) >> 51;
  388|     84|        q = (limbs[1] + q) >> 51;
  389|     84|        q = (limbs[2] + q) >> 51;
  390|     84|        q = (limbs[3] + q) >> 51;
  391|     84|        q = (limbs[4] + q) >> 51;
  392|       |
  393|       |        // Now we can compute r as r = h - pq = r - (2^255-19)q = r + 19q - 2^255q
