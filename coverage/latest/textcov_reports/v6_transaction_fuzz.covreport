  311|   257k|        let (r1, carry) = mac(0, self.0[0], self.0[1], 0);
  312|   257k|        let (r2, carry) = mac(0, self.0[0], self.0[2], carry);
  313|   257k|        let (r3, r4) = mac(0, self.0[0], self.0[3], carry);
  314|       |
  315|   257k|        let (r3, carry) = mac(r3, self.0[1], self.0[2], 0);
  316|   257k|        let (r4, r5) = mac(r4, self.0[1], self.0[3], carry);
  317|       |
