   26|       |
   27|  7.50k|    let mut v = F::S;
   28|  7.50k|    let mut x = w * f;
   29|  7.50k|    let mut b = x * w;
   30|       |
   31|       |    // Initialize z as the 2^S root of unity.
   32|  7.50k|    let mut z = F::ROOT_OF_UNITY;
   33|       |
   34|   240k|    for max_v in (1..=F::S).rev() {
   35|   240k|        let mut k = 1;
   36|   240k|        let mut b2k = b.square();
   37|   240k|        let mut j_less_than_v: Choice = 1.into();
   38|       |
