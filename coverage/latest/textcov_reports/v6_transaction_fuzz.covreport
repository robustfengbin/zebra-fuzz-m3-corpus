 2422|    111|const fn cycle_to_yo(cycle: u32) -> (u32, u32) {
 2423|    111|    let mut year_mod_400 = cycle / 365;
 2424|    111|    let mut ordinal0 = cycle % 365;
 2425|    111|    let delta = YEAR_DELTAS[year_mod_400 as usize] as u32;
 2426|    111|    if ordinal0 < delta {
 2427|     17|        year_mod_400 -= 1;
 2428|     17|        ordinal0 += 365 - YEAR_DELTAS[year_mod_400 as usize] as u32;
 2429|     94|    } else {
 2430|     94|        ordinal0 -= delta;
 2431|     94|    }
 2432|    111|    (year_mod_400, ordinal0 + 1)
 2433|    111|}

