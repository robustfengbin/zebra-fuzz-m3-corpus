  414|    194|        s[ 1] =  (limbs[0] >>  8)                    as u8;
  415|    194|        s[ 2] =  (limbs[0] >> 16)                    as u8;
  416|    194|        s[ 3] =  (limbs[0] >> 24)                    as u8;
  417|    194|        s[ 4] =  (limbs[0] >> 32)                    as u8;
