  354|  47.7k|        let r4 = (r4 << 1) | (r3 >> 63);
  355|  47.7k|        let r3 = (r3 << 1) | (r2 >> 63);
  356|  47.7k|        let r2 = (r2 << 1) | (r1 >> 63);
  357|  47.7k|        let r1 = r1 << 1;
