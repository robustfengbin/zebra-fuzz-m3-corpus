  200|    942|    fn sqrt_common(&self, uv: &F, v: &F) -> F {
  201|    942|        let sqr = |x: F, i: u32| (0..i).fold(x, |x, _| x.square());
  202|    942|        let inv = |x: F| self.inv[self.hasher.hash(&x)] as usize;
  203|       |
  204|    942|        let x3 = *uv * v;
  205|    942|        let x2 = sqr(x3, 8);
  206|    942|        let x1 = sqr(x2, 8);
  207|    942|        let x0 = sqr(x1, 8);
  208|       |
  209|       |        // i = 0, 1
  210|    942|        let mut t_ = inv(x0); // = t >> 16
  211|       |                              // 1 == x0 * ROOT_OF_UNITY^(t_ << 24)
  212|    942|        assert!(t_ < 0x100);
  213|    942|        let alpha = x1 * self.g2[t_];
  214|       |
  215|       |        // i = 2
  216|    942|        t_ += inv(alpha) << 8; // = t >> 8
  217|       |                               // 1 == x1 * ROOT_OF_UNITY^(t_ << 16)
  218|    942|        assert!(t_ < 0x10000);
  219|    942|        let alpha = x2 * self.g1[t_ & 0xFF] * self.g2[t_ >> 8];
  220|       |
  221|       |        // i = 3
  222|    942|        t_ += inv(alpha) << 16; // = t
  223|       |                                // 1 == x2 * ROOT_OF_UNITY^(t_ << 8)
  224|    942|        assert!(t_ < 0x1000000);
  225|    942|        let alpha = x3 * self.g0[t_ & 0xFF] * self.g1[(t_ >> 8) & 0xFF] * self.g2[t_ >> 16];
  226|       |
  227|    942|        t_ += inv(alpha) << 24; // = t << 1
  228|       |                                // 1 == x3 * ROOT_OF_UNITY^t_
  229|    942|        t_ = (((t_ as u64) + 1) >> 1) as usize;
  230|    942|        assert!(t_ <= 0x80000000);
  231|       |
  232|    942|        *uv * self.g0[t_ & 0xFF]
  233|    942|            * self.g1[(t_ >> 8) & 0xFF]
  234|    942|            * self.g2[(t_ >> 16) & 0xFF]
  235|    942|            * self.g3[t_ >> 24]
  236|    942|    }
