  137|    156|        }
  138|    156|        if ordinal == 0 || ordinal > 366 {
  139|      0|            return None; // Invalid
  140|    156|        }
  141|    156|        debug_assert!(YearFlags::from_year(year).0 == flags.0);
  142|    156|        let yof = (year << 13) | (ordinal << 4) as i32 | flags.0 as i32;
  143|    156|        match yof & OL_MASK <= MAX_OL {
