  372|   465k|        let (r3, carry) = mac(r3, k, MODULUS.0[1], carry);
  373|   465k|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  374|   465k|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
  375|   465k|        let (r6, carry2) = adc(r6, carry2, carry);
  376|       |
