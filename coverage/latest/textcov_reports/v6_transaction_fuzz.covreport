 1454|    133|    pub(crate) const fn num_days_from_ce(&self) -> i32 {
 1455|       |        // we know this wouldn't overflow since year is limited to 1/2^13 of i32's full range.
 1456|    133|        let mut year = self.year() - 1;
 1457|    133|        let mut ndays = 0;
