  676|       |                            CtOption::new(
  677|       |                                $name_affine {
  678|       |                                    x,
  679|       |                                    y,
  680|       |                                },
  681|       |                                Choice::from(1u8),
  682|       |                            )
  683|       |                        })
  684|       |                    })
  685|       |                })
  686|    957|            }
