 2422|    183|const fn cycle_to_yo(cycle: u32) -> (u32, u32) {
 2423|    183|    let mut year_mod_400 = cycle / 365;
 2424|    183|    let mut ordinal0 = cycle % 365;
 2425|    183|    let delta = YEAR_DELTAS[year_mod_400 as usize] as u32;
 2426|    183|    if ordinal0 < delta {
 2427|     21|        year_mod_400 -= 1;
 2428|     21|        ordinal0 += 365 - YEAR_DELTAS[year_mod_400 as usize] as u32;
 2429|    162|    } else {
 2430|    162|        ordinal0 -= delta;
 2431|    162|    }
 2432|    183|    (year_mod_400, ordinal0 + 1)
