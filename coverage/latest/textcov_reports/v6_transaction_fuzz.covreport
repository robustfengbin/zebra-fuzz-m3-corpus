  403|     44|        Transaction::read_amount(&mut reader)?
  404|       |    } else {
  405|    390|        ZatBalance::zero()
  406|       |    };
  407|       |
  408|    434|    let anchor = if n_spends > 0 {
  409|     28|        Some(read_base(&mut reader, "anchor")?)
  410|       |    } else {
  411|    406|        None
  412|       |    };
  413|       |
  414|    434|    let v_spend_proofs = Array::read(&mut reader, n_spends, |r| read_zkproof(r))?;
  415|    434|    let v_spend_auth_sigs = Array::read(&mut reader, n_spends, |r| read_spend_auth_sig(r))?;
  416|    434|    let v_output_proofs = Array::read(&mut reader, n_outputs, |r| read_zkproof(r))?;
  417|       |
  418|    434|    let binding_sig = if n_spends > 0 || n_outputs > 0 {
  419|     44|        let mut sig = [0; 64];
