  401|     84|        limbs[2] += limbs[1] >> 51;
  402|     84|        limbs[1] &= low_51_bit_mask;
  403|     84|        limbs[3] += limbs[2] >> 51;
  404|     84|        limbs[2] &= low_51_bit_mask;
  405|     84|        limbs[4] += limbs[3] >> 51;
