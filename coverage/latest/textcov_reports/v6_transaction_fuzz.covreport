  823|  20.4k|            v: vv_plus_uu,
  824|  20.4k|            z: vv_minus_uu,
  825|  20.4k|            t: zz2 - vv_minus_uu,
  826|  20.4k|        }
  827|  20.4k|        .into_extended()
  828|  20.4k|    }
