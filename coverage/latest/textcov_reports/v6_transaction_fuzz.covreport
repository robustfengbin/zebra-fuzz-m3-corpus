 2422|    166|const fn cycle_to_yo(cycle: u32) -> (u32, u32) {
 2423|    166|    let mut year_mod_400 = cycle / 365;
 2424|    166|    let mut ordinal0 = cycle % 365;
 2425|    166|    let delta = YEAR_DELTAS[year_mod_400 as usize] as u32;
 2426|    166|    if ordinal0 < delta {
 2427|     21|        year_mod_400 -= 1;
 2428|     21|        ordinal0 += 365 - YEAR_DELTAS[year_mod_400 as usize] as u32;
 2429|    145|    } else {
 2430|    145|        ordinal0 -= delta;
 2431|    145|    }
 2432|    166|    (year_mod_400, ordinal0 + 1)
 2433|    166|}

