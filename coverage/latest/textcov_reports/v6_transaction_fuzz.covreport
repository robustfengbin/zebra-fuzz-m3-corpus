  623|       |        // zero if `self` was zero, and `u64::max_value()` if self was nonzero.
  624|  7.99k|        let mask = (((self.0[0] | self.0[1] | self.0[2] | self.0[3]) == 0) as u64).wrapping_sub(1);
  625|       |
  626|  7.99k|        Scalar([d0 & mask, d1 & mask, d2 & mask, d3 & mask])
  627|  7.99k|    }
