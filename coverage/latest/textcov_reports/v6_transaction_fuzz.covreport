  342|   285k|    const fn montgomery_reduce(
  343|   285k|        r0: u64,
  344|   285k|        r1: u64,
  345|   285k|        r2: u64,
  346|   285k|        r3: u64,
  347|   285k|        r4: u64,
  348|   285k|        r5: u64,
  349|   285k|        r6: u64,
  350|   285k|        r7: u64,
  351|   285k|    ) -> Self {
  352|       |        // The Montgomery reduction here is based on Algorithm 14.32 in
  353|       |        // Handbook of Applied Cryptography
  354|       |        // <http://cacr.uwaterloo.ca/hac/about/chap14.pdf>.
  355|       |
  356|   285k|        let k = r0.wrapping_mul(INV);
  357|   285k|        let (_, carry) = mac(r0, k, MODULUS.0[0], 0);
  358|   285k|        let (r1, carry) = mac(r1, k, MODULUS.0[1], carry);
  359|   285k|        let (r2, carry) = mac(r2, k, MODULUS.0[2], carry);
  360|   285k|        let (r3, carry) = mac(r3, k, MODULUS.0[3], carry);
  361|   285k|        let (r4, carry2) = adc(r4, 0, carry);
  362|       |
  363|   285k|        let k = r1.wrapping_mul(INV);
  364|   285k|        let (_, carry) = mac(r1, k, MODULUS.0[0], 0);
  365|   285k|        let (r2, carry) = mac(r2, k, MODULUS.0[1], carry);
  366|   285k|        let (r3, carry) = mac(r3, k, MODULUS.0[2], carry);
  367|   285k|        let (r4, carry) = mac(r4, k, MODULUS.0[3], carry);
  368|   285k|        let (r5, carry2) = adc(r5, carry2, carry);
  369|       |
  370|   285k|        let k = r2.wrapping_mul(INV);
  371|   285k|        let (_, carry) = mac(r2, k, MODULUS.0[0], 0);
  372|   285k|        let (r3, carry) = mac(r3, k, MODULUS.0[1], carry);
  373|   285k|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  374|   285k|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
  375|   285k|        let (r6, carry2) = adc(r6, carry2, carry);
  376|       |
  377|   285k|        let k = r3.wrapping_mul(INV);
  378|   285k|        let (_, carry) = mac(r3, k, MODULUS.0[0], 0);
  379|   285k|        let (r4, carry) = mac(r4, k, MODULUS.0[1], carry);
  380|   285k|        let (r5, carry) = mac(r5, k, MODULUS.0[2], carry);
  381|   285k|        let (r6, carry) = mac(r6, k, MODULUS.0[3], carry);
  382|   285k|        let (r7, _) = adc(r7, carry2, carry);
  383|       |
  384|       |        // Result may be within MODULUS of the correct value
  385|   285k|        (&Fp([r4, r5, r6, r7])).sub(&MODULUS)
  386|   285k|    }
