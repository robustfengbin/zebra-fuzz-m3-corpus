  143|    122|    fn zcash_serialize<W: io::Write>(&self, mut writer: W) -> Result<(), io::Error> {
  144|    122|        self.vpub_old.zcash_serialize(&mut writer)?;
  145|    122|        self.vpub_new.zcash_serialize(&mut writer)?;
  146|       |
  147|    122|        writer.write_32_bytes(&self.anchor.into())?;
  148|    122|        writer.write_32_bytes(&self.nullifiers[0].into())?;
  149|    122|        writer.write_32_bytes(&self.nullifiers[1].into())?;
