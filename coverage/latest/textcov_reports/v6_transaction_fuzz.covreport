  420|     96|        s[ 7] =  (limbs[1] >>  5)                    as u8;
  421|     96|        s[ 8] =  (limbs[1] >> 13)                    as u8;
  422|     96|        s[ 9] =  (limbs[1] >> 21)                    as u8;
  423|     96|        s[10] =  (limbs[1] >> 29)                    as u8;
  424|     96|        s[11] =  (limbs[1] >> 37)                    as u8;
  425|     96|        s[12] = ((limbs[1] >> 45) | (limbs[2] << 6)) as u8;
  426|     96|        s[13] =  (limbs[2] >>  2)                    as u8;
  427|     96|        s[14] =  (limbs[2] >> 10)                    as u8;
  428|     96|        s[15] =  (limbs[2] >> 18)                    as u8;
