  362|  44.6k|        let (r3, carry) = adc(0, r3, carry);
  363|  44.6k|        let (r4, carry) = mac(r4, self.0[2], self.0[2], carry);
  364|  44.6k|        let (r5, carry) = adc(0, r5, carry);
