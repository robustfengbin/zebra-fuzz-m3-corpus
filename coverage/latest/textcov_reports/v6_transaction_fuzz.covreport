  360|  56.5k|        let (r1, carry) = adc(0, r1, carry);
  361|  56.5k|        let (r2, carry) = mac(r2, self.0[1], self.0[1], carry);
  362|  56.5k|        let (r3, carry) = adc(0, r3, carry);
  363|  56.5k|        let (r4, carry) = mac(r4, self.0[2], self.0[2], carry);
  364|  56.5k|        let (r5, carry) = adc(0, r5, carry);
  365|  56.5k|        let (r6, carry) = mac(r6, self.0[3], self.0[3], carry);
  366|  56.5k|        let (r7, _) = adc(0, r7, carry);
