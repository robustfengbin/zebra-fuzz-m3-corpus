  137|    137|        }
  138|    137|        if ordinal == 0 || ordinal > 366 {
  139|      0|            return None; // Invalid
  140|    137|        }
  141|    137|        debug_assert!(YearFlags::from_year(year).0 == flags.0);
  142|    137|        let yof = (year << 13) | (ordinal << 4) as i32 | flags.0 as i32;
  143|    137|        match yof & OL_MASK <= MAX_OL {
  144|    137|            true => Some(NaiveDate::from_yof(yof)),
  145|      0|            false => None, // Does not exist: Ordinal 366 in a common year.
  146|       |        }
  147|    137|    }
