 1454|    113|    pub(crate) const fn num_days_from_ce(&self) -> i32 {
 1455|       |        // we know this wouldn't overflow since year is limited to 1/2^13 of i32's full range.
 1456|    113|        let mut year = self.year() - 1;
 1457|    113|        let mut ndays = 0;
 1458|    113|        if year < 0 {
 1459|      0|            let excess = 1 + (-year) / 400;
 1460|      0|            year += excess * 400;
 1461|      0|            ndays -= excess * 146_097;
 1462|    113|        }
 1463|    113|        let div_100 = year / 100;
 1464|    113|        ndays += ((year * 1461) >> 2) - div_100 + (div_100 >> 2);
 1465|    113|        ndays + self.ordinal() as i32
 1466|    113|    }
_RNvMNtNtCs8jXVBPYSQuE_6chrono5naive4dateNtB2_9NaiveDate22from_ordinal_and_flags:
  130|    156|    const fn from_ordinal_and_flags(
  131|    156|        year: i32,
  132|    156|        ordinal: u32,
  133|    156|        flags: YearFlags,
  134|    156|    ) -> Option<NaiveDate> {
  135|    156|        if year < MIN_YEAR || year > MAX_YEAR {
