 2422|    132|const fn cycle_to_yo(cycle: u32) -> (u32, u32) {
 2423|    132|    let mut year_mod_400 = cycle / 365;
 2424|    132|    let mut ordinal0 = cycle % 365;
 2425|    132|    let delta = YEAR_DELTAS[year_mod_400 as usize] as u32;
 2426|    132|    if ordinal0 < delta {
 2427|     15|        year_mod_400 -= 1;
 2428|     15|        ordinal0 += 365 - YEAR_DELTAS[year_mod_400 as usize] as u32;
 2429|    117|    } else {
 2430|    117|        ordinal0 -= delta;
 2431|    117|    }
 2432|    132|    (year_mod_400, ordinal0 + 1)
 2433|    132|}

