  439|    122|        s[26] =  (limbs[4] >>  4)                    as u8;
  440|    122|        s[27] =  (limbs[4] >> 12)                    as u8;
  441|    122|        s[28] =  (limbs[4] >> 20)                    as u8;
  442|    122|        s[29] =  (limbs[4] >> 28)                    as u8;
  443|    122|        s[30] =  (limbs[4] >> 36)                    as u8;
  444|    122|        s[31] =  (limbs[4] >> 44)                    as u8;
  445|       |
  446|       |        // High bit should be zero.
  447|    122|        debug_assert!((s[31] & 0b1000_0000u8) == 0u8);
