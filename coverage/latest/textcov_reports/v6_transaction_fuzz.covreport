  323|   257k|        let r4 = (r4 << 1) | (r3 >> 63);
  324|   257k|        let r3 = (r3 << 1) | (r2 >> 63);
  325|   257k|        let r2 = (r2 << 1) | (r1 >> 63);
  326|   257k|        let r1 = r1 << 1;
