   50|  3.56M|            z = F::conditional_select(&z, &new_z, j_less_than_v);
   51|  3.56M|        }
   52|       |
   53|   245k|        let result = x * z;
   54|   245k|        x = F::conditional_select(&result, &x, b.ct_eq(&F::ONE));
