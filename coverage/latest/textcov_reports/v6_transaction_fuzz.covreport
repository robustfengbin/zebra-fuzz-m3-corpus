  364|  7.19M|        let (r5, carry) = adc(0, r5, carry);
  365|  7.19M|        let (r6, carry) = mac(r6, self.0[3], self.0[3], carry);
  366|  7.19M|        let (r7, _) = adc(0, r7, carry);
  367|       |
  368|  7.19M|        Scalar::montgomery_reduce(r0, r1, r2, r3, r4, r5, r6, r7)
