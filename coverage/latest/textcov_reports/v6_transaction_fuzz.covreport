  418|   314k|    pub const fn sub(&self, rhs: &Self) -> Self {
  419|   314k|        let (d0, borrow) = sbb(self.0[0], rhs.0[0], 0);
  420|   314k|        let (d1, borrow) = sbb(self.0[1], rhs.0[1], borrow);
  421|   314k|        let (d2, borrow) = sbb(self.0[2], rhs.0[2], borrow);
