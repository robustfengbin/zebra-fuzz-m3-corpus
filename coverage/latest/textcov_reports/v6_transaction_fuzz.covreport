   45|  3.56M|            let squared = F::conditional_select(&b2k, &z, b2k_is_one).square();
   46|  3.56M|            b2k = F::conditional_select(&squared, &b2k, b2k_is_one);
   47|  3.56M|            let new_z = F::conditional_select(&z, &squared, b2k_is_one);
   48|  3.56M|            j_less_than_v &= !j.ct_eq(&v);
