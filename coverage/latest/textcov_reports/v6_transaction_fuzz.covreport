  378|    219|    pub const fn from_num_days_from_ce_opt(days: i32) -> Option<NaiveDate> {
  379|    219|        let days = try_opt!(days.checked_add(365)); // make December 31, 1 BCE equal to day 0
  380|    219|        let year_div_400 = days.div_euclid(146_097);
  381|    219|        let cycle = days.rem_euclid(146_097);
  382|    219|        let (year_mod_400, ordinal) = cycle_to_yo(cycle as u32);
  383|    219|        let flags = YearFlags::from_year_mod_400(year_mod_400 as i32);
