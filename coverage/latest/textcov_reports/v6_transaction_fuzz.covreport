  421|     44|        Some(redjubjub::Signature::from(sig))
  422|       |    } else {
  423|    390|        None
  424|       |    };
  425|       |
  426|    434|    let shielded_spends = sd_v5s
  427|    434|        .into_iter()
  428|    434|        .zip(v_spend_proofs.into_iter().zip(v_spend_auth_sigs))
  429|    434|        .map(|(sd_5, (zkproof, spend_auth_sig))| {
  430|       |            // the following `unwrap` is safe because we know n_spends > 0.
  431|       |            sd_5.into_spend_description(anchor.unwrap(), zkproof, spend_auth_sig)
  432|       |        })
  433|    434|        .collect();
  434|       |
  435|    434|    let shielded_outputs = od_v5s
  436|    434|        .into_iter()
  437|    434|        .zip(v_output_proofs)
  438|    434|        .map(|(od_5, zkproof)| od_5.into_output_description(zkproof))
  439|    434|        .collect();
  440|       |
  441|    434|    Ok(binding_sig.and_then(|binding_sig| {
  442|       |        Bundle::from_parts(
  443|       |            shielded_spends,
  444|       |            shielded_outputs,
  445|       |            value_balance,
  446|       |            Authorized { binding_sig },
  447|       |        )
  448|       |    }))
  449|    434|}
