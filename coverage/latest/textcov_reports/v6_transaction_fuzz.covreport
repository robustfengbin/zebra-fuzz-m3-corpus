  395|    434|pub(crate) fn read_v5_bundle<R: Read>(
  396|    434|    mut reader: R,
  397|    434|) -> io::Result<Option<Bundle<Authorized, ZatBalance>>> {
  398|    434|    let sd_v5s = Vector::read(&mut reader, read_spend_v5)?;
  399|    434|    let od_v5s = Vector::read(&mut reader, read_output_v5)?;
  400|    434|    let n_spends = sd_v5s.len();
  401|    434|    let n_outputs = od_v5s.len();
