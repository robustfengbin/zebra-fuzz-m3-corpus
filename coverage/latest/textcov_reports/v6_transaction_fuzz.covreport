  354|  41.9k|        let r4 = (r4 << 1) | (r3 >> 63);
  355|  41.9k|        let r3 = (r3 << 1) | (r2 >> 63);
  356|  41.9k|        let r2 = (r2 << 1) | (r1 >> 63);
  357|  41.9k|        let r1 = r1 << 1;
  358|       |
  359|  41.9k|        let (r0, carry) = mac(0, self.0[0], self.0[0], 0);
  360|  41.9k|        let (r1, carry) = adc(0, r1, carry);
  361|  41.9k|        let (r2, carry) = mac(r2, self.0[1], self.0[1], carry);
  362|  41.9k|        let (r3, carry) = adc(0, r3, carry);
  363|  41.9k|        let (r4, carry) = mac(r4, self.0[2], self.0[2], carry);
  364|  41.9k|        let (r5, carry) = adc(0, r5, carry);
  365|  41.9k|        let (r6, carry) = mac(r6, self.0[3], self.0[3], carry);
  366|  41.9k|        let (r7, _) = adc(0, r7, carry);
  367|       |
