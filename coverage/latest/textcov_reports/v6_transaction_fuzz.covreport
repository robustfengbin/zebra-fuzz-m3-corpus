  875|       |            // Denoted as `header` in the spec, contains the `fOverwintered` flag and the `version` field.
  876|    368|            let header = limited_reader.read_u32::<LittleEndian>()?;
  877|    368|            (header & LOW_31_BITS, header >> 31 != 0)
  878|       |        };
