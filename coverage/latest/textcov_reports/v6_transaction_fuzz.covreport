  454|    953|        let (d1, borrow) = sbb(MODULUS.0[1], self.0[1], borrow);
  455|    953|        let (d2, borrow) = sbb(MODULUS.0[2], self.0[2], borrow);
  456|    953|        let (d3, _) = sbb(MODULUS.0[3], self.0[3], borrow);
  457|       |
