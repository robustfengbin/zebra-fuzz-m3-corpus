   65|       |        //
   66|       |        // > LEOS2IP_{256}(cmx) MUST be less than 𝑞_ℙ.
   67|       |        //
   68|       |        // https://zips.z.cash/protocol/protocol.pdf#actionencodingandconsensus
   69|       |        //
