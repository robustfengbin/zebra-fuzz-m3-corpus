  364|   465k|        let (_, carry) = mac(r1, k, MODULUS.0[0], 0);
  365|   465k|        let (r2, carry) = mac(r2, k, MODULUS.0[1], carry);
  366|   465k|        let (r3, carry) = mac(r3, k, MODULUS.0[2], carry);
  367|   465k|        let (r4, carry) = mac(r4, k, MODULUS.0[3], carry);
  368|   465k|        let (r5, carry2) = adc(r5, carry2, carry);
  369|       |
