 2422|    133|const fn cycle_to_yo(cycle: u32) -> (u32, u32) {
 2423|    133|    let mut year_mod_400 = cycle / 365;
 2424|    133|    let mut ordinal0 = cycle % 365;
 2425|    133|    let delta = YEAR_DELTAS[year_mod_400 as usize] as u32;
 2426|    133|    if ordinal0 < delta {
 2427|     17|        year_mod_400 -= 1;
 2428|     17|        ordinal0 += 365 - YEAR_DELTAS[year_mod_400 as usize] as u32;
 2429|    116|    } else {
 2430|    116|        ordinal0 -= delta;
 2431|    116|    }
 2432|    133|    (year_mod_400, ordinal0 + 1)
 2433|    133|}

