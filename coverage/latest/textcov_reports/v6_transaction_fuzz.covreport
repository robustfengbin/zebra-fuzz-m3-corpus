  873|    444|        let (version, overwintered) = {
  874|       |            const LOW_31_BITS: u32 = (1 << 31) - 1;
  875|       |            // Denoted as `header` in the spec, contains the `fOverwintered` flag and the `version` field.
  876|    444|            let header = limited_reader.read_u32::<LittleEndian>()?;
  877|    444|            (header & LOW_31_BITS, header >> 31 != 0)
