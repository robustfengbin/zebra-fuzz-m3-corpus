  341|  7.19M|    pub const fn square(&self) -> Scalar {
  342|  7.19M|        let (r1, carry) = mac(0, self.0[0], self.0[1], 0);
  343|  7.19M|        let (r2, carry) = mac(0, self.0[0], self.0[2], carry);
