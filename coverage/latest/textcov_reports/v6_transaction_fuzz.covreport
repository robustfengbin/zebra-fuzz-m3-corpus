  342|   270k|    const fn montgomery_reduce(
  343|   270k|        r0: u64,
  344|   270k|        r1: u64,
  345|   270k|        r2: u64,
  346|   270k|        r3: u64,
  347|   270k|        r4: u64,
  348|   270k|        r5: u64,
  349|   270k|        r6: u64,
  350|   270k|        r7: u64,
  351|   270k|    ) -> Self {
  352|       |        // The Montgomery reduction here is based on Algorithm 14.32 in
  353|       |        // Handbook of Applied Cryptography
  354|       |        // <http://cacr.uwaterloo.ca/hac/about/chap14.pdf>.
  355|       |
  356|   270k|        let k = r0.wrapping_mul(INV);
  357|   270k|        let (_, carry) = mac(r0, k, MODULUS.0[0], 0);
  358|   270k|        let (r1, carry) = mac(r1, k, MODULUS.0[1], carry);
  359|   270k|        let (r2, carry) = mac(r2, k, MODULUS.0[2], carry);
  360|   270k|        let (r3, carry) = mac(r3, k, MODULUS.0[3], carry);
  361|   270k|        let (r4, carry2) = adc(r4, 0, carry);
  362|       |
  363|   270k|        let k = r1.wrapping_mul(INV);
  364|   270k|        let (_, carry) = mac(r1, k, MODULUS.0[0], 0);
  365|   270k|        let (r2, carry) = mac(r2, k, MODULUS.0[1], carry);
  366|   270k|        let (r3, carry) = mac(r3, k, MODULUS.0[2], carry);
  367|   270k|        let (r4, carry) = mac(r4, k, MODULUS.0[3], carry);
  368|   270k|        let (r5, carry2) = adc(r5, carry2, carry);
  369|       |
  370|   270k|        let k = r2.wrapping_mul(INV);
  371|   270k|        let (_, carry) = mac(r2, k, MODULUS.0[0], 0);
  372|   270k|        let (r3, carry) = mac(r3, k, MODULUS.0[1], carry);
  373|   270k|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  374|   270k|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
  375|   270k|        let (r6, carry2) = adc(r6, carry2, carry);
  376|       |
  377|   270k|        let k = r3.wrapping_mul(INV);
  378|   270k|        let (_, carry) = mac(r3, k, MODULUS.0[0], 0);
  379|   270k|        let (r4, carry) = mac(r4, k, MODULUS.0[1], carry);
  380|   270k|        let (r5, carry) = mac(r5, k, MODULUS.0[2], carry);
  381|   270k|        let (r6, carry) = mac(r6, k, MODULUS.0[3], carry);
  382|   270k|        let (r7, _) = adc(r7, carry2, carry);
  383|       |
  384|       |        // Result may be within MODULUS of the correct value
  385|   270k|        (&Fp([r4, r5, r6, r7])).sub(&MODULUS)
  386|   270k|    }
