  419|    194|        s[ 6] = ((limbs[0] >> 48) | (limbs[1] << 3)) as u8;
  420|    194|        s[ 7] =  (limbs[1] >>  5)                    as u8;
  421|    194|        s[ 8] =  (limbs[1] >> 13)                    as u8;
  422|    194|        s[ 9] =  (limbs[1] >> 21)                    as u8;
  423|    194|        s[10] =  (limbs[1] >> 29)                    as u8;
  424|    194|        s[11] =  (limbs[1] >> 37)                    as u8;
  425|    194|        s[12] = ((limbs[1] >> 45) | (limbs[2] << 6)) as u8;
  426|    194|        s[13] =  (limbs[2] >>  2)                    as u8;
  427|    194|        s[14] =  (limbs[2] >> 10)                    as u8;
  428|    194|        s[15] =  (limbs[2] >> 18)                    as u8;
  429|    194|        s[16] =  (limbs[2] >> 26)                    as u8;
