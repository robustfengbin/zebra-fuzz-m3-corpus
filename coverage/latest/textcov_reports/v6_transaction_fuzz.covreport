   91|      0|                _ => Err(io::Error::new(
   92|      0|                    io::ErrorKind::InvalidData,
   93|      0|                    "Unknown transaction format",
   94|      0|                )),
   95|       |            }
   96|      0|        } else if version >= 1 {
   97|      0|            Ok(TxVersion::Sprout(version))
   98|       |        } else {
