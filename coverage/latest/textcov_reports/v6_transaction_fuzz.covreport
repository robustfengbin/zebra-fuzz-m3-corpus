  451|       |                    .expect("empty Orchard bundle txid commitment is valid for its tx format")
  452|       |            })
  453|    372|            .as_bytes(),
  454|       |    )
  455|    372|    .unwrap();
  456|    372|    h.write_all(
  457|    372|        ironwood_digest
