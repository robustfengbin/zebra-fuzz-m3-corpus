  378|   465k|        let (_, carry) = mac(r3, k, MODULUS.0[0], 0);
  379|   465k|        let (r4, carry) = mac(r4, k, MODULUS.0[1], carry);
  380|   465k|        let (r5, carry) = mac(r5, k, MODULUS.0[2], carry);
