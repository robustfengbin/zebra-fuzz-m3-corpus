   80|    434|    pub fn read<R: Read>(mut reader: R) -> io::Result<Self> {
   81|    434|        let header = reader.read_u32_le()?;
   82|    434|        let overwintered = (header >> 31) == 1;
   83|    434|        let version = header & 0x7FFFFFFF;
   84|       |
