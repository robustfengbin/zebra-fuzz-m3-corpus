  353|  7.16M|        let r5 = (r5 << 1) | (r4 >> 63);
  354|  7.16M|        let r4 = (r4 << 1) | (r3 >> 63);
  355|  7.16M|        let r3 = (r3 << 1) | (r2 >> 63);
  356|  7.16M|        let r2 = (r2 << 1) | (r1 >> 63);
  357|  7.16M|        let r1 = r1 << 1;
