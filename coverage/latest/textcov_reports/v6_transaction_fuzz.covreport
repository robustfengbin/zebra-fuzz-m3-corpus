 1490|    132|    const fn from_yof(yof: i32) -> NaiveDate {
 1491|       |        // The following are the invariants our ordinal and flags should uphold for a valid
 1492|       |        // `NaiveDate`.
 1493|    132|        debug_assert!(((yof & OL_MASK) >> 3) > 1);
