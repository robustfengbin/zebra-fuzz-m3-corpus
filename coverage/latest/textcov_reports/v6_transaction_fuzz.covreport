  435|     66|        s[22] =  (limbs[3] >> 23)                    as u8;
  436|     66|        s[23] =  (limbs[3] >> 31)                    as u8;
  437|     66|        s[24] =  (limbs[3] >> 39)                    as u8;
  438|     66|        s[25] = ((limbs[3] >> 47) | (limbs[4] << 4)) as u8;
  439|     66|        s[26] =  (limbs[4] >>  4)                    as u8;
  440|     66|        s[27] =  (limbs[4] >> 12)                    as u8;
  441|     66|        s[28] =  (limbs[4] >> 20)                    as u8;
  442|     66|        s[29] =  (limbs[4] >> 28)                    as u8;
  443|     66|        s[30] =  (limbs[4] >> 36)                    as u8;
  444|     66|        s[31] =  (limbs[4] >> 44)                    as u8;
  445|       |
  446|       |        // High bit should be zero.
  447|     66|        debug_assert!((s[31] & 0b1000_0000u8) == 0u8);
