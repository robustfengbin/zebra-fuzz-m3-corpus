   84|       |                    Some(res)
   85|       |                })
   86|       |                .collect();
   87|       |            *gi = gtab_i[255] * *gi;
   88|       |            Some(gtab_i)
   89|       |        });
   90|      1|        let gtab_0 = gtab.next().unwrap();
