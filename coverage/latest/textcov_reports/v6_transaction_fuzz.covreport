  400|     72|        limbs[0] &= low_51_bit_mask;
  401|     72|        limbs[2] += limbs[1] >> 51;
  402|     72|        limbs[1] &= low_51_bit_mask;
  403|     72|        limbs[3] += limbs[2] >> 51;
  404|     72|        limbs[2] &= low_51_bit_mask;
  405|     72|        limbs[4] += limbs[3] >> 51;
