  454|    858|        let (d1, borrow) = sbb(MODULUS.0[1], self.0[1], borrow);
  455|    858|        let (d2, borrow) = sbb(MODULUS.0[2], self.0[2], borrow);
  456|    858|        let (d3, _) = sbb(MODULUS.0[3], self.0[3], borrow);
  457|       |
  458|       |        // `tmp` could be `MODULUS` if `self` was zero. Create a mask that is
  459|       |        // zero if `self` was zero, and `u64::max_value()` if self was nonzero.
  460|    858|        let mask = (((self.0[0] | self.0[1] | self.0[2] | self.0[3]) == 0) as u64).wrapping_sub(1);
  461|       |
  462|    858|        Fp([d0 & mask, d1 & mask, d2 & mask, d3 & mask])
  463|    858|    }
