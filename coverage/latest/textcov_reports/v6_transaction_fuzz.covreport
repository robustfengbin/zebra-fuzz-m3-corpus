 2422|    156|const fn cycle_to_yo(cycle: u32) -> (u32, u32) {
 2423|    156|    let mut year_mod_400 = cycle / 365;
 2424|    156|    let mut ordinal0 = cycle % 365;
 2425|    156|    let delta = YEAR_DELTAS[year_mod_400 as usize] as u32;
 2426|    156|    if ordinal0 < delta {
 2427|     23|        year_mod_400 -= 1;
 2428|     23|        ordinal0 += 365 - YEAR_DELTAS[year_mod_400 as usize] as u32;
 2429|    133|    } else {
 2430|    133|        ordinal0 -= delta;
 2431|    133|    }
 2432|    156|    (year_mod_400, ordinal0 + 1)
 2433|    156|}

