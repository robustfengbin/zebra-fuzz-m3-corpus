  421|     72|        s[ 8] =  (limbs[1] >> 13)                    as u8;
  422|     72|        s[ 9] =  (limbs[1] >> 21)                    as u8;
  423|     72|        s[10] =  (limbs[1] >> 29)                    as u8;
  424|     72|        s[11] =  (limbs[1] >> 37)                    as u8;
  425|     72|        s[12] = ((limbs[1] >> 45) | (limbs[2] << 6)) as u8;
  426|     72|        s[13] =  (limbs[2] >>  2)                    as u8;
  427|     72|        s[14] =  (limbs[2] >> 10)                    as u8;
  428|     72|        s[15] =  (limbs[2] >> 18)                    as u8;
