  823|  7.06k|            v: vv_plus_uu,
  824|  7.06k|            z: vv_minus_uu,
  825|  7.06k|            t: zz2 - vv_minus_uu,
  826|  7.06k|        }
  827|  7.06k|        .into_extended()
  828|  7.06k|    }
