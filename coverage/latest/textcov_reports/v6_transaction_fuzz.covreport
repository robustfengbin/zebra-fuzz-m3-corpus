  411|    416|        None
  412|       |    };
  413|       |
  414|    441|    let v_spend_proofs = Array::read(&mut reader, n_spends, |r| read_zkproof(r))?;
  415|    441|    let v_spend_auth_sigs = Array::read(&mut reader, n_spends, |r| read_spend_auth_sig(r))?;
