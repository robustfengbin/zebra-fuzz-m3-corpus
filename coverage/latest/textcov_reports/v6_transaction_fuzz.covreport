  352|       |        // The Montgomery reduction here is based on Algorithm 14.32 in
  353|       |        // Handbook of Applied Cryptography
  354|       |        // <http://cacr.uwaterloo.ca/hac/about/chap14.pdf>.
  355|       |
  356|   292k|        let k = r0.wrapping_mul(INV);
  357|   292k|        let (_, carry) = mac(r0, k, MODULUS.0[0], 0);
  358|   292k|        let (r1, carry) = mac(r1, k, MODULUS.0[1], carry);
  359|   292k|        let (r2, carry) = mac(r2, k, MODULUS.0[2], carry);
  360|   292k|        let (r3, carry) = mac(r3, k, MODULUS.0[3], carry);
  361|   292k|        let (r4, carry2) = adc(r4, 0, carry);
  362|       |
  363|   292k|        let k = r1.wrapping_mul(INV);
  364|   292k|        let (_, carry) = mac(r1, k, MODULUS.0[0], 0);
  365|   292k|        let (r2, carry) = mac(r2, k, MODULUS.0[1], carry);
  366|   292k|        let (r3, carry) = mac(r3, k, MODULUS.0[2], carry);
  367|   292k|        let (r4, carry) = mac(r4, k, MODULUS.0[3], carry);
  368|   292k|        let (r5, carry2) = adc(r5, carry2, carry);
  369|       |
  370|   292k|        let k = r2.wrapping_mul(INV);
  371|   292k|        let (_, carry) = mac(r2, k, MODULUS.0[0], 0);
  372|   292k|        let (r3, carry) = mac(r3, k, MODULUS.0[1], carry);
  373|   292k|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  374|   292k|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
  375|   292k|        let (r6, carry2) = adc(r6, carry2, carry);
  376|       |
  377|   292k|        let k = r3.wrapping_mul(INV);
  378|   292k|        let (_, carry) = mac(r3, k, MODULUS.0[0], 0);
  379|   292k|        let (r4, carry) = mac(r4, k, MODULUS.0[1], carry);
  380|   292k|        let (r5, carry) = mac(r5, k, MODULUS.0[2], carry);
  381|   292k|        let (r6, carry) = mac(r6, k, MODULUS.0[3], carry);
