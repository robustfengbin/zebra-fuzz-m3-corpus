  342|   317k|    const fn montgomery_reduce(
  343|   317k|        r0: u64,
  344|   317k|        r1: u64,
  345|   317k|        r2: u64,
  346|   317k|        r3: u64,
  347|   317k|        r4: u64,
  348|   317k|        r5: u64,
  349|   317k|        r6: u64,
  350|   317k|        r7: u64,
  351|   317k|    ) -> Self {
  352|       |        // The Montgomery reduction here is based on Algorithm 14.32 in
  353|       |        // Handbook of Applied Cryptography
  354|       |        // <http://cacr.uwaterloo.ca/hac/about/chap14.pdf>.
  355|       |
  356|   317k|        let k = r0.wrapping_mul(INV);
  357|   317k|        let (_, carry) = mac(r0, k, MODULUS.0[0], 0);
  358|   317k|        let (r1, carry) = mac(r1, k, MODULUS.0[1], carry);
  359|   317k|        let (r2, carry) = mac(r2, k, MODULUS.0[2], carry);
  360|   317k|        let (r3, carry) = mac(r3, k, MODULUS.0[3], carry);
  361|   317k|        let (r4, carry2) = adc(r4, 0, carry);
  362|       |
  363|   317k|        let k = r1.wrapping_mul(INV);
  364|   317k|        let (_, carry) = mac(r1, k, MODULUS.0[0], 0);
  365|   317k|        let (r2, carry) = mac(r2, k, MODULUS.0[1], carry);
  366|   317k|        let (r3, carry) = mac(r3, k, MODULUS.0[2], carry);
  367|   317k|        let (r4, carry) = mac(r4, k, MODULUS.0[3], carry);
  368|   317k|        let (r5, carry2) = adc(r5, carry2, carry);
  369|       |
  370|   317k|        let k = r2.wrapping_mul(INV);
  371|   317k|        let (_, carry) = mac(r2, k, MODULUS.0[0], 0);
  372|   317k|        let (r3, carry) = mac(r3, k, MODULUS.0[1], carry);
  373|   317k|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  374|   317k|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
  375|   317k|        let (r6, carry2) = adc(r6, carry2, carry);
  376|       |
  377|   317k|        let k = r3.wrapping_mul(INV);
  378|   317k|        let (_, carry) = mac(r3, k, MODULUS.0[0], 0);
  379|   317k|        let (r4, carry) = mac(r4, k, MODULUS.0[1], carry);
  380|   317k|        let (r5, carry) = mac(r5, k, MODULUS.0[2], carry);
  381|   317k|        let (r6, carry) = mac(r6, k, MODULUS.0[3], carry);
  382|   317k|        let (r7, _) = adc(r7, carry2, carry);
  383|       |
  384|       |        // Result may be within MODULUS of the correct value
  385|   317k|        (&Fp([r4, r5, r6, r7])).sub(&MODULUS)
  386|   317k|    }
