_RNvNtNtCs8jXVBPYSQuE_6chrono5naive4date11cycle_to_yo:
 2422|    219|const fn cycle_to_yo(cycle: u32) -> (u32, u32) {
 2423|    219|    let mut year_mod_400 = cycle / 365;
 2424|    219|    let mut ordinal0 = cycle % 365;
 2425|    219|    let delta = YEAR_DELTAS[year_mod_400 as usize] as u32;
 2426|    219|    if ordinal0 < delta {
 2427|     23|        year_mod_400 -= 1;
 2428|     23|        ordinal0 += 365 - YEAR_DELTAS[year_mod_400 as usize] as u32;
 2429|    196|    } else {
 2430|    196|        ordinal0 -= delta;
 2431|    196|    }
 2432|    219|    (year_mod_400, ordinal0 + 1)
 2433|    219|}

