  310|   274k|    pub const fn square(&self) -> Fp {
  311|   274k|        let (r1, carry) = mac(0, self.0[0], self.0[1], 0);
  312|   274k|        let (r2, carry) = mac(0, self.0[0], self.0[2], carry);
  313|   274k|        let (r3, r4) = mac(0, self.0[0], self.0[3], carry);
