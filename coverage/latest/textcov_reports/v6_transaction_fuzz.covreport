 2422|    153|const fn cycle_to_yo(cycle: u32) -> (u32, u32) {
 2423|    153|    let mut year_mod_400 = cycle / 365;
 2424|    153|    let mut ordinal0 = cycle % 365;
 2425|    153|    let delta = YEAR_DELTAS[year_mod_400 as usize] as u32;
 2426|    153|    if ordinal0 < delta {
 2427|     17|        year_mod_400 -= 1;
 2428|     17|        ordinal0 += 365 - YEAR_DELTAS[year_mod_400 as usize] as u32;
 2429|    136|    } else {
 2430|    136|        ordinal0 -= delta;
 2431|    136|    }
 2432|    153|    (year_mod_400, ordinal0 + 1)
 2433|    153|}

