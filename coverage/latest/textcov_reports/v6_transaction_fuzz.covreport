  360|  44.4k|        let (r1, carry) = adc(0, r1, carry);
  361|  44.4k|        let (r2, carry) = mac(r2, self.0[1], self.0[1], carry);
  362|  44.4k|        let (r3, carry) = adc(0, r3, carry);
  363|  44.4k|        let (r4, carry) = mac(r4, self.0[2], self.0[2], carry);
  364|  44.4k|        let (r5, carry) = adc(0, r5, carry);
  365|  44.4k|        let (r6, carry) = mac(r6, self.0[3], self.0[3], carry);
  366|  44.4k|        let (r7, _) = adc(0, r7, carry);
