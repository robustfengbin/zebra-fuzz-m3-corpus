  205|       |            // See [`sapling_crypto::value::ValueCommitment::::zcash_deserialize`].
  206|       |            cv: commitment::ValueCommitment(
  207|      3|                sapling_crypto::value::ValueCommitment::zcash_deserialize(&mut reader)?,
