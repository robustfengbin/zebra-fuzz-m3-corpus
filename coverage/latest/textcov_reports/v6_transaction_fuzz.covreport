  311|   260k|        let (r1, carry) = mac(0, self.0[0], self.0[1], 0);
  312|   260k|        let (r2, carry) = mac(0, self.0[0], self.0[2], carry);
  313|   260k|        let (r3, r4) = mac(0, self.0[0], self.0[3], carry);
