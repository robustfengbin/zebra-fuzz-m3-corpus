 1454|    102|    pub(crate) const fn num_days_from_ce(&self) -> i32 {
 1455|       |        // we know this wouldn't overflow since year is limited to 1/2^13 of i32's full range.
 1456|    102|        let mut year = self.year() - 1;
 1457|    102|        let mut ndays = 0;
 1458|    102|        if year < 0 {
 1459|      0|            let excess = 1 + (-year) / 400;
 1460|      0|            year += excess * 400;
 1461|      0|            ndays -= excess * 146_097;
 1462|    102|        }
 1463|    102|        let div_100 = year / 100;
 1464|    102|        ndays += ((year * 1461) >> 2) - div_100 + (div_100 >> 2);
 1465|    102|        ndays + self.ordinal() as i32
 1466|    102|    }
_RNvMNtNtCs8jXVBPYSQuE_6chrono5naive4dateNtB2_9NaiveDate22from_ordinal_and_flags:
  130|    133|    const fn from_ordinal_and_flags(
  131|    133|        year: i32,
  132|    133|        ordinal: u32,
  133|    133|        flags: YearFlags,
  134|    133|    ) -> Option<NaiveDate> {
  135|    133|        if year < MIN_YEAR || year > MAX_YEAR {
