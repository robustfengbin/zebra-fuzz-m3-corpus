  371|   627k|        let (_, carry) = mac(r2, k, MODULUS.0[0], 0);
  372|   627k|        let (r3, carry) = mac(r3, k, MODULUS.0[1], carry);
  373|   627k|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  374|   627k|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
  375|   627k|        let (r6, carry2) = adc(r6, carry2, carry);
  376|       |
