  822|  22.6k|            u: uv2 - vv_plus_uu,
  823|  22.6k|            v: vv_plus_uu,
  824|  22.6k|            z: vv_minus_uu,
  825|  22.6k|            t: zz2 - vv_minus_uu,
  826|  22.6k|        }
  827|  22.6k|        .into_extended()
  828|  22.6k|    }
