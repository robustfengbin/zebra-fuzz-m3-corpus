  449|    982|    pub const fn neg(&self) -> Self {
  450|       |        // Subtract `self` from `MODULUS` to negate. Ignore the final
  451|       |        // borrow because it cannot underflow; self is guaranteed to
  452|       |        // be in the field.
  453|    982|        let (d0, borrow) = sbb(MODULUS.0[0], self.0[0], 0);
  454|    982|        let (d1, borrow) = sbb(MODULUS.0[1], self.0[1], borrow);
  455|    982|        let (d2, borrow) = sbb(MODULUS.0[2], self.0[2], borrow);
  456|    982|        let (d3, _) = sbb(MODULUS.0[3], self.0[3], borrow);
  457|       |
