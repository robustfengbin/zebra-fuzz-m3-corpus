  342|   329k|    const fn montgomery_reduce(
  343|   329k|        r0: u64,
  344|   329k|        r1: u64,
  345|   329k|        r2: u64,
  346|   329k|        r3: u64,
  347|   329k|        r4: u64,
  348|   329k|        r5: u64,
  349|   329k|        r6: u64,
  350|   329k|        r7: u64,
  351|   329k|    ) -> Self {
  352|       |        // The Montgomery reduction here is based on Algorithm 14.32 in
  353|       |        // Handbook of Applied Cryptography
  354|       |        // <http://cacr.uwaterloo.ca/hac/about/chap14.pdf>.
  355|       |
  356|   329k|        let k = r0.wrapping_mul(INV);
  357|   329k|        let (_, carry) = mac(r0, k, MODULUS.0[0], 0);
  358|   329k|        let (r1, carry) = mac(r1, k, MODULUS.0[1], carry);
  359|   329k|        let (r2, carry) = mac(r2, k, MODULUS.0[2], carry);
  360|   329k|        let (r3, carry) = mac(r3, k, MODULUS.0[3], carry);
  361|   329k|        let (r4, carry2) = adc(r4, 0, carry);
  362|       |
  363|   329k|        let k = r1.wrapping_mul(INV);
  364|   329k|        let (_, carry) = mac(r1, k, MODULUS.0[0], 0);
  365|   329k|        let (r2, carry) = mac(r2, k, MODULUS.0[1], carry);
  366|   329k|        let (r3, carry) = mac(r3, k, MODULUS.0[2], carry);
  367|   329k|        let (r4, carry) = mac(r4, k, MODULUS.0[3], carry);
  368|   329k|        let (r5, carry2) = adc(r5, carry2, carry);
  369|       |
  370|   329k|        let k = r2.wrapping_mul(INV);
  371|   329k|        let (_, carry) = mac(r2, k, MODULUS.0[0], 0);
  372|   329k|        let (r3, carry) = mac(r3, k, MODULUS.0[1], carry);
  373|   329k|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  374|   329k|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
  375|   329k|        let (r6, carry2) = adc(r6, carry2, carry);
  376|       |
  377|   329k|        let k = r3.wrapping_mul(INV);
  378|   329k|        let (_, carry) = mac(r3, k, MODULUS.0[0], 0);
  379|   329k|        let (r4, carry) = mac(r4, k, MODULUS.0[1], carry);
  380|   329k|        let (r5, carry) = mac(r5, k, MODULUS.0[2], carry);
  381|   329k|        let (r6, carry) = mac(r6, k, MODULUS.0[3], carry);
  382|   329k|        let (r7, _) = adc(r7, carry2, carry);
  383|       |
  384|       |        // Result may be within MODULUS of the correct value
  385|   329k|        (&Fp([r4, r5, r6, r7])).sub(&MODULUS)
  386|   329k|    }
