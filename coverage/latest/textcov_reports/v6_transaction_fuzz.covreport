   26|       |
   27|  7.67k|    let mut v = F::S;
   28|  7.67k|    let mut x = w * f;
   29|  7.67k|    let mut b = x * w;
   30|       |
   31|       |    // Initialize z as the 2^S root of unity.
   32|  7.67k|    let mut z = F::ROOT_OF_UNITY;
   33|       |
   34|   245k|    for max_v in (1..=F::S).rev() {
   35|   245k|        let mut k = 1;
   36|   245k|        let mut b2k = b.square();
   37|   245k|        let mut j_less_than_v: Choice = 1.into();
   38|       |
