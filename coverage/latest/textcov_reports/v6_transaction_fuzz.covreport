  193|    858|        let is_nonsquare = (sq - F::ROOT_OF_UNITY * u).is_zero();
  194|    858|        assert!(bool::from(u.is_zero() | (is_square ^ is_nonsquare)));
  195|       |
  196|    858|        (is_square, res)
  197|    858|    }

