   59|     33|    fn zcash_deserialize<R: io::Read>(mut reader: R) -> Result<Self, SerializationError> {
   60|       |        // # Consensus
   61|       |        //
   62|       |        // > Elements of an Action description MUST be canonical encodings of the types given above.
   63|       |        //
