  439|    212|        s[26] =  (limbs[4] >>  4)                    as u8;
  440|    212|        s[27] =  (limbs[4] >> 12)                    as u8;
  441|    212|        s[28] =  (limbs[4] >> 20)                    as u8;
  442|    212|        s[29] =  (limbs[4] >> 28)                    as u8;
  443|    212|        s[30] =  (limbs[4] >> 36)                    as u8;
  444|    212|        s[31] =  (limbs[4] >> 44)                    as u8;
  445|       |
  446|       |        // High bit should be zero.
  447|    212|        debug_assert!((s[31] & 0b1000_0000u8) == 0u8);
  448|       |
  449|    212|        s
  450|    212|    }

