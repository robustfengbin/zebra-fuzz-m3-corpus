  342|   312k|    const fn montgomery_reduce(
  343|   312k|        r0: u64,
  344|   312k|        r1: u64,
  345|   312k|        r2: u64,
  346|   312k|        r3: u64,
  347|   312k|        r4: u64,
  348|   312k|        r5: u64,
  349|   312k|        r6: u64,
  350|   312k|        r7: u64,
  351|   312k|    ) -> Self {
  352|       |        // The Montgomery reduction here is based on Algorithm 14.32 in
  353|       |        // Handbook of Applied Cryptography
  354|       |        // <http://cacr.uwaterloo.ca/hac/about/chap14.pdf>.
  355|       |
  356|   312k|        let k = r0.wrapping_mul(INV);
  357|   312k|        let (_, carry) = mac(r0, k, MODULUS.0[0], 0);
  358|   312k|        let (r1, carry) = mac(r1, k, MODULUS.0[1], carry);
  359|   312k|        let (r2, carry) = mac(r2, k, MODULUS.0[2], carry);
  360|   312k|        let (r3, carry) = mac(r3, k, MODULUS.0[3], carry);
  361|   312k|        let (r4, carry2) = adc(r4, 0, carry);
  362|       |
  363|   312k|        let k = r1.wrapping_mul(INV);
  364|   312k|        let (_, carry) = mac(r1, k, MODULUS.0[0], 0);
  365|   312k|        let (r2, carry) = mac(r2, k, MODULUS.0[1], carry);
  366|   312k|        let (r3, carry) = mac(r3, k, MODULUS.0[2], carry);
  367|   312k|        let (r4, carry) = mac(r4, k, MODULUS.0[3], carry);
  368|   312k|        let (r5, carry2) = adc(r5, carry2, carry);
  369|       |
  370|   312k|        let k = r2.wrapping_mul(INV);
  371|   312k|        let (_, carry) = mac(r2, k, MODULUS.0[0], 0);
  372|   312k|        let (r3, carry) = mac(r3, k, MODULUS.0[1], carry);
  373|   312k|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  374|   312k|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
  375|   312k|        let (r6, carry2) = adc(r6, carry2, carry);
  376|       |
  377|   312k|        let k = r3.wrapping_mul(INV);
  378|   312k|        let (_, carry) = mac(r3, k, MODULUS.0[0], 0);
  379|   312k|        let (r4, carry) = mac(r4, k, MODULUS.0[1], carry);
  380|   312k|        let (r5, carry) = mac(r5, k, MODULUS.0[2], carry);
  381|   312k|        let (r6, carry) = mac(r6, k, MODULUS.0[3], carry);
  382|   312k|        let (r7, _) = adc(r7, carry2, carry);
  383|       |
  384|       |        // Result may be within MODULUS of the correct value
  385|   312k|        (&Fp([r4, r5, r6, r7])).sub(&MODULUS)
  386|   312k|    }
