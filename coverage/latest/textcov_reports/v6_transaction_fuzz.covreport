  137|    133|        }
  138|    133|        if ordinal == 0 || ordinal > 366 {
  139|      0|            return None; // Invalid
  140|    133|        }
  141|    133|        debug_assert!(YearFlags::from_year(year).0 == flags.0);
  142|    133|        let yof = (year << 13) | (ordinal << 4) as i32 | flags.0 as i32;
  143|    133|        match yof & OL_MASK <= MAX_OL {
  144|    133|            true => Some(NaiveDate::from_yof(yof)),
  145|      0|            false => None, // Does not exist: Ordinal 366 in a common year.
  146|       |        }
  147|    133|    }
