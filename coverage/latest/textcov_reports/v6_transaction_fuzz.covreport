  408|       |        // into another limb, discard it, subtracting the value
  409|     90|        limbs[4] &= low_51_bit_mask;
  410|       |
  411|       |        // Now arrange the bits of the limbs.
  412|     90|        let mut s = [0u8;32];
  413|     90|        s[ 0] =   limbs[0]                           as u8;
  414|     90|        s[ 1] =  (limbs[0] >>  8)                    as u8;
  415|     90|        s[ 2] =  (limbs[0] >> 16)                    as u8;
  416|     90|        s[ 3] =  (limbs[0] >> 24)                    as u8;
  417|     90|        s[ 4] =  (limbs[0] >> 32)                    as u8;
  418|     90|        s[ 5] =  (limbs[0] >> 40)                    as u8;
  419|     90|        s[ 6] = ((limbs[0] >> 48) | (limbs[1] << 3)) as u8;
  420|     90|        s[ 7] =  (limbs[1] >>  5)                    as u8;
  421|     90|        s[ 8] =  (limbs[1] >> 13)                    as u8;
  422|     90|        s[ 9] =  (limbs[1] >> 21)                    as u8;
  423|     90|        s[10] =  (limbs[1] >> 29)                    as u8;
  424|     90|        s[11] =  (limbs[1] >> 37)                    as u8;
  425|     90|        s[12] = ((limbs[1] >> 45) | (limbs[2] << 6)) as u8;
  426|     90|        s[13] =  (limbs[2] >>  2)                    as u8;
  427|     90|        s[14] =  (limbs[2] >> 10)                    as u8;
  428|     90|        s[15] =  (limbs[2] >> 18)                    as u8;
  429|     90|        s[16] =  (limbs[2] >> 26)                    as u8;
