  341|  7.16M|    pub const fn square(&self) -> Scalar {
  342|  7.16M|        let (r1, carry) = mac(0, self.0[0], self.0[1], 0);
  343|  7.16M|        let (r2, carry) = mac(0, self.0[0], self.0[2], carry);
  344|  7.16M|        let (r3, r4) = mac(0, self.0[0], self.0[3], carry);
