   45|  3.49M|            let squared = F::conditional_select(&b2k, &z, b2k_is_one).square();
   46|  3.49M|            b2k = F::conditional_select(&squared, &b2k, b2k_is_one);
   47|  3.49M|            let new_z = F::conditional_select(&z, &squared, b2k_is_one);
   48|  3.49M|            j_less_than_v &= !j.ct_eq(&v);
   49|  3.49M|            k = u32::conditional_select(&j, &k, b2k_is_one);
   50|  3.49M|            z = F::conditional_select(&z, &new_z, j_less_than_v);
   51|  3.49M|        }
   52|       |
   53|   240k|        let result = x * z;
   54|   240k|        x = F::conditional_select(&result, &x, b.ct_eq(&F::ONE));
   55|   240k|        z = z.square();
   56|   240k|        b *= z;
   57|   240k|        v = k;
   58|       |    }
