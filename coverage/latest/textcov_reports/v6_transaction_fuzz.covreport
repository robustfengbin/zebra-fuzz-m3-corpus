  310|   275k|    pub const fn square(&self) -> Fp {
  311|   275k|        let (r1, carry) = mac(0, self.0[0], self.0[1], 0);
  312|   275k|        let (r2, carry) = mac(0, self.0[0], self.0[2], carry);
