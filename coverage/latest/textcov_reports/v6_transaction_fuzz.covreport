  356|   555k|        let k = r0.wrapping_mul(INV);
  357|   555k|        let (_, carry) = mac(r0, k, MODULUS.0[0], 0);
  358|   555k|        let (r1, carry) = mac(r1, k, MODULUS.0[1], carry);
  359|   555k|        let (r2, carry) = mac(r2, k, MODULUS.0[2], carry);
  360|   555k|        let (r3, carry) = mac(r3, k, MODULUS.0[3], carry);
  361|   555k|        let (r4, carry2) = adc(r4, 0, carry);
  362|       |
  363|   555k|        let k = r1.wrapping_mul(INV);
  364|   555k|        let (_, carry) = mac(r1, k, MODULUS.0[0], 0);
  365|   555k|        let (r2, carry) = mac(r2, k, MODULUS.0[1], carry);
  366|   555k|        let (r3, carry) = mac(r3, k, MODULUS.0[2], carry);
  367|   555k|        let (r4, carry) = mac(r4, k, MODULUS.0[3], carry);
  368|   555k|        let (r5, carry2) = adc(r5, carry2, carry);
  369|       |
  370|   555k|        let k = r2.wrapping_mul(INV);
  371|   555k|        let (_, carry) = mac(r2, k, MODULUS.0[0], 0);
  372|   555k|        let (r3, carry) = mac(r3, k, MODULUS.0[1], carry);
  373|   555k|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  374|   555k|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
  375|   555k|        let (r6, carry2) = adc(r6, carry2, carry);
  376|       |
  377|   555k|        let k = r3.wrapping_mul(INV);
  378|   555k|        let (_, carry) = mac(r3, k, MODULUS.0[0], 0);
  379|   555k|        let (r4, carry) = mac(r4, k, MODULUS.0[1], carry);
  380|   555k|        let (r5, carry) = mac(r5, k, MODULUS.0[2], carry);
