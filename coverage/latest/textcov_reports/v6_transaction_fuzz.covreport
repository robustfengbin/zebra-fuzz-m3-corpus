  341|  84.4k|    pub const fn square(&self) -> Scalar {
  342|  84.4k|        let (r1, carry) = mac(0, self.0[0], self.0[1], 0);
  343|  84.4k|        let (r2, carry) = mac(0, self.0[0], self.0[2], carry);
