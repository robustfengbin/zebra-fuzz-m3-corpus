 2422|    137|const fn cycle_to_yo(cycle: u32) -> (u32, u32) {
 2423|    137|    let mut year_mod_400 = cycle / 365;
 2424|    137|    let mut ordinal0 = cycle % 365;
 2425|    137|    let delta = YEAR_DELTAS[year_mod_400 as usize] as u32;
 2426|    137|    if ordinal0 < delta {
 2427|     21|        year_mod_400 -= 1;
 2428|     21|        ordinal0 += 365 - YEAR_DELTAS[year_mod_400 as usize] as u32;
 2429|    116|    } else {
 2430|    116|        ordinal0 -= delta;
 2431|    116|    }
 2432|    137|    (year_mod_400, ordinal0 + 1)
 2433|    137|}

