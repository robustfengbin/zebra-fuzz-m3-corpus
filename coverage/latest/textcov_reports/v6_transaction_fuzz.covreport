 1458|    211|        if year < 0 {
 1459|      0|            let excess = 1 + (-year) / 400;
 1460|      0|            year += excess * 400;
 1461|      0|            ndays -= excess * 146_097;
 1462|    211|        }
 1463|    211|        let div_100 = year / 100;
 1464|    211|        ndays += ((year * 1461) >> 2) - div_100 + (div_100 >> 2);
 1465|    211|        ndays + self.ordinal() as i32
 1466|    211|    }
_RNvMNtNtCs8jXVBPYSQuE_6chrono5naive4dateNtB2_9NaiveDate22from_ordinal_and_flags:
  130|    219|    const fn from_ordinal_and_flags(
  131|    219|        year: i32,
  132|    219|        ordinal: u32,
  133|    219|        flags: YearFlags,
  134|    219|    ) -> Option<NaiveDate> {
  135|    219|        if year < MIN_YEAR || year > MAX_YEAR {
  136|      0|            return None; // Out-of-range
  137|    219|        }
  138|    219|        if ordinal == 0 || ordinal > 366 {
  139|      0|            return None; // Invalid
  140|    219|        }
  141|    219|        debug_assert!(YearFlags::from_year(year).0 == flags.0);
  142|    219|        let yof = (year << 13) | (ordinal << 4) as i32 | flags.0 as i32;
  143|    219|        match yof & OL_MASK <= MAX_OL {
  144|    219|            true => Some(NaiveDate::from_yof(yof)),
  145|      0|            false => None, // Does not exist: Ordinal 366 in a common year.
  146|       |        }
  147|    219|    }
