  154|    163|    fn ct_eq(&self, other: &Self) -> Choice {
  155|       |        // (u/z, v/z) = (u'/z', v'/z') is implied by
  156|       |        //      (uz'z = u'z'z) and
  157|       |        //      (vz'z = v'z'z)
