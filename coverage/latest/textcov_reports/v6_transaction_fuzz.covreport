   86|     32|pub fn zcash_deserialize_external_count<R: io::Read, T: ZcashDeserialize + TrustedPreallocate>(
   87|     32|    external_count: usize,
   88|     32|    mut reader: R,
   89|     32|) -> Result<Vec<T>, SerializationError> {
   90|     32|    match u64::try_from(external_count) {
   91|     32|        Ok(external_count) if external_count > T::max_allocation() => {
   92|      0|            return Err(SerializationError::Parse(
   93|      0|                "Vector longer than max_allocation",
   94|      0|            ))
   95|       |        }
   96|     32|        Ok(_) => {}
   97|       |        // As of 2021, usize is less than or equal to 64 bits on all (or almost all?) supported Rust platforms.
   98|       |        // So in practice this error is impossible. (But the check is required, because Rust is future-proof
   99|       |        // for 128 bit memory spaces.)
  100|      0|        Err(_) => return Err(SerializationError::Parse("Vector longer than u64::MAX")),
  101|       |    }
  102|       |    // Cap the upfront reservation. The Vec grows via push() as elements
  103|       |    // arrive, so a peer-supplied `external_count` can't force a large
  104|       |    // allocation before any data is read. Fixes the deserializer-level
  105|       |    // case of GHSA-xr93-pcq3-pxf8.
  106|     32|    let mut vec = Vec::with_capacity(external_count.min(MAX_INITIAL_ALLOCATION));
  107|     32|    for _ in 0..external_count {
  108|      2|        vec.push(T::zcash_deserialize(&mut reader)?);
  109|       |    }
  110|     32|    Ok(vec)
  111|     32|}
