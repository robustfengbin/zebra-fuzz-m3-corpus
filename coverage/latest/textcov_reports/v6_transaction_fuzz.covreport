  670|       |                        let x3 = x.square() * x;
  671|       |                        (x3 + $name::curve_constant_b()).sqrt().and_then(|y| {
  672|       |                            let sign = y.is_odd();
  673|       |
  674|       |                            let y = $base::conditional_select(&y, &-y, ysign ^ sign);
