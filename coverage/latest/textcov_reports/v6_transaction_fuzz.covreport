  363|   627k|        let k = r1.wrapping_mul(INV);
  364|   627k|        let (_, carry) = mac(r1, k, MODULUS.0[0], 0);
  365|   627k|        let (r2, carry) = mac(r2, k, MODULUS.0[1], carry);
  366|   627k|        let (r3, carry) = mac(r3, k, MODULUS.0[2], carry);
  367|   627k|        let (r4, carry) = mac(r4, k, MODULUS.0[3], carry);
  368|   627k|        let (r5, carry2) = adc(r5, carry2, carry);
  369|       |
