   81|   194k|pub fn iso_map<F: Field, C: CurveExt<Base = F>, I: CurveExt<Base = F>>(
   82|   194k|    p: &I,
   83|   194k|    iso: &[C::Base; 13],
   84|   194k|) -> C {
   85|       |    // The input and output are in Jacobian coordinates, using the method
   86|       |    // in "Avoiding inversions" [WB2019, section 4.3].
   87|       |
   88|   194k|    let (x, y, z) = p.jacobian_coordinates();
   89|       |
