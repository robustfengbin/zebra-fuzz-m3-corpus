   11|   194k|pub fn hash_to_field<F: FromUniformBytes<64>>(
   12|   194k|    curve_id: &str,
   13|   194k|    domain_prefix: &str,
   14|   194k|    message: &[u8],
   15|   194k|    buf: &mut [F; 2],
   16|   194k|) {
   17|   194k|    assert!(domain_prefix.len() < 256);
   18|   194k|    assert!((22 + curve_id.len() + domain_prefix.len()) < 256);
   19|       |
   20|       |    // Assume that the field size is 32 bytes and k is 256, where k is defined in
   21|       |    // <https://www.ietf.org/archive/id/draft-irtf-cfrg-hash-to-curve-10.html#name-security-considerations-3>.
   22|       |    const CHUNKLEN: usize = 64;
   23|       |    const_assert!(CHUNKLEN * 2 < 256);
   24|       |
   25|       |    // Input block size of BLAKE2b.
   26|       |    const R_IN_BYTES: usize = 128;
   27|       |
   28|   194k|    let personal = [0u8; 16];
   29|   194k|    let empty_hasher = blake2b_simd::Params::new()
   30|   194k|        .hash_length(CHUNKLEN)
   31|   194k|        .personal(&personal)
   32|   194k|        .to_state();
   33|       |
   34|   194k|    let b_0 = empty_hasher
   35|   194k|        .clone()
   36|   194k|        .update(&[0; R_IN_BYTES])
   37|   194k|        .update(message)
   38|   194k|        .update(&[0, (CHUNKLEN * 2) as u8, 0])
   39|   194k|        .update(domain_prefix.as_bytes())
   40|   194k|        .update(b"-")
   41|   194k|        .update(curve_id.as_bytes())
   42|   194k|        .update(b"_XMD:BLAKE2b_SSWU_RO_")
   43|   194k|        .update(&[(22 + curve_id.len() + domain_prefix.len()) as u8])
   44|   194k|        .finalize();
   45|       |
   46|   194k|    let b_1 = empty_hasher
   47|   194k|        .clone()
   48|   194k|        .update(b_0.as_array())
   49|   194k|        .update(&[1])
   50|   194k|        .update(domain_prefix.as_bytes())
   51|   194k|        .update(b"-")
   52|   194k|        .update(curve_id.as_bytes())
   53|   194k|        .update(b"_XMD:BLAKE2b_SSWU_RO_")
   54|   194k|        .update(&[(22 + curve_id.len() + domain_prefix.len()) as u8])
   55|   194k|        .finalize();
   56|       |
   57|   194k|    let b_2 = {
   58|   194k|        let mut empty_hasher = empty_hasher;
   59|  12.4M|        for (l, r) in b_0.as_array().iter().zip(b_1.as_array().iter()) {
   60|  12.4M|            empty_hasher.update(&[*l ^ *r]);
   61|  12.4M|        }
   62|   194k|        empty_hasher
   63|   194k|            .update(&[2])
   64|   194k|            .update(domain_prefix.as_bytes())
   65|   194k|            .update(b"-")
   66|   194k|            .update(curve_id.as_bytes())
   67|   194k|            .update(b"_XMD:BLAKE2b_SSWU_RO_")
   68|   194k|            .update(&[(22 + curve_id.len() + domain_prefix.len()) as u8])
   69|   194k|            .finalize()
   70|       |    };
   71|       |
   72|   389k|    for (big, buf) in [b_1, b_2].iter().zip(buf.iter_mut()) {
   73|   389k|        let mut little = [0u8; CHUNKLEN];
   74|   389k|        little.copy_from_slice(big.as_array());
   75|   389k|        little.reverse();
   76|   389k|        *buf = F::from_uniform_bytes(&little);
   77|   389k|    }
   78|   194k|}
_RINvNtCs41Au54XfBWR_12pasta_curves11hashtocurve23map_to_curve_simple_swuNtNtNtB4_6fields2fp2FpNtNtB4_6curves2EpNtB1w_5IsoEpEB4_:
  109|   389k|pub fn map_to_curve_simple_swu<F: PrimeField, C: CurveExt<Base = F>, I: CurveExt<Base = F>>(
  110|   389k|    u: &F,
  111|   389k|    theta: F,
  112|   389k|    z: F,
  113|   389k|) -> I {
  114|       |    // 1. tv1 = inv0(Z^2 * u^4 + Z * u^2)
  115|       |    // 2. x1 = (-B / A) * (1 + tv1)
  116|       |    // 3. If tv1 == 0, set x1 = B / (Z * A)
  117|       |    // 4. gx1 = x1^3 + A * x1 + B
  118|       |    //
  119|       |    // We use the "Avoiding inversions" optimization in [WB2019, section 4.2]
  120|       |    // (not to be confused with section 4.3):
  121|       |    //
  122|       |    //   here       [WB2019]
  123|       |    //   -------    ---------------------------------
  124|       |    //   Z          ξ
  125|       |    //   u          t
  126|       |    //   Z * u^2    ξ * t^2 (called u, confusingly)
  127|       |    //   x1         X_0(t)
  128|       |    //   x2         X_1(t)
  129|       |    //   gx1        g(X_0(t))
  130|       |    //   gx2        g(X_1(t))
  131|       |    //
  132|       |    // Using the "here" names:
  133|       |    //    x1 = num_x1/div      = [B*(Z^2 * u^4 + Z * u^2 + 1)] / [-A*(Z^2 * u^4 + Z * u^2]
  134|       |    //   gx1 = num_gx1/div_gx1 = [num_x1^3 + A * num_x1 * div^2 + B * div^3] / div^3
  135|       |
  136|   389k|    let a = I::a();
  137|   389k|    let b = I::b();
  138|   389k|    let z_u2 = z * u.square();
  139|   389k|    let ta = z_u2.square() + z_u2;
  140|   389k|    let num_x1 = b * (ta + F::ONE);
  141|   389k|    let div = a * F::conditional_select(&-ta, &z, ta.is_zero());
  142|   389k|    let num2_x1 = num_x1.square();
  143|   389k|    let div2 = div.square();
  144|   389k|    let div3 = div2 * div;
  145|   389k|    let num_gx1 = (num2_x1 + a * div2) * num_x1 + b * div3;
  146|       |
  147|       |    // 5. x2 = Z * u^2 * x1
  148|   389k|    let num_x2 = z_u2 * num_x1; // same div
  149|       |
  150|       |    // 6. gx2 = x2^3 + A * x2 + B  [optimized out; see below]
  151|       |    // 7. If is_square(gx1), set x = x1 and y = sqrt(gx1)
  152|       |    // 8. Else set x = x2 and y = sqrt(gx2)
  153|   389k|    let (gx1_square, y1) = F::sqrt_ratio(&num_gx1, &div3);
  154|       |
  155|       |    // This magic also comes from a generalization of [WB2019, section 4.2].
  156|       |    //
  157|       |    // The Sarkar square root algorithm with input s gives us a square root of
  158|       |    // h * s for free when s is not square, where h is a fixed nonsquare.
  159|       |    // In our implementation, h = ROOT_OF_UNITY.
  160|       |    // We know that Z / h is a square since both Z and h are
  161|       |    // nonsquares. Precompute theta as a square root of Z / ROOT_OF_UNITY.
  162|       |    //
  163|       |    // We have gx2 = g(Z * u^2 * x1) = Z^3 * u^6 * gx1
  164|       |    //                               = (Z * u^3)^2 * (Z/h * h * gx1)
  165|       |    //                               = (Z * theta * u^3)^2 * (h * gx1)
  166|       |    //
  167|       |    // When gx1 is not square, y1 is a square root of h * gx1, and so Z * theta * u^3 * y1
  168|       |    // is a square root of gx2. Note that we don't actually need to compute gx2.
  169|       |
  170|   389k|    let y2 = theta * z_u2 * u * y1;
  171|   389k|    let num_x = F::conditional_select(&num_x2, &num_x1, gx1_square);
  172|   389k|    let y = F::conditional_select(&y2, &y1, gx1_square);
  173|       |
  174|       |    // 9. If sgn0(u) != sgn0(y), set y = -y
  175|   389k|    let y = F::conditional_select(&(-y), &y, u.is_odd().ct_eq(&y.is_odd()));
  176|       |
  177|   389k|    I::new_jacobian(num_x * div, y * div3, div).unwrap()
  178|   389k|}
