  582|   375M|    pub const fn sub(&self, rhs: &Self) -> Self {
  583|   375M|        let (d0, borrow) = sbb(self.0[0], rhs.0[0], 0);
  584|   375M|        let (d1, borrow) = sbb(self.0[1], rhs.0[1], borrow);
