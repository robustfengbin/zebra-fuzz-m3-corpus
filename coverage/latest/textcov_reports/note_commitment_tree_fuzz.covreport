_RNvMse_NtNtCs41Au54XfBWR_12pasta_curves6fields2fpNtB5_2Fp17montgomery_reduce:
  342|   867M|    const fn montgomery_reduce(
  343|   867M|        r0: u64,
  344|   867M|        r1: u64,
  345|   867M|        r2: u64,
  346|   867M|        r3: u64,
  347|   867M|        r4: u64,
  348|   867M|        r5: u64,
  349|   867M|        r6: u64,
  350|   867M|        r7: u64,
  351|   867M|    ) -> Self {
  352|       |        // The Montgomery reduction here is based on Algorithm 14.32 in
  353|       |        // Handbook of Applied Cryptography
  354|       |        // <http://cacr.uwaterloo.ca/hac/about/chap14.pdf>.
  355|       |
  356|   867M|        let k = r0.wrapping_mul(INV);
  357|   867M|        let (_, carry) = mac(r0, k, MODULUS.0[0], 0);
  358|   867M|        let (r1, carry) = mac(r1, k, MODULUS.0[1], carry);
