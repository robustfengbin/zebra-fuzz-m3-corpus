  365|   194k|            fn add(self, rhs: &'a $name) -> $name {
  366|   194k|                if bool::from(self.is_identity()) {
  367|      0|                    *rhs
  368|   194k|                } else if bool::from(rhs.is_identity()) {
  369|      0|                    *self
  370|       |                } else {
  371|   194k|                    let z1z1 = self.z.square();
  372|   194k|                    let z2z2 = rhs.z.square();
  373|   194k|                    let u1 = self.x * z2z2;
  374|   194k|                    let u2 = rhs.x * z1z1;
  375|   194k|                    let s1 = self.y * z2z2 * rhs.z;
  376|   194k|                    let s2 = rhs.y * z1z1 * self.z;
