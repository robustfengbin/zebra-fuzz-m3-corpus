  881|   194k|        fn hash_to_curve<'a>(domain_prefix: &'a str) -> Box<dyn Fn(&[u8]) -> Self + 'a> {
  882|       |            use super::hashtocurve;
  883|       |
  884|   194k|            Box::new(move |message| {
  885|       |                let mut us = [Field::ZERO; 2];
