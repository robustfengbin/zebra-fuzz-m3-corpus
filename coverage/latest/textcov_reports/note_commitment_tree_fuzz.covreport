  291|  40.5M|            fn ct_eq(&self, other: &Self) -> Choice {
  292|       |                // Is (xz^2, yz^3, z) equal to (x'z'^2, yz'^3, z') when converted to affine?
  293|       |
  294|  40.5M|                let z = other.z.square();
  295|  40.5M|                let x1 = self.x * z;
  296|  40.5M|                let z = z * other.z;
  297|  40.5M|                let y1 = self.y * z;
  298|  40.5M|                let z = self.z.square();
  299|  40.5M|                let x2 = other.x * z;
  300|  40.5M|                let z = z * self.z;
  301|  40.5M|                let y2 = other.y * z;
  302|       |
  303|  40.5M|                let self_is_zero = self.is_identity();
  304|  40.5M|                let other_is_zero = other.is_identity();
  305|       |
  306|  40.5M|                (self_is_zero & other_is_zero) // Both point at infinity
  307|  40.5M|                            | ((!self_is_zero) & (!other_is_zero) & x1.ct_eq(&x2) & y1.ct_eq(&y2))
  308|       |                // Neither point at infinity, coordinates are the same
  309|  40.5M|            }
