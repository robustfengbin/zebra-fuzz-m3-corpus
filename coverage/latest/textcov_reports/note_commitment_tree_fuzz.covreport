   91|   194k|    let z3 = z2 * z;
   92|   194k|    let z4 = z2.square();
   93|   194k|    let z6 = z3.square();
   94|       |
   95|   194k|    let num_x = ((iso[0] * x + iso[1] * z2) * x + iso[2] * z4) * x + iso[3] * z6;
   96|   194k|    let div_x = (z2 * x + iso[4] * z4) * x + iso[5] * z6;
   97|       |
   98|   194k|    let num_y = (((iso[6] * x + iso[7] * z2) * x + iso[8] * z4) * x + iso[9] * z6) * y;
   99|   194k|    let div_y = (((x + iso[10] * z2) * x + iso[11] * z4) * x + iso[12] * z6) * z3;
  100|       |
  101|   194k|    let zo = div_x * div_y;
  102|   194k|    let xo = num_x * div_y * zo;
  103|   194k|    let yo = num_y * div_x * zo.square();
  104|       |
  105|   194k|    C::new_jacobian(xo, yo, zo).unwrap()
  106|   194k|}

