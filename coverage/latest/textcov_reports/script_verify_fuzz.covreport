  342|   148k|    const fn montgomery_reduce(
  343|   148k|        r0: u64,
  344|   148k|        r1: u64,
  345|   148k|        r2: u64,
  346|   148k|        r3: u64,
  347|   148k|        r4: u64,
  348|   148k|        r5: u64,
  349|   148k|        r6: u64,
  350|   148k|        r7: u64,
  351|   148k|    ) -> Self {
  352|       |        // The Montgomery reduction here is based on Algorithm 14.32 in
  353|       |        // Handbook of Applied Cryptography
  354|       |        // <http://cacr.uwaterloo.ca/hac/about/chap14.pdf>.
