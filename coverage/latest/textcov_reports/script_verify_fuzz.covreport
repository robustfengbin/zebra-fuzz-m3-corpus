   29|  3.00k|            let tail_ptr = data.as_ptr().add(blocks_len);
   30|  3.00k|            (
   31|  3.00k|                slice::from_raw_parts(blocks_ptr, nb),
   32|  3.00k|                slice::from_raw_parts(tail_ptr, tail_len),
