  261|  2.51k|        tmp.0[2] = u64::from_le_bytes(<[u8; 8]>::try_from(&bytes[16..24]).unwrap());
  262|  2.51k|        tmp.0[3] = u64::from_le_bytes(<[u8; 8]>::try_from(&bytes[24..32]).unwrap());
  263|       |
  264|       |        // Try to subtract the modulus
  265|  2.51k|        let (_, borrow) = sbb(tmp.0[0], MODULUS.0[0], 0);
  266|  2.51k|        let (_, borrow) = sbb(tmp.0[1], MODULUS.0[1], borrow);
  267|  2.51k|        let (_, borrow) = sbb(tmp.0[2], MODULUS.0[2], borrow);
  268|  2.51k|        let (_, borrow) = sbb(tmp.0[3], MODULUS.0[3], borrow);
