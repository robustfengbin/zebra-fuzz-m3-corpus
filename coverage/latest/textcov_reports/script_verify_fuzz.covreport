  506|  2.54M|    const fn montgomery_reduce(
  507|  2.54M|        r0: u64,
  508|  2.54M|        r1: u64,
  509|  2.54M|        r2: u64,
  510|  2.54M|        r3: u64,
  511|  2.54M|        r4: u64,
  512|  2.54M|        r5: u64,
  513|  2.54M|        r6: u64,
  514|  2.54M|        r7: u64,
  515|  2.54M|    ) -> Self {
  516|       |        // The Montgomery reduction here is based on Algorithm 14.32 in
  517|       |        // Handbook of Applied Cryptography
  518|       |        // <http://cacr.uwaterloo.ca/hac/about/chap14.pdf>.
  519|       |
