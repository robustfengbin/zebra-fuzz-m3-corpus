  399|  28.1k|        let (r2, carry) = mac(r2, self.0[1], rhs.0[1], carry);
  400|  28.1k|        let (r3, carry) = mac(r3, self.0[1], rhs.0[2], carry);
  401|  28.1k|        let (r4, r5) = mac(r4, self.0[1], rhs.0[3], carry);
  402|       |
  403|  28.1k|        let (r2, carry) = mac(r2, self.0[2], rhs.0[0], 0);
  404|  28.1k|        let (r3, carry) = mac(r3, self.0[2], rhs.0[1], carry);
  405|  28.1k|        let (r4, carry) = mac(r4, self.0[2], rhs.0[2], carry);
  406|  28.1k|        let (r5, r6) = mac(r5, self.0[2], rhs.0[3], carry);
