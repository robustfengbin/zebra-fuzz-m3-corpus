  342|   227k|    const fn montgomery_reduce(
  343|   227k|        r0: u64,
  344|   227k|        r1: u64,
  345|   227k|        r2: u64,
  346|   227k|        r3: u64,
  347|   227k|        r4: u64,
  348|   227k|        r5: u64,
  349|   227k|        r6: u64,
  350|   227k|        r7: u64,
  351|   227k|    ) -> Self {
  352|       |        // The Montgomery reduction here is based on Algorithm 14.32 in
  353|       |        // Handbook of Applied Cryptography
  354|       |        // <http://cacr.uwaterloo.ca/hac/about/chap14.pdf>.
  355|       |
  356|   227k|        let k = r0.wrapping_mul(INV);
  357|   227k|        let (_, carry) = mac(r0, k, MODULUS.0[0], 0);
  358|   227k|        let (r1, carry) = mac(r1, k, MODULUS.0[1], carry);
  359|   227k|        let (r2, carry) = mac(r2, k, MODULUS.0[2], carry);
  360|   227k|        let (r3, carry) = mac(r3, k, MODULUS.0[3], carry);
  361|   227k|        let (r4, carry2) = adc(r4, 0, carry);
  362|       |
  363|   227k|        let k = r1.wrapping_mul(INV);
  364|   227k|        let (_, carry) = mac(r1, k, MODULUS.0[0], 0);
  365|   227k|        let (r2, carry) = mac(r2, k, MODULUS.0[1], carry);
  366|   227k|        let (r3, carry) = mac(r3, k, MODULUS.0[2], carry);
  367|   227k|        let (r4, carry) = mac(r4, k, MODULUS.0[3], carry);
  368|   227k|        let (r5, carry2) = adc(r5, carry2, carry);
  369|       |
  370|   227k|        let k = r2.wrapping_mul(INV);
  371|   227k|        let (_, carry) = mac(r2, k, MODULUS.0[0], 0);
  372|   227k|        let (r3, carry) = mac(r3, k, MODULUS.0[1], carry);
  373|   227k|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  374|   227k|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
  375|   227k|        let (r6, carry2) = adc(r6, carry2, carry);
  376|       |
  377|   227k|        let k = r3.wrapping_mul(INV);
  378|   227k|        let (_, carry) = mac(r3, k, MODULUS.0[0], 0);
  379|   227k|        let (r4, carry) = mac(r4, k, MODULUS.0[1], carry);
  380|   227k|        let (r5, carry) = mac(r5, k, MODULUS.0[2], carry);
  381|   227k|        let (r6, carry) = mac(r6, k, MODULUS.0[3], carry);
  382|   227k|        let (r7, _) = adc(r7, carry2, carry);
  383|       |
  384|       |        // Result may be within MODULUS of the correct value
  385|   227k|        (&Fp([r4, r5, r6, r7])).sub(&MODULUS)
  386|   227k|    }
