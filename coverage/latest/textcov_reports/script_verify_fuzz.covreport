  542|  1.86M|        let (_, carry) = mac(r3, k, MODULUS.0[0], 0);
  543|  1.86M|        let (r4, carry) = mac(r4, k, MODULUS.0[1], carry);
  544|  1.86M|        let (r5, carry) = mac(r5, k, MODULUS.0[2], carry);
