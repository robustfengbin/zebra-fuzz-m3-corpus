  459|       |        // zero if `self` was zero, and `u64::max_value()` if self was nonzero.
  460|    522|        let mask = (((self.0[0] | self.0[1] | self.0[2] | self.0[3]) == 0) as u64).wrapping_sub(1);
  461|       |
  462|    522|        Fp([d0 & mask, d1 & mask, d2 & mask, d3 & mask])
  463|    522|    }
