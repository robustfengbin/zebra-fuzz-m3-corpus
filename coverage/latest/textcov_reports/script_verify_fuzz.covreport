  192|    610|        let is_square = (sq - u).is_zero();
  193|    610|        let is_nonsquare = (sq - F::ROOT_OF_UNITY * u).is_zero();
  194|    610|        assert!(bool::from(u.is_zero() | (is_square ^ is_nonsquare)));
  195|       |
  196|    610|        (is_square, res)
  197|    610|    }

