  354|  2.26M|        let r4 = (r4 << 1) | (r3 >> 63);
  355|  2.26M|        let r3 = (r3 << 1) | (r2 >> 63);
  356|  2.26M|        let r2 = (r2 << 1) | (r1 >> 63);
