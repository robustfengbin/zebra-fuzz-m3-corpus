  522|  2.83M|        let (r1, carry) = mac(r1, k, MODULUS.0[1], carry);
  523|  2.83M|        let (r2, carry) = mac(r2, k, MODULUS.0[2], carry);
  524|  2.83M|        let (r3, carry) = mac(r3, k, MODULUS.0[3], carry);
  525|  2.83M|        let (r4, carry2) = adc(r4, 0, carry);
  526|       |
  527|  2.83M|        let k = r1.wrapping_mul(INV);
  528|  2.83M|        let (_, carry) = mac(r1, k, MODULUS.0[0], 0);
  529|  2.83M|        let (r2, carry) = mac(r2, k, MODULUS.0[1], carry);
  530|  2.83M|        let (r3, carry) = mac(r3, k, MODULUS.0[2], carry);
  531|  2.83M|        let (r4, carry) = mac(r4, k, MODULUS.0[3], carry);
  532|  2.83M|        let (r5, carry2) = adc(r5, carry2, carry);
  533|       |
  534|  2.83M|        let k = r2.wrapping_mul(INV);
  535|  2.83M|        let (_, carry) = mac(r2, k, MODULUS.0[0], 0);
  536|  2.83M|        let (r3, carry) = mac(r3, k, MODULUS.0[1], carry);
  537|  2.83M|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  538|  2.83M|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
  539|  2.83M|        let (r6, carry2) = adc(r6, carry2, carry);
  540|       |
  541|  2.83M|        let k = r3.wrapping_mul(INV);
  542|  2.83M|        let (_, carry) = mac(r3, k, MODULUS.0[0], 0);
  543|  2.83M|        let (r4, carry) = mac(r4, k, MODULUS.0[1], carry);
  544|  2.83M|        let (r5, carry) = mac(r5, k, MODULUS.0[2], carry);
  545|  2.83M|        let (r6, carry) = mac(r6, k, MODULUS.0[3], carry);
