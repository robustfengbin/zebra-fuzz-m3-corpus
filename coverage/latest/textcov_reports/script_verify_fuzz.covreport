  142|       |        //
  143|       |        // https://zips.z.cash/protocol/protocol.pdf#outputdesc
  144|       |        //
  145|       |        // > LEOS2IP_{256}(cmu) MUST be less than 𝑞_J.
  146|       |        //
  147|       |        // https://zips.z.cash/protocol/protocol.pdf#outputencodingandconsensus
