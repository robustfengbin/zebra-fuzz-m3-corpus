  185|    610|    pub fn sqrt_alt(&self, u: &F) -> (Choice, F) {
  186|    610|        let v = u.pow_by_t_minus1_over2();
  187|    610|        let uv = *u * v;
  188|       |
  189|    610|        let res = self.sqrt_common(&uv, &v);
