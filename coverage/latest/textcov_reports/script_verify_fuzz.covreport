  292|  3.04k|        res[16..24].copy_from_slice(&tmp.0[2].to_le_bytes());
  293|  3.04k|        res[24..32].copy_from_slice(&tmp.0[3].to_le_bytes());
  294|       |
  295|  3.04k|        res
  296|  3.04k|    }
