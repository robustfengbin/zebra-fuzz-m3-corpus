_RNvMse_NtNtCs41Au54XfBWR_12pasta_curves6fields2fpNtB5_2Fp17montgomery_reduce:
  342|   209k|    const fn montgomery_reduce(
  343|   209k|        r0: u64,
  344|   209k|        r1: u64,
  345|   209k|        r2: u64,
  346|   209k|        r3: u64,
  347|   209k|        r4: u64,
  348|   209k|        r5: u64,
  349|   209k|        r6: u64,
  350|   209k|        r7: u64,
  351|   209k|    ) -> Self {
  352|       |        // The Montgomery reduction here is based on Algorithm 14.32 in
  353|       |        // Handbook of Applied Cryptography
  354|       |        // <http://cacr.uwaterloo.ca/hac/about/chap14.pdf>.
  355|       |
  356|   209k|        let k = r0.wrapping_mul(INV);
  357|   209k|        let (_, carry) = mac(r0, k, MODULUS.0[0], 0);
  358|   209k|        let (r1, carry) = mac(r1, k, MODULUS.0[1], carry);
  359|   209k|        let (r2, carry) = mac(r2, k, MODULUS.0[2], carry);
  360|   209k|        let (r3, carry) = mac(r3, k, MODULUS.0[3], carry);
  361|   209k|        let (r4, carry2) = adc(r4, 0, carry);
  362|       |
  363|   209k|        let k = r1.wrapping_mul(INV);
  364|   209k|        let (_, carry) = mac(r1, k, MODULUS.0[0], 0);
  365|   209k|        let (r2, carry) = mac(r2, k, MODULUS.0[1], carry);
  366|   209k|        let (r3, carry) = mac(r3, k, MODULUS.0[2], carry);
  367|   209k|        let (r4, carry) = mac(r4, k, MODULUS.0[3], carry);
  368|   209k|        let (r5, carry2) = adc(r5, carry2, carry);
  369|       |
  370|   209k|        let k = r2.wrapping_mul(INV);
  371|   209k|        let (_, carry) = mac(r2, k, MODULUS.0[0], 0);
  372|   209k|        let (r3, carry) = mac(r3, k, MODULUS.0[1], carry);
  373|   209k|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  374|   209k|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
  375|   209k|        let (r6, carry2) = adc(r6, carry2, carry);
  376|       |
  377|   209k|        let k = r3.wrapping_mul(INV);
  378|   209k|        let (_, carry) = mac(r3, k, MODULUS.0[0], 0);
  379|   209k|        let (r4, carry) = mac(r4, k, MODULUS.0[1], carry);
  380|   209k|        let (r5, carry) = mac(r5, k, MODULUS.0[2], carry);
  381|   209k|        let (r6, carry) = mac(r6, k, MODULUS.0[3], carry);
  382|   209k|        let (r7, _) = adc(r7, carry2, carry);
  383|       |
  384|       |        // Result may be within MODULUS of the correct value
  385|   209k|        (&Fp([r4, r5, r6, r7])).sub(&MODULUS)
  386|   209k|    }
