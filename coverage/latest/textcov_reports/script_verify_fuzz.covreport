  393|  28.1k|        let (r0, carry) = mac(0, self.0[0], rhs.0[0], 0);
  394|  28.1k|        let (r1, carry) = mac(0, self.0[0], rhs.0[1], carry);
  395|  28.1k|        let (r2, carry) = mac(0, self.0[0], rhs.0[2], carry);
  396|  28.1k|        let (r3, r4) = mac(0, self.0[0], rhs.0[3], carry);
  397|       |
