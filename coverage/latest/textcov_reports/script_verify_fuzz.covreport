  362|  14.1k|        let (r3, carry) = adc(0, r3, carry);
  363|  14.1k|        let (r4, carry) = mac(r4, self.0[2], self.0[2], carry);
  364|  14.1k|        let (r5, carry) = adc(0, r5, carry);
  365|  14.1k|        let (r6, carry) = mac(r6, self.0[3], self.0[3], carry);
  366|  14.1k|        let (r7, _) = adc(0, r7, carry);
