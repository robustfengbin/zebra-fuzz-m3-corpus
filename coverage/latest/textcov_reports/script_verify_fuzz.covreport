   28|  4.04k|            let blocks_ptr = data.as_ptr() as *const Block<N>;
   29|  4.04k|            let tail_ptr = data.as_ptr().add(blocks_len);
   30|  4.04k|            (
   31|  4.04k|                slice::from_raw_parts(blocks_ptr, nb),
   32|  4.04k|                slice::from_raw_parts(tail_ptr, tail_len),
   33|  4.04k|            )
   34|       |        }
   35|  4.04k|    }

