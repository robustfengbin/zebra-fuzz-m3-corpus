  168|     15|fn read_spend_v4<R: Read>(mut reader: R) -> io::Result<SpendDescription<Authorized>> {
  169|       |    // Consensus rules (§4.4) & (§4.5):
  170|       |    // - Canonical encoding is enforced here.
