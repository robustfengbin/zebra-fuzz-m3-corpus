  353|  2.02M|        let r5 = (r5 << 1) | (r4 >> 63);
  354|  2.02M|        let r4 = (r4 << 1) | (r3 >> 63);
  355|  2.02M|        let r3 = (r3 << 1) | (r2 >> 63);
  356|  2.02M|        let r2 = (r2 << 1) | (r1 >> 63);
