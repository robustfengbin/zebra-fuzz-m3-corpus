  527|  1.86M|        let k = r1.wrapping_mul(INV);
  528|  1.86M|        let (_, carry) = mac(r1, k, MODULUS.0[0], 0);
  529|  1.86M|        let (r2, carry) = mac(r2, k, MODULUS.0[1], carry);
  530|  1.86M|        let (r3, carry) = mac(r3, k, MODULUS.0[2], carry);
  531|  1.86M|        let (r4, carry) = mac(r4, k, MODULUS.0[3], carry);
