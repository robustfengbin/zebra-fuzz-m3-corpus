  356|   148k|        let k = r0.wrapping_mul(INV);
  357|   148k|        let (_, carry) = mac(r0, k, MODULUS.0[0], 0);
  358|   148k|        let (r1, carry) = mac(r1, k, MODULUS.0[1], carry);
  359|   148k|        let (r2, carry) = mac(r2, k, MODULUS.0[2], carry);
  360|   148k|        let (r3, carry) = mac(r3, k, MODULUS.0[3], carry);
  361|   148k|        let (r4, carry2) = adc(r4, 0, carry);
  362|       |
  363|   148k|        let k = r1.wrapping_mul(INV);
  364|   148k|        let (_, carry) = mac(r1, k, MODULUS.0[0], 0);
  365|   148k|        let (r2, carry) = mac(r2, k, MODULUS.0[1], carry);
  366|   148k|        let (r3, carry) = mac(r3, k, MODULUS.0[2], carry);
  367|   148k|        let (r4, carry) = mac(r4, k, MODULUS.0[3], carry);
  368|   148k|        let (r5, carry2) = adc(r5, carry2, carry);
  369|       |
  370|   148k|        let k = r2.wrapping_mul(INV);
  371|   148k|        let (_, carry) = mac(r2, k, MODULUS.0[0], 0);
  372|   148k|        let (r3, carry) = mac(r3, k, MODULUS.0[1], carry);
  373|   148k|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  374|   148k|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
  375|   148k|        let (r6, carry2) = adc(r6, carry2, carry);
  376|       |
  377|   148k|        let k = r3.wrapping_mul(INV);
  378|   148k|        let (_, carry) = mac(r3, k, MODULUS.0[0], 0);
  379|   148k|        let (r4, carry) = mac(r4, k, MODULUS.0[1], carry);
  380|   148k|        let (r5, carry) = mac(r5, k, MODULUS.0[2], carry);
  381|   148k|        let (r6, carry) = mac(r6, k, MODULUS.0[3], carry);
