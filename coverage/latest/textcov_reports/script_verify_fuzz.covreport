  133|      4|pub(crate) fn hash_bundle_txid_data<A: Authorization, V: Copy + Into<i64>>(
  134|      4|    bundle: &Bundle<A, V>,
  135|      4|    tx_version: TxVersion,
  136|      4|) -> Result<Blake2bHash, CommitmentError> {
  137|      4|    let format = bundle
  138|      4|        .bundle_version()
  139|      4|        .value_pool()
  140|      4|        .commitment_format(tx_version)?;
  141|      4|    let personalizations = format.personalizations();
  142|      4|    let mut h = hasher(personalizations.bundle);
  143|      4|    let mut ch = hasher(personalizations.actions_compact);
  144|      4|    let mut mh = hasher(personalizations.actions_memos);
  145|      4|    let mut nh = hasher(personalizations.actions_noncompact);
  146|       |
  147|      4|    for action in bundle.actions().iter() {
  148|      4|        ch.update(&action.nullifier().to_bytes());
  149|      4|        ch.update(&action.cmx().to_bytes());
  150|      4|        ch.update(&action.encrypted_note().epk_bytes);
  151|      4|        ch.update(&action.encrypted_note().enc_ciphertext[..52]);
  152|      4|
  153|      4|        mh.update(&action.encrypted_note().enc_ciphertext[52..564]);
  154|      4|
  155|      4|        nh.update(&action.cv_net().to_bytes());
  156|      4|        nh.update(&<[u8; 32]>::from(action.rk()));
  157|      4|        nh.update(&action.encrypted_note().enc_ciphertext[564..]);
  158|      4|        nh.update(&action.encrypted_note().out_ciphertext);
  159|      4|    }
  160|       |
  161|      4|    h.update(ch.finalize().as_bytes());
  162|      4|    h.update(mh.finalize().as_bytes());
  163|      4|    h.update(nh.finalize().as_bytes());
  164|      4|    h.update(&[bundle.flag_byte()]);
  165|      4|    h.update(&(*bundle.value_balance()).into().to_le_bytes());
  166|      4|    if format.includes_anchor_in_txid_digest() {
  167|      4|        h.update(&bundle.anchor().to_bytes());
  168|      4|    }
  169|      4|    Ok(h.finalize())
  170|      4|}
