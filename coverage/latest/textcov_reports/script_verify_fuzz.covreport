  809|       |        //
  810|       |        // and so we have that T1 = (UV2 - VVpUU) and T2 = VVpUU.
  811|       |
  812|    994|        let uu = self.u.square();
  813|    994|        let vv = self.v.square();
  814|    994|        let zz2 = self.z.square().double();
  815|    994|        let uv2 = (self.u + self.v).square();
  816|    994|        let vv_plus_uu = vv + uu;
  817|    994|        let vv_minus_uu = vv - uu;
