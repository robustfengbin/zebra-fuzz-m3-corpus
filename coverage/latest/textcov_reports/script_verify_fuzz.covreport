  342|   128k|    const fn montgomery_reduce(
  343|   128k|        r0: u64,
  344|   128k|        r1: u64,
  345|   128k|        r2: u64,
  346|   128k|        r3: u64,
  347|   128k|        r4: u64,
  348|   128k|        r5: u64,
  349|   128k|        r6: u64,
  350|   128k|        r7: u64,
  351|   128k|    ) -> Self {
  352|       |        // The Montgomery reduction here is based on Algorithm 14.32 in
  353|       |        // Handbook of Applied Cryptography
  354|       |        // <http://cacr.uwaterloo.ca/hac/about/chap14.pdf>.
  355|       |
  356|   128k|        let k = r0.wrapping_mul(INV);
  357|   128k|        let (_, carry) = mac(r0, k, MODULUS.0[0], 0);
  358|   128k|        let (r1, carry) = mac(r1, k, MODULUS.0[1], carry);
  359|   128k|        let (r2, carry) = mac(r2, k, MODULUS.0[2], carry);
  360|   128k|        let (r3, carry) = mac(r3, k, MODULUS.0[3], carry);
  361|   128k|        let (r4, carry2) = adc(r4, 0, carry);
  362|       |
  363|   128k|        let k = r1.wrapping_mul(INV);
  364|   128k|        let (_, carry) = mac(r1, k, MODULUS.0[0], 0);
  365|   128k|        let (r2, carry) = mac(r2, k, MODULUS.0[1], carry);
  366|   128k|        let (r3, carry) = mac(r3, k, MODULUS.0[2], carry);
  367|   128k|        let (r4, carry) = mac(r4, k, MODULUS.0[3], carry);
  368|   128k|        let (r5, carry2) = adc(r5, carry2, carry);
  369|       |
  370|   128k|        let k = r2.wrapping_mul(INV);
  371|   128k|        let (_, carry) = mac(r2, k, MODULUS.0[0], 0);
  372|   128k|        let (r3, carry) = mac(r3, k, MODULUS.0[1], carry);
  373|   128k|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  374|   128k|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
  375|   128k|        let (r6, carry2) = adc(r6, carry2, carry);
  376|       |
  377|   128k|        let k = r3.wrapping_mul(INV);
  378|   128k|        let (_, carry) = mac(r3, k, MODULUS.0[0], 0);
  379|   128k|        let (r4, carry) = mac(r4, k, MODULUS.0[1], carry);
  380|   128k|        let (r5, carry) = mac(r5, k, MODULUS.0[2], carry);
  381|   128k|        let (r6, carry) = mac(r6, k, MODULUS.0[3], carry);
  382|   128k|        let (r7, _) = adc(r7, carry2, carry);
  383|       |
  384|       |        // Result may be within MODULUS of the correct value
  385|   128k|        (&Fp([r4, r5, r6, r7])).sub(&MODULUS)
  386|   128k|    }
