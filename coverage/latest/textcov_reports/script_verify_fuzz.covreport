_RNvMse_NtNtCs41Au54XfBWR_12pasta_curves6fields2fpNtB5_2Fp17montgomery_reduce:
  342|   182k|    const fn montgomery_reduce(
  343|   182k|        r0: u64,
  344|   182k|        r1: u64,
  345|   182k|        r2: u64,
  346|   182k|        r3: u64,
  347|   182k|        r4: u64,
  348|   182k|        r5: u64,
  349|   182k|        r6: u64,
  350|   182k|        r7: u64,
  351|   182k|    ) -> Self {
  352|       |        // The Montgomery reduction here is based on Algorithm 14.32 in
  353|       |        // Handbook of Applied Cryptography
  354|       |        // <http://cacr.uwaterloo.ca/hac/about/chap14.pdf>.
  355|       |
  356|   182k|        let k = r0.wrapping_mul(INV);
  357|   182k|        let (_, carry) = mac(r0, k, MODULUS.0[0], 0);
  358|   182k|        let (r1, carry) = mac(r1, k, MODULUS.0[1], carry);
  359|   182k|        let (r2, carry) = mac(r2, k, MODULUS.0[2], carry);
  360|   182k|        let (r3, carry) = mac(r3, k, MODULUS.0[3], carry);
  361|   182k|        let (r4, carry2) = adc(r4, 0, carry);
  362|       |
  363|   182k|        let k = r1.wrapping_mul(INV);
  364|   182k|        let (_, carry) = mac(r1, k, MODULUS.0[0], 0);
  365|   182k|        let (r2, carry) = mac(r2, k, MODULUS.0[1], carry);
  366|   182k|        let (r3, carry) = mac(r3, k, MODULUS.0[2], carry);
  367|   182k|        let (r4, carry) = mac(r4, k, MODULUS.0[3], carry);
  368|   182k|        let (r5, carry2) = adc(r5, carry2, carry);
  369|       |
  370|   182k|        let k = r2.wrapping_mul(INV);
  371|   182k|        let (_, carry) = mac(r2, k, MODULUS.0[0], 0);
  372|   182k|        let (r3, carry) = mac(r3, k, MODULUS.0[1], carry);
  373|   182k|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  374|   182k|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
  375|   182k|        let (r6, carry2) = adc(r6, carry2, carry);
  376|       |
  377|   182k|        let k = r3.wrapping_mul(INV);
  378|   182k|        let (_, carry) = mac(r3, k, MODULUS.0[0], 0);
  379|   182k|        let (r4, carry) = mac(r4, k, MODULUS.0[1], carry);
  380|   182k|        let (r5, carry) = mac(r5, k, MODULUS.0[2], carry);
  381|   182k|        let (r6, carry) = mac(r6, k, MODULUS.0[3], carry);
  382|   182k|        let (r7, _) = adc(r7, carry2, carry);
  383|       |
  384|       |        // Result may be within MODULUS of the correct value
  385|   182k|        (&Fp([r4, r5, r6, r7])).sub(&MODULUS)
  386|   182k|    }
