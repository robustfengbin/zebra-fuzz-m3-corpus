  111|      2|    pub const fn expected_proof_size(num_actions: usize) -> usize {
  112|       |        // The proof is a fixed base size plus a fixed contribution per action. These constants
  113|       |        // are determined by the halo2 action circuit; see the `circuit` module's round-trip
