  265|  2.35k|        let (_, borrow) = sbb(tmp.0[0], MODULUS.0[0], 0);
  266|  2.35k|        let (_, borrow) = sbb(tmp.0[1], MODULUS.0[1], borrow);
  267|  2.35k|        let (_, borrow) = sbb(tmp.0[2], MODULUS.0[2], borrow);
