   29|  4.49k|            let tail_ptr = data.as_ptr().add(blocks_len);
   30|  4.49k|            (
   31|  4.49k|                slice::from_raw_parts(blocks_ptr, nb),
   32|  4.49k|                slice::from_raw_parts(tail_ptr, tail_len),
