   29|  3.12k|            let tail_ptr = data.as_ptr().add(blocks_len);
   30|  3.12k|            (
   31|  3.12k|                slice::from_raw_parts(blocks_ptr, nb),
   32|  3.12k|                slice::from_raw_parts(tail_ptr, tail_len),
   33|  3.12k|            )
