  143|     15|    fn zcash_serialize<W: io::Write>(&self, mut writer: W) -> Result<(), io::Error> {
  144|     15|        self.vpub_old.zcash_serialize(&mut writer)?;
  145|     15|        self.vpub_new.zcash_serialize(&mut writer)?;
