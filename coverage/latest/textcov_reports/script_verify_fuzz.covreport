  506|   912k|    const fn montgomery_reduce(
  507|   912k|        r0: u64,
  508|   912k|        r1: u64,
  509|   912k|        r2: u64,
  510|   912k|        r3: u64,
  511|   912k|        r4: u64,
  512|   912k|        r5: u64,
  513|   912k|        r6: u64,
  514|   912k|        r7: u64,
  515|   912k|    ) -> Self {
  516|       |        // The Montgomery reduction here is based on Algorithm 14.32 in
  517|       |        // Handbook of Applied Cryptography
  518|       |        // <http://cacr.uwaterloo.ca/hac/about/chap14.pdf>.
  519|       |
  520|   912k|        let k = r0.wrapping_mul(INV);
  521|   912k|        let (_, carry) = mac(r0, k, MODULUS.0[0], 0);
  522|   912k|        let (r1, carry) = mac(r1, k, MODULUS.0[1], carry);
  523|   912k|        let (r2, carry) = mac(r2, k, MODULUS.0[2], carry);
  524|   912k|        let (r3, carry) = mac(r3, k, MODULUS.0[3], carry);
  525|   912k|        let (r4, carry2) = adc(r4, 0, carry);
  526|       |
  527|   912k|        let k = r1.wrapping_mul(INV);
  528|   912k|        let (_, carry) = mac(r1, k, MODULUS.0[0], 0);
  529|   912k|        let (r2, carry) = mac(r2, k, MODULUS.0[1], carry);
  530|   912k|        let (r3, carry) = mac(r3, k, MODULUS.0[2], carry);
  531|   912k|        let (r4, carry) = mac(r4, k, MODULUS.0[3], carry);
  532|   912k|        let (r5, carry2) = adc(r5, carry2, carry);
  533|       |
  534|   912k|        let k = r2.wrapping_mul(INV);
  535|   912k|        let (_, carry) = mac(r2, k, MODULUS.0[0], 0);
  536|   912k|        let (r3, carry) = mac(r3, k, MODULUS.0[1], carry);
  537|   912k|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  538|   912k|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
  539|   912k|        let (r6, carry2) = adc(r6, carry2, carry);
  540|       |
  541|   912k|        let k = r3.wrapping_mul(INV);
  542|   912k|        let (_, carry) = mac(r3, k, MODULUS.0[0], 0);
  543|   912k|        let (r4, carry) = mac(r4, k, MODULUS.0[1], carry);
  544|   912k|        let (r5, carry) = mac(r5, k, MODULUS.0[2], carry);
  545|   912k|        let (r6, carry) = mac(r6, k, MODULUS.0[3], carry);
  546|   912k|        let (r7, _) = adc(r7, carry2, carry);
  547|       |
  548|       |        // Result may be within MODULUS of the correct value
  549|   912k|        (&Scalar([r4, r5, r6, r7])).sub(&MODULUS)
  550|   912k|    }
