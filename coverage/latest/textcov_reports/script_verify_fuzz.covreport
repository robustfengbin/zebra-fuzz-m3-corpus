  536|  1.86M|        let (r3, carry) = mac(r3, k, MODULUS.0[1], carry);
  537|  1.86M|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  538|  1.86M|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
  539|  1.86M|        let (r6, carry2) = adc(r6, carry2, carry);
  540|       |
