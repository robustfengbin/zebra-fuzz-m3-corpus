  342|   226k|    const fn montgomery_reduce(
  343|   226k|        r0: u64,
  344|   226k|        r1: u64,
  345|   226k|        r2: u64,
  346|   226k|        r3: u64,
  347|   226k|        r4: u64,
  348|   226k|        r5: u64,
  349|   226k|        r6: u64,
  350|   226k|        r7: u64,
  351|   226k|    ) -> Self {
  352|       |        // The Montgomery reduction here is based on Algorithm 14.32 in
  353|       |        // Handbook of Applied Cryptography
  354|       |        // <http://cacr.uwaterloo.ca/hac/about/chap14.pdf>.
  355|       |
  356|   226k|        let k = r0.wrapping_mul(INV);
  357|   226k|        let (_, carry) = mac(r0, k, MODULUS.0[0], 0);
  358|   226k|        let (r1, carry) = mac(r1, k, MODULUS.0[1], carry);
  359|   226k|        let (r2, carry) = mac(r2, k, MODULUS.0[2], carry);
  360|   226k|        let (r3, carry) = mac(r3, k, MODULUS.0[3], carry);
  361|   226k|        let (r4, carry2) = adc(r4, 0, carry);
  362|       |
  363|   226k|        let k = r1.wrapping_mul(INV);
  364|   226k|        let (_, carry) = mac(r1, k, MODULUS.0[0], 0);
  365|   226k|        let (r2, carry) = mac(r2, k, MODULUS.0[1], carry);
  366|   226k|        let (r3, carry) = mac(r3, k, MODULUS.0[2], carry);
  367|   226k|        let (r4, carry) = mac(r4, k, MODULUS.0[3], carry);
  368|   226k|        let (r5, carry2) = adc(r5, carry2, carry);
  369|       |
  370|   226k|        let k = r2.wrapping_mul(INV);
  371|   226k|        let (_, carry) = mac(r2, k, MODULUS.0[0], 0);
  372|   226k|        let (r3, carry) = mac(r3, k, MODULUS.0[1], carry);
  373|   226k|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  374|   226k|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
  375|   226k|        let (r6, carry2) = adc(r6, carry2, carry);
  376|       |
  377|   226k|        let k = r3.wrapping_mul(INV);
  378|   226k|        let (_, carry) = mac(r3, k, MODULUS.0[0], 0);
  379|   226k|        let (r4, carry) = mac(r4, k, MODULUS.0[1], carry);
  380|   226k|        let (r5, carry) = mac(r5, k, MODULUS.0[2], carry);
  381|   226k|        let (r6, carry) = mac(r6, k, MODULUS.0[3], carry);
  382|   226k|        let (r7, _) = adc(r7, carry2, carry);
