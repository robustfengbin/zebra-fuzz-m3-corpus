  506|  2.46M|    const fn montgomery_reduce(
  507|  2.46M|        r0: u64,
  508|  2.46M|        r1: u64,
  509|  2.46M|        r2: u64,
  510|  2.46M|        r3: u64,
  511|  2.46M|        r4: u64,
  512|  2.46M|        r5: u64,
  513|  2.46M|        r6: u64,
  514|  2.46M|        r7: u64,
  515|  2.46M|    ) -> Self {
  516|       |        // The Montgomery reduction here is based on Algorithm 14.32 in
  517|       |        // Handbook of Applied Cryptography
  518|       |        // <http://cacr.uwaterloo.ca/hac/about/chap14.pdf>.
  519|       |
  520|  2.46M|        let k = r0.wrapping_mul(INV);
  521|  2.46M|        let (_, carry) = mac(r0, k, MODULUS.0[0], 0);
  522|  2.46M|        let (r1, carry) = mac(r1, k, MODULUS.0[1], carry);
  523|  2.46M|        let (r2, carry) = mac(r2, k, MODULUS.0[2], carry);
  524|  2.46M|        let (r3, carry) = mac(r3, k, MODULUS.0[3], carry);
  525|  2.46M|        let (r4, carry2) = adc(r4, 0, carry);
  526|       |
  527|  2.46M|        let k = r1.wrapping_mul(INV);
  528|  2.46M|        let (_, carry) = mac(r1, k, MODULUS.0[0], 0);
  529|  2.46M|        let (r2, carry) = mac(r2, k, MODULUS.0[1], carry);
  530|  2.46M|        let (r3, carry) = mac(r3, k, MODULUS.0[2], carry);
  531|  2.46M|        let (r4, carry) = mac(r4, k, MODULUS.0[3], carry);
  532|  2.46M|        let (r5, carry2) = adc(r5, carry2, carry);
  533|       |
  534|  2.46M|        let k = r2.wrapping_mul(INV);
  535|  2.46M|        let (_, carry) = mac(r2, k, MODULUS.0[0], 0);
  536|  2.46M|        let (r3, carry) = mac(r3, k, MODULUS.0[1], carry);
  537|  2.46M|        let (r4, carry) = mac(r4, k, MODULUS.0[2], carry);
  538|  2.46M|        let (r5, carry) = mac(r5, k, MODULUS.0[3], carry);
  539|  2.46M|        let (r6, carry2) = adc(r6, carry2, carry);
  540|       |
  541|  2.46M|        let k = r3.wrapping_mul(INV);
  542|  2.46M|        let (_, carry) = mac(r3, k, MODULUS.0[0], 0);
  543|  2.46M|        let (r4, carry) = mac(r4, k, MODULUS.0[1], carry);
  544|  2.46M|        let (r5, carry) = mac(r5, k, MODULUS.0[2], carry);
  545|  2.46M|        let (r6, carry) = mac(r6, k, MODULUS.0[3], carry);
  546|  2.46M|        let (r7, _) = adc(r7, carry2, carry);
